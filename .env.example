# The server automatically loads .env from its working directory.
# Shell/IDE environment variables and command-line options override .env.
# mysql: local one-time schema + dummy data bootstrap; h2: in-memory; supabase: production.
SPRING_PROFILES_ACTIVE=mysql

MYSQL_DB_URL=jdbc:mysql://localhost:3306/event_platform?connectionTimeZone=UTC&characterEncoding=UTF-8
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=replace-me

# Supabase Dashboard > Connect > Session pooler (port 5432)
SUPABASE_DB_URL=jdbc:postgresql://YOUR-POOLER-HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=replace-me

NAVER_SECRET_KEY=
NAVER_STORE_ID=
NAVER_CHANNEL_KEY=
