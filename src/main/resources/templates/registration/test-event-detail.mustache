{{!-- ⚠ [임시] 참가 신청 버튼 연동 확인용 테스트 상세 화면 — PR 전 삭제 (RegistrationTestPageController) --}}
<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>[테스트] {{title}} - Busan Play</title>
    {{> layout/bootstrap}}
</head>
<body>
{{> layout/header}}

<main class="container py-5" style="max-width: 880px;">
    <div class="alert alert-warning small mb-4">
        ⚠ 참가 신청 버튼 연동 확인용 임시 화면입니다. (행사 상세 화면 완성 후 삭제)
    </div>

    <h1 class="h3 mb-4">{{title}}</h1>

    <div class="list-group">
        {{#sessions}}
            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                    <div class="fw-semibold">{{name}}</div>
                    <div class="small text-muted">{{schedule}}</div>
                    <div class="small">참가비 {{feeText}} · {{remainingText}}</div>
                </div>

                {{! 신청 가능: 공용 스크립트가 처리하는 버튼 / 신청 불가: 비활성 버튼 + 사유 }}
                {{#canApply}}
                    <button type="button" class="btn btn-primary reg-apply-btn" data-session-id="{{id}}">참가 신청하기</button>
                {{/canApply}}
                {{^canApply}}
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" disabled>신청 불가</button>
                        <div class="small text-danger mt-1">{{closedReason}}</div>
                    </div>
                {{/canApply}}
            </div>
        {{/sessions}}
    </div>
</main>

{{> layout/footer}}

{{! 참가 신청 버튼 공용 스크립트 — 페이지에 한 번만 }}
{{> registration/apply-button-script}}
</body>
</html>
