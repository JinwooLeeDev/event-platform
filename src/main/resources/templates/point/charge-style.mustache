.charge-preview strong { display: block; margin: 8px 0 4px; color: #174bc1; font-size: 32px; font-weight: 800; line-height: 1.4; letter-spacing: -.8px; overflow-wrap: anywhere; }
.charge-summary-facts { margin: 22px 0; }
