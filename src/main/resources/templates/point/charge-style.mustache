.charge-page .charge-input-wrap input { min-width: 0; flex: 1; width: 100%; min-height: 62px; border: 0; outline: none; background: transparent; color: #142d4e; font: inherit; font-weight: 700; font-size: 25px; }
.charge-input-wrap input::placeholder { color: #8a97a9; font-size: 20px; font-weight: 400; }
.charge-input-wrap > span { color: #627084; font-size: 17px; }
.charge-help { margin: 10px 0 20px; color: #627084; font-size: 12px; }
.charge-amount-buttons { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
.charge-page .amount-btn { padding: 12px 6px; min-height: 46px; border: 1px solid #ccd8e7; border-radius: 8px; background: #fff; color: #344f72; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
.charge-page .amount-btn:hover { background: #f0f5fc; border-color: #91afd5; }
.charge-page .amount-btn.active { border-color: #174bc1; background: #edf3ff; color: #174bc1; box-shadow: inset 0 0 0 1px #174bc1; }
.charge-method { display: flex; align-items: center; gap: 18px; width:100%; padding: 20px; border: 1px solid #cbd8e8; border-radius: 10px; background: #fff; color:inherit; font:inherit; text-align:left; cursor:pointer; }
.charge-method:hover { border-color:#91afd5; background:#f7faff; }
.charge-method[aria-pressed="true"] { border-color:#174bc1; background:#edf3ff; box-shadow:inset 0 0 0 1px #174bc1; }
.charge-method-description { min-width:0; }
.charge-method-description > span { display:block; margin-top:4px; color:#627084; font-size:12px; }
.charge-method:not([aria-pressed="true"]) .charge-method-check { background:#fff; color:transparent; border:1px solid #b9cce3; }
.charge-page button:disabled { opacity:.6; cursor:wait; }
.charge-method strong { font-size: 15px; }
.charge-npay { flex-shrink: 0; color: #252e3b; white-space: nowrap; font-size: 21px; font-weight: 700; }
.charge-npay b { color: #03a94d; }
.charge-method-check { display: inline-flex; justify-content: center; align-items: center; margin-left: auto; flex-shrink: 0; width: 24px; height: 24px; background: #174bc1; color: #fff; border-radius: 50%; font-size: 13px; }
.charge-guide { padding: 4px 6px; color: #627084; font-size: 13px; }
.charge-guide summary { cursor: pointer; min-height: 36px; padding: 6px 0; font-weight: 600; color: #405a7b; }
.charge-guide ul { padding-left: 20px; margin: 10px 0 0; line-height: 1.9; }
.charge-guide li + li { margin-top: 6px; }
.charge-summary { position: sticky; top: 24px; padding: 26px; border: 1px solid #cbd8eb; border-radius: 16px; background: #fff; box-shadow: 0 5px 20px #142d4e05; }
