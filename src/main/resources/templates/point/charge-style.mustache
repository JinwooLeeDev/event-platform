<style>
body:has(.charge-page) { margin: 0; }
.charge-page { color: #142d4e; background: #f6f8fb; padding: 28px 32px 64px; font: 14px/1.75 Pretendard, "Noto Sans KR", "Malgun Gothic", sans-serif; }
.charge-page, .charge-page *, .charge-page *::before, .charge-page *::after { box-sizing: border-box; }
.charge-wrap { max-width: 1140px; margin: 0 auto; }
.charge-breadcrumb { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; color: #627084; font-size: 12px; }
.charge-breadcrumb a { color: inherit; text-decoration: none; }
.charge-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 32px; }
.charge-heading > div:first-child { min-width: 0; }
.charge-heading h1 { margin: 0 0 10px; font-size: clamp(26px, 2.6vw, 34px); font-weight: 800; line-height: 1.4; letter-spacing: -1px; word-break: keep-all; }
.charge-heading p { margin: 0; color: #627084; font-size: 14px; line-height: 1.8; word-break: keep-all; }
.charge-balance { display: flex; align-items: center; gap: 14px; flex-shrink: 0; min-width: 230px; padding: 18px 22px; border: 1px solid #d4dfec; border-radius: 12px; background: #fff; }
.charge-point-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid #d5e1ef; background: #f0f5fb; color: #45688f; border-radius: 50%; font-size: 18px; font-weight: 700; flex-shrink: 0; }
.charge-balance > div { min-width: 0; }
.charge-balance > div > span { display: block; color: #627084; font-size: 12px; }
.charge-balance strong { display: block; font-size: 23px; font-weight: 800; line-height: 1.4; overflow-wrap: anywhere; }
.charge-layout { display: grid; grid-template-columns: minmax(0,1fr) 340px; align-items: start; gap: 28px; }
.charge-content { display: grid; gap: 22px; min-width: 0; }
.charge-panel { padding: 30px; border: 1px solid #dce4ee; border-radius: 16px; background: #fff; }
.charge-section-heading { margin-bottom: 24px; }
.charge-panel h2, .charge-summary h2 { margin: 0; font-size: 21px; line-height: 1.5; letter-spacing: -.5px; }
