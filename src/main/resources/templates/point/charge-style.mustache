.charge-summary-facts .charge-summary-total { border-top: 1px solid #e3eaf3; margin-top: 10px; padding-top: 18px; }
.charge-summary-total dd { font-size: 23px; font-weight: 800; }
.charge-pay-button { width: 100%; display: flex; justify-content: center; align-items: center; gap: 16px; min-height: 52px; padding: 12px 18px; border: 1px solid #174bc1; border-radius: 9px; background: #174bc1; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
.charge-pay-button:hover { background: #123b99; border-color: #123b99; }
.charge-payment-note { margin: 14px 0 0; color: #627084; font-size: 12px; line-height: 1.8; text-align: center; }
.charge-back { display: block; border-top: 1px solid #e3eaf3; padding-top: 18px; margin-top: 22px; color: #4b6382; text-align: center; font-size: 12px; text-underline-offset: 4px; }
.charge-page a:focus-visible, .charge-page button:focus-visible, .charge-page summary:focus-visible { outline: 3px solid #174bc1; outline-offset: 4px; }
body:has(.charge-page) .header-container, body:has(.charge-page) .footer-container { box-sizing: border-box; max-width: 1204px; padding-left: 32px; padding-right: 32px; }
body:has(.charge-page) .footer-container { flex-wrap: wrap; }
body:has(.charge-page) .footer-divider { display: none; }
body:has(.charge-page) .footer-info-section { flex: 2 1 260px; }
body:has(.charge-page) .footer-contact-section { flex: 1 1 160px; }
body:has(.charge-page) .footer-policy-section { flex: 1 1 100%; align-items: flex-start; }
body:has(.charge-page) .copyright-warning { text-align: left; }
@media (max-width: 950px) {
 .charge-heading { align-items: flex-start; flex-direction: column; }
 .charge-balance { min-width: 0; width: 100%; }
 .charge-layout { grid-template-columns: minmax(0,1fr); }
 .charge-summary { position: static; }
}
@media (max-width: 600px) {
 .charge-page { padding: 20px 16px 40px; }
 .charge-heading { gap: 20px; margin-bottom: 24px; }
 .charge-heading h1 { font-size: 27px; }
 .charge-heading p { font-size: 13px; }
 .charge-panel, .charge-summary { padding: 24px 20px; }
 .charge-amount-buttons { grid-template-columns: repeat(2,minmax(0,1fr)); }
 .charge-panel h2, .charge-summary h2 { font-size: 20px; }
 .charge-method { padding: 16px 12px; gap: 12px; }
 .charge-npay { font-size: 19px; }
 body:has(.charge-page) .header-container, body:has(.charge-page) .footer-container { padding-left: 16px; padding-right: 16px; }
 body:has(.charge-page) .header-left > .vertical-divider { display: none; }
 body:has(.charge-page) .header-right { max-width: 100%; margin-left: auto; }
 body:has(.charge-page) .user-profile { max-width: 100%; }
 body:has(.charge-page) .user-name { overflow-wrap: anywhere; }
 body:has(.charge-page) .company-details { flex-wrap: wrap; }
}
.charge-method--kakao { margin-top:12px; }
.charge-kpay { display:grid; place-items:center; flex-shrink:0; width:64px; height:38px; border-radius:8px; background:#fee500; color:#302821; font-size:22px; font-weight:800; }
.charge-payment-buttons { display:grid; gap:10px; }
</style>
