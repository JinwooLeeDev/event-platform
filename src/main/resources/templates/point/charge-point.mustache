<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>포인트 충전 | Busan Play</title>
</head>
<body>
{{> layout/header}}
{{> point/charge-style}}
<main class="charge-page">
    <div class="charge-wrap">
        <nav class="charge-breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span>{{#isPersonal}}<a href="/mypoint">포인트 관리</a>{{/isPersonal}}{{#isCorporate}}<a href="/company/detail">기업페이지</a>{{/isCorporate}}<span aria-hidden="true">/</span><span>포인트 충전</span></nav>
        <header class="charge-heading">
            <div><h1>다음 경험을 위한 포인트 충전</h1><p>필요한 만큼 충전하고, 부산에서의 새로운 만남을 준비하세요.</p></div>
            <div class="charge-balance"><span class="charge-point-icon" aria-hidden="true">P</span><div><span>현재 보유 포인트</span><strong id="myPoint">{{myPoint}}</strong></div></div>
        </header>
        <div class="charge-layout">
            <div class="charge-content">
                <section class="charge-panel" aria-labelledby="charge-amount-title">
                    <div class="charge-section-heading"><h2 id="charge-amount-title">얼마를 충전할까요?</h2><p>금액을 직접 입력하거나 아래에서 선택하세요.</p></div>
                    <label for="chargeAmount">충전 금액</label>
                    <div class="charge-input-wrap"><input type="number" inputmode="numeric" id="chargeAmount" min="1000" step="1" placeholder="금액 입력" aria-describedby="charge-amount-help"><span>원</span></div>
                    <p class="charge-help" id="charge-amount-help">1,000원 이상 입력해주세요. 1원은 1포인트로 충전됩니다.</p>
                    <div class="charge-amount-buttons" id="amount-btn-group" role="group" aria-label="충전 금액 빠른 선택">
                        <button type="button" class="amount-btn" data-amount="10000" aria-pressed="false">10,000원</button>
                        <button type="button" class="amount-btn" data-amount="30000" aria-pressed="false">30,000원</button>
                        <button type="button" class="amount-btn" data-amount="50000" aria-pressed="false">50,000원</button>
                        <button type="button" class="amount-btn" data-amount="100000" aria-pressed="false">100,000원</button>
                    </div>
                </section>
                <section class="charge-panel" aria-labelledby="charge-method-title">
                    <div class="charge-section-heading"><h2 id="charge-method-title">결제 수단</h2><p>네이버페이 결제창에서 결제를 완료해주세요.</p></div>
                    <div class="charge-method"><span class="charge-npay" aria-label="네이버페이"><b>N</b> pay</span><div><strong>네이버페이</strong><p>연결된 네이버페이로 간편하게 결제</p></div><span class="charge-method-check" aria-label="선택됨">✓</span></div>
                </section>
                <details class="charge-guide"><summary>충전 전에 확인해주세요</summary><ul><li>충전한 포인트는 행사 신청 및 서비스 이용에 사용할 수 있습니다.</li><li>네이버페이 결제가 완료되어야 포인트가 충전됩니다.</li><li>충전 및 환불에 관한 사항은 운영정책을 확인해주세요.</li></ul></details>
            </div>
            <aside class="charge-summary" aria-labelledby="charge-summary-title">
                <h2 id="charge-summary-title">충전 내역 확인</h2>
                <div class="charge-preview" role="status" aria-live="polite" aria-atomic="true"><span>충전 예정 포인트</span><strong id="expectedPoint">0P</strong><small>1원 = 1P</small></div>
                <dl class="charge-summary-facts"><div><dt>결제 수단</dt><dd>네이버페이</dd></div><div class="charge-summary-total"><dt>결제 금액</dt><dd id="chargeTotal">0원</dd></div></dl>
                <button type="button" class="charge-pay-button" id="naverPayBtn">포인트 충전하기 <span aria-hidden="true">↗</span></button>
                <p class="charge-payment-note">네이버페이 결제창으로 이동합니다.<br>결제를 완료한 뒤 충전 내역을 확인해주세요.</p>
                {{#isPersonal}}<a class="charge-back" href="/mypoint">포인트 관리로 돌아가기</a>{{/isPersonal}}
                {{#isCorporate}}<a class="charge-back" href="/company/detail">기업페이지로 돌아가기</a>{{/isCorporate}}
            </aside>
        </div>
    </div>
</main>
<script src="https://nsp.pay.naver.com/sdk/js/naverpay.min.js"></script>
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
<script>
    let selectedPoint = 0;
    const naverPayBtn = document.querySelector("#naverPayBtn");
    const pointBtns = document.querySelectorAll(".amount-btn");
    const expectedPoint = document.querySelector("#expectedPoint");
    const inputPoint = document.querySelector("#chargeAmount");
    const myPoint = document.querySelector("#myPoint");
    const point = Number(myPoint.textContent.trim());
    myPoint.innerText = point.toLocaleString("ko-KR") + "P";

    function updateChargePreview() {
        const formatted = selectedPoint.toLocaleString("ko-KR");
        expectedPoint.innerText = formatted + "P";
        document.getElementById("chargeTotal").textContent = formatted + "원";
        pointBtns.forEach(button => {
            const active = Number(button.dataset.amount) === selectedPoint;
            button.classList.toggle("active", active);
            button.setAttribute("aria-pressed", String(active));
        });
    }
    document.querySelector("#amount-btn-group").addEventListener("click", function (event) {
        const button = event.target.closest(".amount-btn");
        if (!button) return;
        selectedPoint = Number(button.dataset.amount);
        inputPoint.value = selectedPoint;
        updateChargePreview();
    });
    inputPoint.addEventListener("input", function () {
        selectedPoint = Number(inputPoint.value);
        updateChargePreview();
    });
    // '네이버 충전하기' 버튼 클릭
    naverPayBtn.addEventListener("click", async function() {
       if(selectedPoint <= 0 || selectedPoint === null) {
           alert("충전할 포인트를 입력하세요(0포인트 이상)");
           return;
       }

       try {
           const prepareRes = await fetch("/api/payment/prepare" , {
               method : "post" ,
               headers : {"Content-Type" : "application/json"} ,
               body : JSON.stringify({amount : selectedPoint})
           })
           const prepareReq = await prepareRes.json();
           if(!prepareRes.ok) {
               alert("결제 처리도중 오류가 발생했습니다")
               return;
           }


           // 포트원으로 결제 요청.
           const payment = await PortOne.requestPayment({
               storeId: prepareReq.storeId,
               channelKey: prepareReq.channelKey,
               paymentId: prepareReq.paymentId,
               orderName: "POINT",
               totalAmount: selectedPoint,
               currency: "CURRENCY_KRW",
               payMethod: "EASY_PAY"
           })

           if(!payment || payment.code !== undefined) {
               alert("결제처리가 중단되었습니다")
               return;
           }

           const completeRes = await fetch("/api/payment/complete" , {
               method : "post" ,
               headers : {"Content-Type" : "application/json"} ,
               body : JSON.stringify({paymentId : payment.paymentId})
           })
           const completeReq = await completeRes.json()
           if(!completeRes.ok){
               alert("결제 처리도중 오류가 발생했습니다")
               return;
           }

           myPoint.innerText = completeReq.currentPoint.toLocaleString() + "P"
           alert("충전 완료되었습니다")
           window.location.href = completeReq.redirectUrl

       }catch (e) {
            throw new Error("결제 실패하였습니다")
       }
    })

</script>
{{> layout/footer}}
</body>
</html>
