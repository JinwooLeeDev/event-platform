 body:has(.purchase-page) .header-container, body:has(.purchase-page) .footer-container { padding-left: 16px; padding-right: 16px; }
 body:has(.purchase-page) .header-left > .vertical-divider { display: none; }
 body:has(.purchase-page) .header-right { max-width: 100%; margin-left: auto; }
 body:has(.purchase-page) .user-profile { max-width: 100%; }
