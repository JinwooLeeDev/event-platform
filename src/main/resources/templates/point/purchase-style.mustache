.purchase-balance strong { display: block; font-size: 23px; line-height: 1.4; margin-top: 4px; overflow-wrap: anywhere; }
.purchase-point-facts { margin: 0 0 18px; }
.purchase-point-facts > div { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 10px 0; }
.purchase-point-facts dt { color: #627084; font-size: 13px; }
.purchase-point-facts dd { margin: 0; font-weight: 600; font-size: 14px; text-align: right; overflow-wrap: anywhere; }
.purchase-point-facts .purchase-payment-total { margin-top: 10px; padding-top: 20px; border-top: 1px solid #e5ebf2; }
.purchase-payment-total dt { font-weight: 700; color: #142d4e; }
.purchase-payment-total dd { color: #174bc1; font-size: 27px; font-weight: 800; }
