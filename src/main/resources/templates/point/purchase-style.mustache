.purchase-progress li + li::before { content: '›'; margin-right: 24px; color: #a9b6c6; font-size: 22px; }
.purchase-progress li > span { display: inline-flex; align-items: center; justify-content: center; width: 27px; height: 27px; flex-shrink: 0; background: #eff3f8; border-radius: 50%; font-size: 12px; }
