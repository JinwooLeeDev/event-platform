.purchase-progress .is-done > span { background: #edf3fc; color: #45688f; }
.purchase-progress .is-current { color: #174bc1; font-weight: 700; }
.purchase-progress .is-current > span { background: #174bc1; color: #fff; }
.purchase-layout { display: grid; grid-template-columns: minmax(0,1fr) 360px; gap: 28px; align-items: start; }
.purchase-content { display: grid; gap: 24px; min-width: 0; }
.purchase-panel { padding: 30px; border: 1px solid #dce4ee; border-radius: 16px; background: #fff; min-width: 0; }
.purchase-panel h2, .purchase-summary h2 { margin: 0; font-size: 21px; line-height: 1.5; letter-spacing: -.5px; }
.purchase-panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-bottom: 22px; margin-bottom: 24px; border-bottom: 1px solid #e5ebf2; }
