.purchase-charge-link:hover { background: #e3edf9; border-color: #91afd5; }
.purchase-back { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 24px; color: #526780; text-decoration: none; font-size: 13px; }
.purchase-back:hover { color: #174bc1; text-decoration: underline; text-underline-offset: 4px; }
