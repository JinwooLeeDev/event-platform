<style>
body:has(.purchase-page) { margin: 0; }
.purchase-page { background: #f6f8fb; color: #142d4e; padding: 28px 32px 56px; font: 14px/1.75 Pretendard, "Noto Sans KR", "Malgun Gothic", sans-serif; }
.purchase-page, .purchase-page *, .purchase-page *::before, .purchase-page *::after { box-sizing: border-box; }
.purchase-page [hidden] { display: none !important; }
.purchase-wrap { max-width: 1140px; margin: 0 auto; }
.purchase-breadcrumb { display: flex; flex-wrap: wrap; gap: 12px; color: #627084; font-size: 12px; margin-bottom: 28px; }
.purchase-breadcrumb a { color: inherit; text-decoration: none; }
.purchase-heading { margin-bottom: 26px; }
.purchase-heading h1 { font-size: clamp(27px,2.8vw,36px); margin: 0 0 10px; line-height: 1.4; letter-spacing: -1px; font-weight: 800; word-break: keep-all; }
.purchase-heading p { margin: 0; color: #627084; font-size: 14px; }
.purchase-progress { display: flex; align-items: center; justify-content: center; gap: 34px; list-style: none; padding: 18px 24px; border: 1px solid #dce4ee; border-radius: 12px; margin: 0 0 28px; background: #fff; }
