.purchase-remaining > span { font-size: 12px; color: #627084; }
.purchase-remaining strong { font-size: 18px; overflow-wrap: anywhere; }
.purchase-warning { margin: 16px 0 0; padding: 12px; border: 1px solid #ead6b5; background: #fdf7ec; color: #815b25; border-radius: 8px; font-size: 12px; }
