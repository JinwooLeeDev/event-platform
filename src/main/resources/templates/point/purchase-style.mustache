body:has(.purchase-page) .footer-container { flex-wrap: wrap; }
body:has(.purchase-page) .footer-divider { display: none; }
body:has(.purchase-page) .footer-info-section { flex: 2 1 260px; }
body:has(.purchase-page) .footer-contact-section { flex: 1 1 160px; }
body:has(.purchase-page) .footer-policy-section { flex: 1 1 100%; align-items: flex-start; }
body:has(.purchase-page) .copyright-warning { text-align: left; }
@media (max-width: 950px) {
 .purchase-layout { grid-template-columns: minmax(0,1fr); }
