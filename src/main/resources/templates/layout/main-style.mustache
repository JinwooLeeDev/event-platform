<style>
.main-page {
    --main-primary: #0750d8;
    --main-navy: #14285f;
    --main-muted: #647596;

    font-family: "Pretendard", sans-serif;
    color: var(--main-navy);
    background: #f8f9fb;
}

.main-page,
.main-page *,
.main-page *::before,
.main-page *::after {
    box-sizing: border-box;
}

.main-page .main-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 48px 40px 40px;
    background-color: #f5f2ed;
    background-image:
            linear-gradient(
                    90deg,
                    rgba(249, 247, 243, 0.88) 0%,
                    rgba(249, 247, 243, 0.65) 32%,
                    rgba(246, 244, 239, 0.18) 65%,
                    rgba(246, 244, 239, 0.04) 100%
            ),
            url("/images/main/main_hero_background.png");
    background-size: cover;
    background-position: center;
}

/* 시안의 얇은 곡선 장식 */
.main-page .main-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -240px;
    right: -160px;
    width: 900px;
    height: 600px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    transform: rotate(-20deg);
    pointer-events: none;
}

.main-page .main-hero__inner {
    width: 100%;
    max-width: 1520px;
    margin: 0 auto;
}

.main-page .main-hero__title {
    margin: 0;
    font-size: clamp(30px, 3.2vw, 48px);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -1.8px;
    word-break: keep-all;
}

.main-page .main-hero__title span {
    display: block;
    color: var(--main-primary);
}

.main-page .main-hero__description {
    margin: 14px 0 0;
    color: #62656d;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.7;
    word-break: keep-all;
}

.main-page .main-search {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    max-width: 720px;
    min-height: 68px;
    margin: 20px auto 0;
    padding: 6px 6px 6px 26px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(20, 63, 130, 0.12);
}

.main-page .main-search:focus-within {
    outline: 3px solid rgba(7, 80, 216, 0.3);
    outline-offset: 4px;
}

.main-page .main-search__icon {
    flex-shrink: 0;
    color: var(--main-navy);
}

.main-page .main-search__input {
    flex: 1;
    min-width: 0;
    width: 100%;
    padding: 10px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--main-navy);
    font: inherit;
    font-size: 17px;
}

.main-page .main-search__input::placeholder {
    color: #8998b7;
}

.main-page .main-search__button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 54px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--main-primary);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.main-page .main-search__button:hover {
    background: #003ba8;
}

.main-page .main-search__button:focus-visible {
    outline: 3px solid var(--main-navy);
    outline-offset: 3px;
}

.main-page .main-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

@media (max-width: 768px) {
    .main-page .main-hero {
        padding: 40px 20px 32px;
        background-position: 60% center;
    }

    .main-page .main-hero__title {
        font-size: clamp(27px, 5vw, 36px);
        letter-spacing: -1px;
    }

    .main-page .main-hero__description {
        font-size: 15px;
    }

    .main-page .main-search {
        gap: 12px;
        min-height: 60px;
        margin-top: 20px;
        padding-left: 18px;
    }

    .main-page .main-search__input {
        font-size: 15px;
    }

    .main-page .main-search__button {
        width: 58px;
        height: 46px;
    }
}

@media (max-width: 420px) {
    .main-page .main-search__icon {
        display: none;
    }

    .main-page .main-search__input {
        font-size: 14px;
    }
}

/* =========================
   메인 카테고리
========================= */

.main-page .main-category {
    max-width: 1600px;
    margin: 0 auto;
    padding: 5px 40px 0;
}

.main-page .main-category__dropdown {
    position: relative;
    width: 100%;
}

/* 카테고리 선택 버튼 */
.main-page .main-category__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    width: fit-content;
    min-width: 150px;
    padding: 10px 17px;
    border: 1px solid #dce3ef;
    border-radius: 9px;
    background: #fff;
    color: #14285f;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    transition: 0.2s;
}

.main-page .main-category__button::-webkit-details-marker {
    display: none;
}

.main-page .main-category__button:hover {
    border-color: #0750d8;
    color: #0750d8;
}

.main-page .main-category__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 20px;
    margin: 0;
    color: #0750d8;
    font-size: 18px;
    line-height: 1;
    transition: transform 0.2s;
}

.main-page .main-category__dropdown[open]
.main-category__arrow {
    transform: rotate(180deg);
}

/* 펼쳐지는 카테고리 목록 */
.main-page .main-category__list {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    width: 190px;
    margin-top: 8px;
    padding: 6px;
    border: 1px solid #e3e8f1;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(20, 40, 95, 0.09);
}

/* 개별 카테고리 */
.main-page .main-category__item {
    display: block;
    padding: 11px 13px;
    border-radius: 6px;
    color: #14285f;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: 0.2s;
}

.main-page .main-category__item:hover {
    background: #f0f4ff;
    color: #0750d8;
}

@media (max-width: 600px) {
    .main-page .main-category {
        padding: 18px 20px 0;
    }

    .main-page .main-category__button {
        min-width: 140px;
        font-size: 13px;
    }
}

/*============================================*/
.main-page .main-events {
    max-width: 1600px;
    margin: 0 auto;
    padding: 34px 40px 48px;
}

.main-page .main-events__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
}

.main-page .main-events__eyebrow {
    margin: 0 0 7px;
    color: var(--main-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.main-page .main-events h2 {
    margin: 0;
    padding-left: 12px;
    border-left: 4px solid var(--main-primary);
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -1px;
}

.main-page .main-events__more {
    flex-shrink: 0;
    color: var(--main-navy);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
}

.main-page .main-events__more:hover { color: var(--main-primary); }
.main-page .main-events__more:focus-visible {
    outline: 2px solid var(--main-primary);
    outline-offset: 5px;
}

.main-page .main-events__notice {
    margin: 14px 0 22px;
    color: var(--main-muted);
    font-size: 13px;
    line-height: 1.6;
}

.main-page .event-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

.main-page .event-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e6e7eb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 3px 12px rgba(20, 40, 95, 0.045);
    transition: transform .2s ease, box-shadow .2s ease;
}

.main-page .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 26px rgba(20, 40, 95, 0.1);
}

/* 이미지 준비 전에도 표시되는 카드별 그래픽 */
.main-page .event-card__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    padding: 24px;
    --card-background: linear-gradient(135deg, #e2ddd4, #f0eae0);
    background: var(--card-background);
    color: #41424b;
}

.main-page .event-card__visual::before,
.main-page .event-card__visual::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 170px;
    height: 170px;
    border: 1px solid rgba(255,255,255,.4);
    border-radius: 50%;
}

.main-page .event-card__visual::before { top: -65px; right: -20px; }
.main-page .event-card__visual::after { bottom: -95px; left: -25px; width: 240px; height: 240px; }
.main-page .event-card__visual[data-category*="전시"] { --card-background: linear-gradient(135deg,#d6d0e5,#eee9f2); }
.main-page .event-card__visual[data-category*="공연"] { --card-background: linear-gradient(135deg,#3f4451,#666b78); color: #fff; }
.main-page .event-card__visual[data-category*="체험"] { --card-background: linear-gradient(135deg,#c4d3c5,#e5ebe0); }
.main-page .event-card__visual[data-category*="축제"],
.main-page .event-card__visual[data-category*="음식"] { --card-background: linear-gradient(135deg,#e8c9b5,#f5e8d9); }
.main-page .event-card__visual[data-category*="영화"] { --card-background: linear-gradient(135deg,#d1d0dc,#e9e6ec); }
.main-page .event-card__visual[data-category*="팝업"] { --card-background: linear-gradient(135deg,#dfc9ce,#f1e5e6); }
.main-page .event-card__visual--market { --card-background: linear-gradient(130deg,#b85778,#e8a59d,#f2ceb8); }
.main-page .event-card__visual--music { --card-background: linear-gradient(135deg,#17245e,#6145b9,#c451ba); }
.main-page .event-card__visual--ocean { --card-background: linear-gradient(140deg,#165391,#3d9ed4,#a2d9e9); }
.main-page .event-card__visual--book { --card-background: linear-gradient(135deg,#376c62,#7ba68b,#b8c9a2); }
.main-page .event-card__visual--craft { --card-background: linear-gradient(135deg,#af704d,#d4a378,#ebcfac); }
.main-page .event-card__visual--film { --card-background: linear-gradient(135deg,#1e284d,#4c628b,#a49bbe); }
.main-page .event-card__visual--food { --card-background: linear-gradient(135deg,#b55742,#e39063,#f3c188); }

.main-page .event-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,.9);
    color: #454b56;
    font-size: 12px;
    font-weight: 700;
}
.main-page .event-card__badge--urgent { background: #b82267; }
.main-page .event-card__art {
    max-width: 190px;
    text-align: center;
    font-size: clamp(19px, 2vw, 28px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -1px;
    text-shadow: none;
}
.main-page .event-card__visual-caption {
    position: absolute;
    bottom: 12px;
    right: 14px;
    font-size: 9px;
    letter-spacing: 2px;
}
.main-page .event-card__body { padding: 18px; }
.main-page .event-card__title {
    margin: 0;
    min-height: 48px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 17px;
    line-height: 1.4;
    letter-spacing: -.5px;
}
.main-page .event-card__summary {
    margin: 7px 0 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--main-muted);
    font-size: 13px;
}
.main-page .event-card__meta { margin: 0 0 14px; font-size: 12px; }
.main-page .event-card__meta div { display: flex; gap: 8px; margin-top: 6px; }
.main-page .event-card__meta dt { flex-shrink: 0; color: var(--main-muted); }
.main-page .event-card__meta dd { margin: 0; overflow-wrap: anywhere; }
.main-page .event-card__category {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: #f1f2f4;
    color: #555b66;
    font-size: 12px;
    font-weight: 700;
}
@media (max-width: 1100px) {
    .main-page .event-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 600px) {
    .main-page .main-events { padding: 28px 20px 36px; }
    .main-page .main-events h2 { font-size: 22px; }
    .main-page .event-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .main-page .event-card__art { font-size: 28px; }
}
@media (prefers-reduced-motion: reduce) {
    .main-page .event-card { transition: none; }
    .main-page .event-card:hover { transform: none; }
}
.main-page .main-events__empty { padding: 50px 24px; border: 1px dashed #cbd8ec; border-radius: 16px; text-align: center; color: #647596; background: #f8faff; }
</style>

