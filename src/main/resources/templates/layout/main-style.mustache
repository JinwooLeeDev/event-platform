<style>
/* 메인에만 적용하는 색상과 레이아웃. 공통 헤더·카드 동작은 유지합니다. */
body:has(.main-page) { margin: 0; background: #fff; }
.main-page {
    --main-primary: #174bc1;
    --main-navy: #142d4e;
    --main-muted: #627084;
    color: var(--main-navy);
    background: #fff;
    font-family: Pretendard, "Noto Sans KR", "Malgun Gothic", sans-serif;
    -webkit-font-smoothing: antialiased;
}
.main-page, .main-page *, .main-page *::before, .main-page *::after { box-sizing: border-box; }
.main-page a:focus-visible { outline: 3px solid #174bc1; outline-offset: 5px; }
.main-page .main-hero { padding: 36px 32px 0; }
.main-page .main-hero__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: 24px;
    background: #edf4fa;
}
.main-page .main-hero__copy { padding: 46px 40px; align-self: center; }
.main-page .main-hero__location { margin: 0 0 18px; color: #345a80; font-size: 14px; font-weight: 600; }
.main-page .main-hero__title {
    margin: 0;
    font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -1.8px;
    word-break: keep-all;
}
.main-page .main-hero__description { margin: 20px 0 0; color: #50647b; font-size: 15px; line-height: 1.85; word-break: keep-all; }
.main-page .main-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
.main-page .main-button { display: inline-flex; justify-content: center; align-items: center; gap: 20px; min-height: 48px; padding: 12px 20px; border-radius: 10px; font-size: 14px; font-weight: 700; line-height: 1.5; text-decoration: none; }
.main-page .main-button--primary { background: var(--main-primary); color: #fff; }
.main-page .main-button--primary:hover { background: #123b99; }
.main-page .main-button--text { color: var(--main-navy); }
.main-page .main-button--text:hover { background: #ddeaf5; }
.main-page .main-hero__scene {
    min-height: 350px;
    position: relative;
    background: #dcebf4 url("/images/main/main_hero_background.png") center / cover no-repeat;
}
.main-page .main-hero__scene-label { position: absolute; bottom: 20px; left: 20px; right: 20px; width: fit-content; padding: 9px 13px; background: #ffffffed; color: #30485e; border-radius: 6px; font-size: 12px; line-height: 1.5; }
.main-page .main-events { max-width: 1304px; margin: 0 auto; padding: 48px 32px 72px; scroll-margin-top: 24px; }
.main-page .main-events__heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 26px; }
.main-page .main-events h2 { margin: 0; font-size: 26px; font-weight: 800; line-height: 1.4; letter-spacing: -.9px; }
.main-page .main-events__description { margin: 8px 0 0; color: var(--main-muted); font-size: 14px; line-height: 1.7; }
.main-page .main-events__more { flex-shrink: 0; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--main-navy); text-decoration: none; font-size: 14px; font-weight: 600; }
.main-page .main-events__more:hover { color: var(--main-primary); }
.main-page .event-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 24px; }
.main-page .event-card { min-width: 0; position: relative; border: 1px solid #cfd9e5; border-radius: 14px; background: #fff; box-shadow: 0 3px 12px rgba(20, 45, 78, .07); }
.main-page .event-card:hover, .main-page .event-card:focus-within { border-color: #7c9bc7; box-shadow: 0 5px 16px rgba(20, 45, 78, .12); }
.main-page .event-card__link { display: block; height: 100%; text-decoration: none; color: inherit; border-radius: 12px; }
.main-page .event-card__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 26px;
    border-radius: 13px 13px 0 0;
    background: #e8eef5;
    color: #536c88;
}
.main-page .event-card__visual::before { content: ""; position: absolute; width: 180px; height: 100px; border: 2px solid currentColor; border-radius: 50%; transform: rotate(-25deg); opacity: .12; }
.main-page .event-card__visual[data-category*="전시"] { background: #eceaf6; color: #71608c; }
.main-page .event-card__visual[data-category*="공연"] { background: #e3e9f5; color: #485d95; }
.main-page .event-card__visual[data-category*="체험"] { background: #e2efe9; color: #467360; }
.main-page .event-card__visual[data-category*="축제"] { background: #fae8df; color: #956449; }
.main-page .event-card__visual[data-category*="영화"] { background: #e5e6ed; color: #5f6383; }
.main-page .event-card__visual[data-category*="팝업"] { background: #f5e5ed; color: #915e77; }
.main-page .event-card__art { position: relative; font-size: 23px; font-weight: 800; line-height: 1.2; letter-spacing: -1px; text-align: center; }
.main-page .event-card__visual-caption { position: absolute; bottom: 13px; left: 16px; color: #4e596a; font-size: 11px; }
.main-page .event-card__body { display: flex; flex-direction: column; align-items: flex-start; padding: 18px 16px 20px; }
.main-page .event-card__category { order: -1; margin-bottom: 9px; color: var(--main-primary); font-size: 12px; font-weight: 700; line-height: 1.5; }
.main-page .event-card__title { margin: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; font-size: 17px; line-height: 1.5; letter-spacing: -.5px; }
.main-page .event-card__link:hover .event-card__title { text-decoration: underline; text-underline-offset: 4px; }
.main-page .event-card__summary { width: 100%; margin: 7px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--main-muted); font-size: 13px; line-height: 1.7; }
.main-page .event-card__period { display: flex; gap: 10px; width: 100%; margin-top: 14px; padding-top: 12px; border-top: 1px solid #edf0f4; color: #59677b; font-size: 12px; line-height: 1.8; }
.main-page .event-card__period > span { flex-shrink: 0; color: #697587; }
.main-page .event-card__period > div { min-width: 0; overflow-wrap: anywhere; }
.main-page .event-card__period > div > div + div { margin-top: 8px; }
.main-page .event-card__period strong { font-weight: 600; color: #36465b; }
.main-page .main-events__empty { padding: 48px 24px; border: 1px solid #e0e7ef; border-radius: 16px; background: #f7fafd; text-align: center; }
.main-page .main-events__empty h3 { margin: 0; font-size: 20px; }
.main-page .main-events__empty p { margin: 12px 0 24px; color: var(--main-muted); line-height: 1.8; }
/* 공통 영역은 메인이 있는 문서에서만 정렬합니다. */
body:has(.main-page) .app-header, body:has(.main-page) .app-footer { box-sizing: border-box; }
body:has(.main-page) .header-container, body:has(.main-page) .footer-container { box-sizing: border-box; max-width: 1304px; padding-left: 32px; padding-right: 32px; }
body:has(.main-page) .app-header { min-height: 80px; }
body:has(.main-page) .header-left > .vertical-divider { display: none; }
body:has(.main-page) .header-search { max-width: 460px; border-color: #e1e7ef; background: #f7f9fc; }
body:has(.main-page) .header-search__button { background: #174bc1; }
body:has(.main-page) .app-footer { background: #f8fafc; padding: 32px 0; }
body:has(.main-page) .footer-container { flex-wrap: wrap; gap: 24px 32px; }
body:has(.main-page) .footer-info-section { flex: 2 1 260px; }
body:has(.main-page) .footer-contact-section { flex: 1 1 160px; }
body:has(.main-page) .footer-policy-section { flex: 1 1 100%; align-items: flex-start; padding-top: 20px; border-top: 1px solid #e0e4eb; }
body:has(.main-page) .footer-divider { display: none; }
body:has(.main-page) .copyright-warning { text-align: left; }
@media (max-width: 1000px) {
    .main-page .main-hero__copy { padding: 32px 28px; }
    .main-page .main-hero__scene { min-height: 330px; }
    .main-page .event-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
    .main-page .main-hero { padding: 20px 20px 0; }
    .main-page .main-hero__inner { grid-template-columns: 1fr; border-radius: 18px; }
    .main-page .main-hero__copy { padding: 30px 24px; }
    .main-page .main-hero__title { font-size: 34px; letter-spacing: -1.2px; }
    .main-page .main-hero__description { font-size: 14px; }
    .main-page .main-hero__scene { min-height: 150px; background-position: center 55%; }
    .main-page .main-hero__scene-label { bottom: 12px; left: 16px; font-size: 11px; }
    .main-page .main-events { padding: 32px 20px 44px; }
    .main-page .main-events h2 { font-size: 23px; }
    .main-page .main-events__heading { gap: 12px; align-items: flex-start; }
    .main-page .main-events__description { font-size: 13px; }
    .main-page .event-grid { gap: 28px 16px; }
    .main-page .event-card__visual { aspect-ratio: 1; padding: 18px; }
    .main-page .event-card__art { font-size: 20px; }
    .main-page .event-card__title { font-size: 15px; }
    .main-page .event-card__body { padding: 14px 12px 16px; }
    .main-page .event-card__period { flex-direction: column; gap: 2px; }
    body:has(.main-page) .header-container, body:has(.main-page) .footer-container { padding-left: 20px; padding-right: 20px; }
    body:has(.main-page) .header-right { margin-left: auto; }
    body:has(.main-page) .user-profile { max-width: 100%; }
    body:has(.main-page) .user-name { overflow-wrap: anywhere; }
}
@media (max-width: 380px) {
    .main-page .event-grid { grid-template-columns: 1fr; }
    .main-page .event-card__visual { aspect-ratio: 4 / 3; }
    .main-page .main-hero__title { font-size: 30px; }
    .main-page .main-hero__actions { align-items: stretch; flex-direction: column; }
    body:has(.main-page) .header-container { align-items: flex-start; }
    body:has(.main-page) .header-right { width: 100%; margin-left: 0; }
    body:has(.main-page) .company-details { flex-wrap: wrap; row-gap: 6px; }
}
</style>
