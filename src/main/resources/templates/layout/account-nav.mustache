    <div class="account-sidebar-bottom"><p>{{i18n.common.ui0023}}</p><a href="/events/list">{{i18n.event.ui0004}} <span aria-hidden="true">↗</span></a></div>
</aside>
<script>
(() => {
    const updateAccountNav = () => {
        const current = window.location.pathname + window.location.hash;
        document.querySelectorAll('[data-account-nav]').forEach(link => {
            if (link.dataset.accountNav === current) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
        });
    };
    window.addEventListener('hashchange', updateAccountNav);
    updateAccountNav();
})();
</script>
