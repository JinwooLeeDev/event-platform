<style>
    /* Footer Layout */
    .app-footer {
        width: 100%;
        background-color: #ffffff;
        border-top: 1px solid #e0e4eb;
        padding: 30px 0;
        font-family: 'Pretendard', sans-serif;
        color: #4a5a78;
    }

    .footer-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 40px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
    }

    /* Divider */
    .footer-divider {
        width: 1px;
        height: 40px;
        background-color: #e0e4eb;
        align-self: center;
    }

    /* Logo Section */
    .footer-logo-section {
        display: flex;
        align-items: center;
        height: 100%;
        align-self: center;
    }

    .footer-logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        gap: 8px;
    }

    .footer-logo-text {
        font-size: 20px;
        font-weight: 800;
        color: #0d1b3e;
    }

    /* Info Section (Address, Details) */
    .footer-info-section {
        flex: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
    }

    .company-address {
        margin: 0;
        font-size: 13px;
        color: #4a5a78;
        font-weight: 500;
    }

    .company-details {
        margin: 0;
        font-size: 13px;
        color: #7a8a9e;
        display: flex;
        align-items: center;
    }

    .info-separator {
        display: inline-block;
        width: 1px;
        height: 10px;
        background-color: #c0c9d6;
        margin: 0 8px;
    }

    /* Contact Section */
    .footer-contact-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #4a5a78;
    }

    /* Policy & Copyright Section */
    .footer-policy-section {
        flex: 3;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .policy-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-policy {
        background-color: #ffffff;
        border: 1px solid #c0c9d6;
        color: #4a5a78;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-policy:hover {
        background-color: #f5f7fa;
        border-color: #4a5a78;
        color: #1a2340;
    }

    .copyright {
        margin: 0;
        font-size: 12px;
        color: #7a8a9e;
    }

    .copyright-warning {
        margin: 0;
        font-size: 11px;
        color: #a0aec0;
        text-align: right;
        word-break: keep-all;
    }
</style>

