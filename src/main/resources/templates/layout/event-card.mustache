<style>
    .event-card__visual {
        width: 100%;
        height: 210px;
        overflow: hidden;
        background: #f1f3f5;
    }

    .event-card__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
<article class="event-card">
                <a class="event-card__link" href="/event/{{id}}">
                <div class="event-card__visual" data-category="{{#categoryName}}{{categoryName}}{{/categoryName}}" aria-hidden="true">
                    {{#imageUrl}}<img class="event-card__image" src="{{imageUrl}}" alt="" loading="lazy" decoding="async">{{/imageUrl}}
                    <span class="event-card__art">DISCOVER<br>BUSAN</span>
                    <span class="event-card__visual-caption">{{i18n.common.ui0032}}</span>
                </div>
                    <div class="event-card__visual">
                        <img src="/event-files/{{id}}"
                             alt="{{i18n.event.ui0118}}: {{title}}"
                             onerror="this.parentElement.style.display='none'">
                    </div>
                <div class="event-card__body">
                    <h3 class="event-card__title">{{title}}</h3><small style="color: #6eafb6">{{i18n.common.ui0033}} {{sessionCount}}{{i18n.common.ui0034}}</small>
                    <p class="event-card__summary">{{summary}}</p>
                    <div class="event-card__period">
                        <span>{{i18n.admin.ui0099}}</span>
                        <div>{{#sessionPeriods}}<div><strong>{{name}}</strong><br>{{applyStartAt}} ~ {{applyEndAt}}</div>{{/sessionPeriods}}{{^sessionPeriods}}{{i18n.admin.ui0102}}{{/sessionPeriods}}</div>
                    </div>
                    {{#categoryName}}<span class="event-card__category">{{categoryName}}</span>{{/categoryName}}
                    {{^categoryName}}<span class="event-card__category">{{i18n.common.ui0035}}</span>{{/categoryName}}
                </div>
                </a>
                {{> layout/favorite-button}}
            </article>
