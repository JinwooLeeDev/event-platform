<style>
    .event-card__visual {
        width: 100%;
        height: 210px;
        overflow: hidden;
        background: #f1f3f5;
    }

    .event-card__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
<article class="event-card">
                <a class="event-card__link" href="/event/{{id}}">
                    <div class="event-card__visual">
                        <img src="/event-files/{{id}}"
                             alt="{{title}} 대표 이미지"
                             onerror="this.parentElement.style.display='none'">
                    </div>
                <div class="event-card__body">
                    <h3 class="event-card__title">{{title}}</h3>
                    <p class="event-card__summary">{{summary}}</p>
                    <div class="event-card__period">
                        <span>모집 기간</span>
                        <div>{{#sessionPeriods}}<div><strong>{{name}}</strong><br>{{applyStartAt}} ~ {{applyEndAt}}</div>{{/sessionPeriods}}{{^sessionPeriods}}등록된 회차가 없습니다.{{/sessionPeriods}}</div>
                    </div>
                    {{#categoryName}}<span class="event-card__category">{{categoryName}}</span>{{/categoryName}}
                    {{^categoryName}}<span class="event-card__category">카테고리 준비 중</span>{{/categoryName}}
                </div>
                </a>
                {{> layout/favorite-button}}
            </article>
