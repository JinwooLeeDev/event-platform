<style>
    /* Header Layout & Background */
    .app-header {
        width: 100%;
        height: 70px;
        background: linear-gradient(90deg, #fdfdff 0%, #d6e8ff 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Pretendard', sans-serif;
        color: #1a2340;
    }

    .header-container {
        width: 100%;
        max-width: 1400px;
        padding: 0 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Vertical Divider */
    .vertical-divider {
        width: 1px;
        height: 24px;
        background-color: #b0c9ec;
        margin: 0 24px;
    }

    /* Left: Logo */
    .header-left {
        display: flex;
        align-items: center;
    }

    .logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        gap: 8px;
    }

    .logo-text {
        font-size: 22px;
        font-weight: 800;
        color: #0d1b3e;
    }

    /* Middle: Navigation */
    .header-nav {
        flex: 1;
    }

    .nav-list {
        display: flex;
        list-style: none;
        gap: 40px;
        margin: 0;
        padding: 0;
    }

    .nav-item a {
        text-decoration: none;
        color: #1a2340;
        font-size: 16px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: color 0.2s;
    }

    .nav-item a:hover {
        color: #0044cc;
    }

    .arrow-down {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
        margin-bottom: 3px;
    }

    /* Right: User Menu */
    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .user-avatar {
        width: 28px;
        height: 28px;
        background-color: #1a2340;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-name {
        font-size: 15px;
        font-weight: 600;
    }

    /* Points Badge */
    .user-points {
        display: flex;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.6);
        padding: 4px 12px 4px 6px;
        border-radius: 20px;
        gap: 6px;
    }

    .point-badge {
        background-color: #ffaa00;
        color: white;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
    }

    .point-text {
        font-size: 14px;
        font-weight: 700;
        color: #1a2340;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-outline {
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        color: #1a2340;
        border: 1px solid #a8c4f0;
        border-radius: 20px;
        padding: 6px 16px;
        transition: all 0.2s;
    }

    .btn-outline:hover {
        background-color: rgba(255, 255, 255, 0.5);
        border-color: #0044cc;
    }

    .btn-logout {
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        color: #4a5a78;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-left: 8px;
        transition: color 0.2s;
    }

    .btn-logout:hover {
        color: #1a2340;
    }

    /* Guest Buttons */
    .guest-buttons {
        display: flex;
        gap: 12px;
    }

    .btn-text {
        text-decoration: none;
        color: #1a2340;
        font-weight: 600;
        padding: 8px 12px;
    }

    .btn-solid {
        text-decoration: none;
        background-color: #0044cc;
        color: white;
        font-weight: 600;
        padding: 8px 20px;
        border-radius: 20px;
    }
</style>

<header class="app-header">
    <div class="header-container">
        <!-- 왼쪽: 로고 영역 -->
        <div class="header-left">
            <a href="/" class="logo-link">
                <!-- 파도 모양 로고 SVG 대체 -->
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#003399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="logo-icon"><path d="M2 12c2 0 4-4 6-4s4 4 6 4 4-4 6-4M2 17c2 0 4-4 6-4s4 4 6 4 4-4 6-4"/></svg>
                <span class="logo-text">Busan Play</span>
            </a>
            <div class="vertical-divider"></div>
        </div>

        <!-- 중앙: 공통 네비게이션 -->
        <nav class="header-nav">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="/events">행사 찾기 <span class="arrow-down"></span></a>
                </li>
                <li class="nav-item"><a href="/festivals">축제</a></li>
                <li class="nav-item"><a href="/guide">이용안내</a></li>
            </ul>
        </nav>

        <!-- 오른쪽: 사용자 정보 및 메뉴 -->
        <div class="header-right">
            {{#loginUser}} <!-- 로그인 된 경우 -->
                <div class="user-profile">
                    <div class="user-avatar">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    <span class="user-name">{{loginUser.displayName}} 님 <span class="arrow-down"></span></span>
                </div>


                <div class="vertical-divider"></div>

                <div class="action-buttons">
                    {{#isPersonal}}
                        <a href="/mypage" class="btn-outline">마이페이지</a>
                    {{/isPersonal}}

                    {{#isCorporate}}
                        <a href="/company/detail" class="btn-outline">기업페이지</a>
                    {{/isCorporate}}

                    {{#isAdmin}}
                        <a href="/admin" class="btn-outline">관리자페이지</a>
                    {{/isAdmin}}

                    <form action="/logout" method="post" style="margin: 0">
                    <button type="submit" class="btn-logout" style="border: 0; background: none; font: inherit; cursor: pointer">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        로그아웃
                    </button>
                    </form>
                </div>
            {{/loginUser}}

            {{^loginUser}} <!-- 비로그인(게스트) 경우 -->
                <div class="guest-buttons">
                    <a href="/login" class="btn-text">로그인</a>
                    <a href="/signup" class="btn-solid">회원가입</a>
                </div>
            {{/loginUser}}
        </div>
    </div>
</header>
