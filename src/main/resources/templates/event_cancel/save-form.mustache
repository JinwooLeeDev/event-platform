<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.common.ui0001}}</title><link rel="stylesheet" href="/css/event-cancel.css"></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/session-style}}
<main class="company-workspace session-page"><div class="account-layout">
    {{> layout/company-nav}}
    <section class="account-content">
        <header class="company-heading"><div><p class="company-location">{{i18n.common.ui0002}}</p><h1>{{i18n.company.ui0068}}</h1><p class="company-description">{{i18n.common.ui0003}}</p></div></header>
        <section class="session-panel cancel-panel" aria-labelledby="cancel-context-title">
            <h2 id="cancel-context-title">{{i18n.common.ui0004}}</h2>
            {{#cancelSession}}
            <dl class="cancel-context"><div><dt>{{i18n.company.ui0044}}</dt><dd>{{event.title}}</dd></div><div><dt>{{i18n.admin.ui0098}}</dt><dd>{{name}}</dd></div><div><dt>{{i18n.admin.ui0065}}</dt><dd>{{startsAt}}<br>~ {{endsAt}}</dd></div><div><dt>{{i18n.admin.ui0066}}</dt><dd>{{occupiedCount}}{{i18n.admin.ui0067}}</dd></div></dl>
            {{/cancelSession}}
            {{#latestCancel}}<div class="cancel-result cancel-result--{{cancelStatusTone}}"><strong>{{i18n.common.ui0005}} {{cancelStatusLabel}}</strong><p class="cancel-reason">{{reason}}</p></div>{{/latestCancel}}
            {{#canRequestCancel}}
            <p class="cancel-notice">{{i18n.common.ui0006}}</p>
            <form action="/event-cancels/save/{{sessionId}}" method="post" id="cancel-request-form">
                <div class="cancel-field"><label for="cancel-reason">{{i18n.admin.ui0068}} <span aria-hidden="true">*</span></label><textarea id="cancel-reason" name="reason" rows="7" maxlength="255" required aria-describedby="cancel-reason-help" placeholder="{{i18n.common.ui0007}}"></textarea><small id="cancel-reason-help">{{i18n.common.ui0008}}</small></div>
                <div class="cancel-actions"><a class="company-button company-button--secondary" href="/event-sessions/{{sessionId}}">{{i18n.common.ui0009}}</a><button type="submit" class="company-button cancel-submit">{{i18n.common.ui0010}}</button></div>
            </form>
            {{/canRequestCancel}}
            {{^canRequestCancel}}<p class="cancel-notice">{{i18n.common.ui0011}}</p><a class="company-button company-button--secondary" href="/event-sessions/{{sessionId}}">{{i18n.common.ui0009}}</a>{{/canRequestCancel}}
        </section>
    </section>
</div></main>
{{> layout/footer}}
<script>
document.getElementById('cancel-request-form')?.addEventListener('submit', function(event) {
    const reason = this.elements.reason;
    reason.setCustomValidity(reason.value.trim() ? '' : BusanI18n.t("common.ui0012"));
    if (!this.reportValidity()) { event.preventDefault(); return; }
    const button = this.querySelector('button[type="submit"]'); button.disabled = true; button.textContent = BusanI18n.t("common.ui0013");
});
document.getElementById('cancel-reason')?.addEventListener('input', function() { this.setCustomValidity(''); });
window.addEventListener('pageshow', () => { const button = document.querySelector('.cancel-submit'); if (button) { button.disabled = false; button.textContent = BusanI18n.t("common.ui0010"); } });
</script>
</body></html>
