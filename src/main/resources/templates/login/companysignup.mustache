<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.auth.ui0001}}</title></head>
<body>
{{> layout/header}}
{{> login/signup-style}}
<main class="signup-page signup-page--company">
    <div class="signup-wrap">
        <nav class="signup-breadcrumb" aria-label="{{i18n.event.ui0002}}"><a href="/">{{i18n.event.ui0003}}</a><span aria-hidden="true">/</span><span>{{i18n.common.signup}}</span></nav>
        <nav class="signup-types" aria-label="{{i18n.auth.ui0002}}"><a href="/signup">{{i18n.auth.ui0003}}</a><a href="/signup/company" aria-current="page">{{i18n.auth.ui0004}}</a></nav>
        <div class="signup-layout">
            <aside class="signup-intro" aria-labelledby="signup-title">
                <span class="signup-intro-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 21V5h10v16M14 10h6v11M2 21h20M7 9h4m-4 4h4m-4 4h4m6-3h1m-1 3h1"/></svg></span>
                <h1 id="signup-title">{{i18n.auth.ui0005}}<br> {{i18n.auth.ui0006}}</h1>
                <p>{{i18n.auth.ui0007}}<br> {{i18n.auth.ui0008}}</p>
                <div class="signup-intro-guide"><h2>{{i18n.auth.ui0009}}</h2><ul><li>{{i18n.auth.ui0010}}</li><li>{{i18n.auth.ui0011}}</li><li>{{i18n.auth.ui0012}}</li><li>{{i18n.auth.ui0013}}</li></ul></div>
                <div class="signup-review-note"><strong>{{i18n.auth.ui0014}}</strong><p>{{i18n.auth.ui0015}}</p></div>
                <p class="signup-intro-login">{{i18n.auth.ui0016}}<br> <a href="/login?type=company">{{i18n.company.ui0028}} <span aria-hidden="true">↗</span></a></p>
            </aside>
            <div class="signup-content">
                <header class="signup-heading"><h2>{{i18n.auth.ui0017}}</h2><p>{{i18n.auth.ui0018}}</p><span>{{i18n.auth.ui0019}}</span></header>
                <form id="joinForm" action="/signup/company" method="post" enctype="multipart/form-data">
                    <fieldset class="signup-panel"><legend>{{i18n.company.ui0119}}</legend><p class="signup-section-description">{{i18n.auth.ui0020}}</p>
                        <div class="auth-field"><label for="email">{{i18n.admin.ui0033}}</label><div class="auth-row company-verification-row"><input id="email" name="email" type="email" maxlength="254" autocomplete="username" placeholder="name@example.com" aria-describedby="emailMessage" required><button id="sendEmailCode" class="auth-button secondary" type="button">{{i18n.auth.ui0021}}</button><button id="changeEmailButton" class="auth-button secondary" type="button" hidden>{{i18n.auth.ui0022}}</button></div></div>
                        <div class="auth-field signup-verification"><label for="emailCode">{{i18n.auth.ui0023}}</label><div class="auth-row company-verification-row"><input id="emailCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="{{i18n.auth.ui0024}}" aria-describedby="emailMessage"><button id="confirmEmailCode" class="auth-button secondary" type="button">{{i18n.auth.ui0025}}</button></div><p id="emailMessage" class="auth-message" role="status" aria-live="polite">{{i18n.auth.ui0026}}</p></div>
                        <div class="signup-field-grid"><div class="auth-field"><label for="password">{{i18n.auth.ui0027}}</label><input id="password" name="password" type="password" minlength="8" maxlength="16" autocomplete="new-password" aria-describedby="company-password-hint" placeholder="{{i18n.auth.ui0028}}" required></div><div class="auth-field"><label for="passwordConfirm">{{i18n.auth.ui0029}}</label><input id="passwordConfirm" name="passwordConfirm" type="password" autocomplete="new-password" placeholder="{{i18n.auth.ui0030}}" required><p id="passwordMatchMessage" class="auth-message" role="status" aria-live="polite"></p></div></div>
                        <p id="company-password-hint" class="auth-hint">{{i18n.auth.ui0031}}</p>
                    </fieldset>
                    <fieldset class="signup-panel"><legend>{{i18n.common.ui0028}}</legend><p class="signup-section-description">{{i18n.auth.ui0032}}</p>
                        <div class="auth-field"><label for="name">{{i18n.admin.ui0019}}</label><input id="name" name="name" maxlength="50" autocomplete="organization" placeholder="{{i18n.auth.ui0033}}" required></div>
                        <div class="signup-business-box"><div class="auth-field"><label for="businessNumber">{{i18n.admin.ui0020}}</label><input id="businessNumber" name="businessNumber" type="text" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="{{i18n.auth.ui0034}}" required></div>
                            <div class="signup-field-grid"><div class="auth-field"><label for="representativeName">{{i18n.company.ui0021}}</label><input id="representativeName" name="representativeName" maxlength="50" placeholder="{{i18n.auth.ui0035}}" required></div><div class="auth-field"><label for="openedOn">{{i18n.company.ui0126}}</label><input id="openedOn" name="openedOn" type="date" required></div></div>
                            <button id="checkBusinessButton" class="auth-button secondary" type="button" aria-describedby="businessVerificationMessage">{{i18n.company.ui0127}}</button><p id="businessVerificationMessage" class="auth-message" role="status" aria-live="polite">{{i18n.auth.ui0036}}</p>
                        </div>
                        <div class="auth-field"><label for="address">{{i18n.company.ui0022}}</label><input id="address" name="address" maxlength="255" autocomplete="street-address" placeholder="{{i18n.auth.ui0037}}" required></div>
                        <div class="auth-field"><label for="certificate">{{i18n.admin.ui0040}}</label><div class="signup-file-box"><input id="certificate" name="businessCertificate" type="file" accept=".pdf,.jpg,.jpeg,.png" aria-describedby="certificate-hint certificateMessage" required><p id="certificate-hint" class="auth-hint">{{i18n.auth.ui0038}}</p></div><p id="certificateMessage" class="auth-message" role="alert"></p></div>
                    </fieldset>
                    <fieldset class="signup-panel"><legend>{{i18n.company.ui0023}}</legend><p class="signup-section-description">{{i18n.auth.ui0039}}</p><div class="signup-field-grid"><div class="auth-field"><label for="contactPersonName">{{i18n.company.ui0024}}</label><input id="contactPersonName" name="contactPersonName" maxlength="20" autocomplete="name" placeholder="{{i18n.auth.ui0040}}" required></div><div class="auth-field"><label for="contactPersonPhone">{{i18n.admin.ui0039}}</label><input id="contactPersonPhone" name="contactPersonPhone" type="tel" maxlength="13" autocomplete="tel" placeholder="010-1234-5678" required></div></div></fieldset>
                    <div class="signup-submit-area"><p id="formMessage" class="auth-message" role="alert"></p><button id="joinButton" class="auth-button auth-submit" type="submit" disabled>{{i18n.auth.ui0041}}</button><p class="signup-submit-help">{{i18n.auth.ui0042}}</p></div>
                </form>
                <p class="signup-bottom">{{i18n.auth.ui0043}} <a href="/signup">{{i18n.auth.ui0044}}</a></p>
            </div>
        </div>
    </div>
</main>
{{> layout/footer}}
<script>
    const form = document.getElementById("joinForm");
    const email = document.getElementById("email");
    const code = document.getElementById("emailCode");
    const sendButton = document.getElementById("sendEmailCode");
    const confirmButton = document.getElementById("confirmEmailCode");
    const changeButton = document.getElementById("changeEmailButton");
    const joinButton = document.getElementById("joinButton");
    const verificationMessage = document.getElementById("emailMessage");
    const formMessage = document.getElementById("formMessage");

    const passwordInput = document.getElementById("password");
    const passwordConfirm = document.getElementById("passwordConfirm");
    const passwordMatchMessage =
        document.getElementById("passwordMatchMessage");

    // 사업자등록증 입력과 전용 오류 메시지
    const certificateInput = document.getElementById("certificate");
    const certificateMessage =
        document.getElementById("certificateMessage");

    // 파일 검사 규칙
    const certificateMaxSize = 10 * 1024 * 1024;
    const certificateExtensionPattern = /\.(pdf|jpe?g|png)$/i;

    // 오류 문구·붉은 테두리·강조 애니메이션 표시
    function showCertificateError(text) {
        certificateMessage.textContent = text;
        certificateInput.setAttribute("aria-invalid", "true");

        certificateInput.classList.remove("certificate-error");
        void certificateInput.offsetWidth;
        certificateInput.classList.add("certificate-error");
    }

    // 정상 파일 선택 시 오류 강조 제거
    function clearCertificateError() {
        certificateMessage.textContent = "";
        certificateInput.removeAttribute("aria-invalid");
        certificateInput.classList.remove("certificate-error");
    }

    // 파일 검사. 정상이라면 null 반환
    function validateCertificate() {
        if (certificateInput.files.length === 0) {
            return BusanI18n.t("auth.ui0045");
        }

        const file = certificateInput.files[0];

        if (file.size === 0) {
            return BusanI18n.t("company.ui0134");
        }

        if (file.size > certificateMaxSize) {
            return BusanI18n.t("company.ui0135");
        }

        if (!certificateExtensionPattern.test(file.name)) {
            return BusanI18n.t("company.ui0136");
        }

        return null;
    }

    // required 검사로 submit 이벤트 전에 막히는 경우도 강조
    certificateInput.addEventListener("invalid", () => {
        if (certificateInput.validity.valueMissing) {
            showCertificateError(BusanI18n.t("auth.ui0045"));
        }
    });

    // 파일 선택·취소 직후 검사
    certificateInput.addEventListener("change", () => {
        clearCertificateError();

        const error = validateCertificate();

        if (error !== null) {
            showCertificateError(error);
        }
    });

    passwordInput.addEventListener("input", checkPasswordMatch);
    passwordConfirm.addEventListener("input", checkPasswordMatch);

    let verifiedEmail = null;
    let busy = false;

    // 사업자 검증에 사용하는 입력 요소
    const businessNumberInput = document.getElementById("businessNumber");
    const representativeNameInput = document.getElementById("representativeName");
    const openedOnInput = document.getElementById("openedOn");
    const businessCheckButton = document.getElementById("checkBusinessButton");
    const businessMessage = document.getElementById("businessVerificationMessage");

    // 검증 성공 당시 정보와 화면 기준 유효시간
    let verifiedBusiness = null;
    let businessVerifiedUntil = 0;

    // 회원가입 중복 제출 방지
    let submitting = false;

    // 서버에 전달할 사업자 정보
    function currentBusinessInfo() {
        return {
            businessNumber: businessNumberInput.value,
            representativeName: representativeNameInput.value.trim(),
            openedOn: openedOnInput.value
        };
    }

    // 검증 당시와 현재 정보가 같고, 유효시간이 남았는지 확인
    function isBusinessVerified() {
        return verifiedBusiness !== null
            && verifiedBusiness === JSON.stringify(currentBusinessInfo())
            && Date.now() < businessVerifiedUntil;
    }

    // 화면의 검증 성공 상태 초기화
    function resetBusinessVerification() {
        verifiedBusiness = null;
        businessVerifiedUntil = 0;
        businessMessage.textContent =
            BusanI18n.t("auth.ui0046");
        businessMessage.removeAttribute("data-state");
    }

    function updateButtons() {
        const emailLocked = email.readOnly;
        const blocked = busy || submitting;

        sendButton.hidden = emailLocked;
        changeButton.hidden = !emailLocked;

        sendButton.disabled = blocked || verifiedEmail !== null;
        changeButton.disabled = blocked;

        confirmButton.disabled =
            blocked || verifiedEmail !== null || !emailLocked;

        // 재검증할 수 있도록 성공 후에도 버튼은 유지
        businessCheckButton.disabled = blocked;

        joinButton.disabled =
            blocked
            || verifiedEmail !== email.value
            || !isBusinessVerified();
    }

    // 사업자 정보가 바뀌면 기존 성공 상태 초기화
    [
        businessNumberInput,
        representativeNameInput,
        openedOnInput
    ].forEach(input => {
        input.addEventListener("input", () => {
            resetBusinessVerification();
            updateButtons();
        });

        input.addEventListener("change", () => {
            resetBusinessVerification();
            updateButtons();
        });
    });

    // 사업자 검증 버튼
    businessCheckButton.addEventListener("click", async () => {
        if (busy || submitting) {
            return;
        }

        // 이전 성공 결과를 먼저 무효화
        resetBusinessVerification();

        const inputs = [
            businessNumberInput,
            representativeNameInput,
            openedOnInput
        ];

        // 이메일·파일 등 다른 필드는 검사하지 않고 사업자 정보만 검사
        for (const input of inputs) {
            if (!input.reportValidity()) {
                updateButtons();
                return;
            }
        }

        const request = currentBusinessInfo();

        if (!request.representativeName) {
            businessMessage.textContent = BusanI18n.t("company.ui0141");
            businessMessage.dataset.state = "error";
            representativeNameInput.focus();
            updateButtons();
            return;
        }

        const requestedInfo = JSON.stringify(request);

        // 응답 도착 시간이 아닌 요청 시작 시각 기준으로 보수적으로 계산
        const requestedAt = Date.now();

        busy = true;

        // 검증 중에는 검사 대상 정보를 수정하지 못하게 함
        inputs.forEach(input => {
            input.readOnly = true;
        });

        businessMessage.textContent = BusanI18n.t("company.ui0142");
        updateButtons();

        try {
            const data = await requestVerification(
                "/api/v1/business-verifications",
                request
            );

            // 요청 도중 값이 변경됐다면 이전 응답을 사용하지 않음
            if (requestedInfo !== JSON.stringify(currentBusinessInfo())) {
                resetBusinessVerification();
                businessMessage.textContent =
                    BusanI18n.t("company.ui0143");
                return;
            }

            businessMessage.textContent = data.message;

            if (data.status === "MATCHED") {
                verifiedBusiness = requestedInfo;
                businessVerifiedUntil = requestedAt + 10 * 60 * 1000;
                businessMessage.dataset.state = "success";
            } else {
                // MISMATCHED, ERROR 등은 가입 허용하지 않음
                businessMessage.dataset.state = "error";
            }
        } catch (error) {
            businessMessage.textContent = error.message;
            businessMessage.dataset.state = "error";
        } finally {
            inputs.forEach(input => {
                input.readOnly = false;
            });

            busy = false;
            updateButtons();
        }
    });

    async function requestVerification(url, body) {
        const response = await fetch(url, {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(body)
        });

        const contentType = response.headers.get("content-type") || "";

        if (!contentType.includes("application/json")) {
            throw new Error(
                BusanI18n.t("common.extra006") + response.status
            );
        }

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.message || BusanI18n.t("auth.ui0047"));
        }

        return data;
    }

    sendButton.addEventListener("click", async () => {

        if (!email.reportValidity() || busy) {
            return;
        }

        const targetEmail = email.value;
        busy = true;
        email.readOnly = true;
        verifiedEmail = null;
        updateButtons();
        verificationMessage.textContent = BusanI18n.t("auth.ui0048");

        try {
            const data = await requestVerification(
                "/api/v1/email-verifications",
                {email: targetEmail}
            );

            code.value = "";
            verificationMessage.textContent = data.message;
        } catch (error) {
            email.readOnly = false;
            verificationMessage.textContent = error.message;
        } finally {
            busy = false;
            updateButtons();
        }
    });

    confirmButton.addEventListener("click", async () => {
        if (!code.value.trim()) {
            verificationMessage.textContent = BusanI18n.t("auth.ui0049");
            return;
        }

        if (busy) {
            return;
        }

        busy = true;
        updateButtons();

        try {
            const data = await requestVerification(
                "/api/v1/email-verifications/confirm",
                {
                    email: email.value,
                    code: code.value.trim()
                }
            );

            verifiedEmail = data.verified ? email.value : null;
            verificationMessage.textContent = data.message;
        } catch (error) {
            verificationMessage.textContent = error.message;
        } finally {
            busy = false;
            updateButtons();
        }
    });

    changeButton.addEventListener("click", () => {
        verifiedEmail = null;
        email.readOnly = false;
        code.value = "";
        changeButton.hidden = true;
        verificationMessage.textContent = BusanI18n.t("auth.ui0050");
        updateButtons();
        email.focus();
    });

    form.addEventListener("submit", (event) => {
        formMessage.textContent = "";

            if (busy || submitting) {
            event.preventDefault();
            return;
        }

        if (!isBusinessVerified()) {
            event.preventDefault();

            resetBusinessVerification();
            businessMessage.textContent =
                BusanI18n.t("auth.ui0051");
            businessMessage.dataset.state = "error";
            formMessage.textContent = businessMessage.textContent;

            updateButtons();
            businessCheckButton.focus();
            return;
        }

        if (!verifiedEmail || verifiedEmail !== email.value) {
            event.preventDefault();
            formMessage.textContent = BusanI18n.t("auth.ui0052");
            return;
        }

        const password = document.getElementById("password").value;
        const confirmation = document.getElementById("passwordConfirm").value;
        const passwordPattern =
            /^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@!%*#?&])[A-Za-z\d$@!%*#?&]{8,16}$/;

        if (!passwordPattern.test(password)) {
            event.preventDefault();
            formMessage.textContent =
                BusanI18n.t("auth.ui0053");
            return;
        }

        if (password !== confirmation) {
            event.preventDefault();
            formMessage.textContent = BusanI18n.t("auth.ui0054");
            return;
        }

        const certificateError = validateCertificate();

        if (certificateError !== null) {
            event.preventDefault();
            formMessage.textContent = certificateError;
            showCertificateError(certificateError);
            certificateInput.focus();
            return;
        }

        submitting = true;
        updateButtons();
    });

    function checkPasswordMatch() {
        const hasConfirmation = passwordConfirm.value !== "";
        const mismatch =
            hasConfirmation
            && passwordInput.value !== passwordConfirm.value;

        passwordConfirm.setCustomValidity(
            mismatch ? BusanI18n.t("auth.ui0055") : ""
        );

        passwordMatchMessage.textContent = !hasConfirmation
            ? ""
            : mismatch
                ? BusanI18n.t("auth.ui0055")
                : BusanI18n.t("company.ui0145");

        passwordMatchMessage.style.color =
            mismatch ? "#b42318" : "#087443";
    }

    // 가입 실패 후 뒤로 돌아왔을 때 버튼과 비밀번호 안내 복원
    window.addEventListener("pageshow", () => {
        submitting = false;
        resetBusinessVerification();
        updateButtons();
        checkPasswordMatch();
    });

    updateButtons();
</script>
</body>
</html>
