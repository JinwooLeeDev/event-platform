<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>기업 회원가입</title>
</head>
<body>
{{>layout/header}}
{{> layout/company-style}}
<main class="auth-page">
    <section class="auth-card company-card">

        <h1>기업 회원가입</h1>
        <p>가입 후 관리자 기업 심사를 진행합니다.</p>

        <form id="joinForm" action="/signup/company" method="post" enctype="multipart/form-data">
            <fieldset>
                <legend>계정 정보</legend>

                <div class="auth-field">
                    <label for="email">이메일</label>

                    <div class="auth-row company-verification-row">
                        <input id="email"
                               name="email"
                               type="email"
                               maxlength="254"
                               autocomplete="username"
                               placeholder="name@example.com"
                               aria-describedby="emailMessage"
                               required>

                        <button id="sendEmailCode"
                                class="auth-button secondary"
                                type="button">
                            인증번호 발송
                        </button>

                        <button id="changeEmailButton"
                                class="auth-button secondary"
                                type="button"
                                hidden>
                            이메일 다시 입력
                        </button>
                    </div>
                </div>

                <div class="auth-field">
                    <label for="emailCode">인증번호</label>

                    <div class="auth-row company-verification-row">
                        <input id="emailCode"
                               type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="숫자 6자리"
                               aria-describedby="emailMessage">

                        <button id="confirmEmailCode"
                                class="auth-button secondary"
                                type="button">
                            인증 확인
                        </button>
                    </div>

                    <p id="emailMessage"
                       class="auth-message"
                       role="status"
                       aria-live="polite">
                        이메일 인증을 완료해주세요.
                    </p>
                </div>

                <p>
                    <label for="password">비밀번호</label><br>
                    <input id="password"
                           name="password"
                           type="password"
                           minlength="8"
                           maxlength="16"
                           autocomplete="new-password"
                           required>
                    <br>
                    <small>영문·숫자·특수문자($@!%*#?&) 포함 8~16자</small>
                </p>

                <div class="auth-field">
                    <label for="passwordConfirm">비밀번호 확인</label>
                    <input id="passwordConfirm"
                           name="passwordConfirm"
                           type="password"
                           autocomplete="new-password"
                           required>

                    <p id="passwordMatchMessage"
                       class="auth-message"
                       role="status"
                       aria-live="polite"></p>
                </div>
            </fieldset>

            <fieldset>
                <legend>기업 정보</legend>

                <p>
                    <label for="name">기업명</label><br>
                    <input id="name" name="name" maxlength="50" required>
                </p>

                <p>
                    <label for="businessNumber">사업자등록번호</label><br>
                    <input id="businessNumber"
                           name="businessNumber"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]{10}"
                           minlength="10"
                           maxlength="10"
                           placeholder="하이픈 없이 숫자 10자리"
                           required>
                </p>

                <p>
                    <label for="representativeName">대표자명</label><br>
                    <input id="representativeName"
                           name="representativeName"
                           maxlength="50"
                           required>
                </p>

                <p>
                    <label for="openedOn">개업일자</label><br>
                    <input id="openedOn"
                           name="openedOn"
                           type="date"
                           required>
                </p>

                <p>
                    <label for="address">기업 주소</label><br>
                    <input id="address"
                           name="address"
                           maxlength="255"
                           required>
                </p>

                <div class="auth-field">
                    <label for="certificate">사업자등록증</label>

                    <input id="certificate"
                           name="businessCertificate"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           aria-describedby="certificateMessage"
                           required>

                    <small>
                        PDF·JPG·JPEG·PNG 파일을 최대 10MB까지 첨부할 수 있습니다.
                    </small>

                    <p id="certificateMessage"
                       class="auth-message"
                       role="alert"></p>
                </div>
            </fieldset>

            <fieldset>
                <legend>담당자 정보</legend>

                <p>
                    <label for="contactPersonName">담당자 이름</label><br>
                    <input id="contactPersonName"
                           name="contactPersonName"
                           maxlength="20"
                           required>
                </p>

                <p>
                    <label for="contactPersonPhone">담당자 연락처</label><br>
                    <input id="contactPersonPhone"
                           name="contactPersonPhone"
                           type="tel"
                           maxlength="13"
                           placeholder="010-1234-5678"
                           required>
                </p>
            </fieldset>

            <p id="formMessage" role="alert"></p>

            <button id="joinButton" type="submit" disabled>
                기업 가입 신청
            </button>

            <a href="/login?type=company">로그인으로 이동</a>
        </form>
    </section>
</main>

{{>layout/footer}}

<script>
    const form = document.getElementById("joinForm");
    const email = document.getElementById("email");
    const code = document.getElementById("emailCode");
    const sendButton = document.getElementById("sendEmailCode");
    const confirmButton = document.getElementById("confirmEmailCode");
    const changeButton = document.getElementById("changeEmailButton");
    const joinButton = document.getElementById("joinButton");
    const verificationMessage = document.getElementById("emailMessage");
    const formMessage = document.getElementById("formMessage");

    const passwordInput = document.getElementById("password");
    const passwordConfirm = document.getElementById("passwordConfirm");
    const passwordMatchMessage =
        document.getElementById("passwordMatchMessage");

    // 사업자등록증 입력과 전용 오류 메시지
    const certificateInput = document.getElementById("certificate");
    const certificateMessage =
        document.getElementById("certificateMessage");

    // 파일 검사 규칙
    const certificateMaxSize = 10 * 1024 * 1024;
    const certificateExtensionPattern = /\.(pdf|jpe?g|png)$/i;

    // 오류 문구·붉은 테두리·강조 애니메이션 표시
    function showCertificateError(text) {
        certificateMessage.textContent = text;
        certificateInput.setAttribute("aria-invalid", "true");

        certificateInput.classList.remove("certificate-error");
        void certificateInput.offsetWidth;
        certificateInput.classList.add("certificate-error");
    }

    // 정상 파일 선택 시 오류 강조 제거
    function clearCertificateError() {
        certificateMessage.textContent = "";
        certificateInput.removeAttribute("aria-invalid");
        certificateInput.classList.remove("certificate-error");
    }

    // 파일 검사. 정상이라면 null 반환
    function validateCertificate() {
        if (certificateInput.files.length === 0) {
            return "사업자등록증 파일을 첨부해주세요.";
        }

        const file = certificateInput.files[0];

        if (file.size === 0) {
            return "비어 있는 파일은 첨부할 수 없습니다.";
        }

        if (file.size > certificateMaxSize) {
            return "파일 크기는 10MB 이하여야 합니다.";
        }

        if (!certificateExtensionPattern.test(file.name)) {
            return "PDF·JPG·JPEG·PNG 파일만 첨부할 수 있습니다.";
        }

        return null;
    }

    // required 검사로 submit 이벤트 전에 막히는 경우도 강조
    certificateInput.addEventListener("invalid", () => {
        if (certificateInput.validity.valueMissing) {
            showCertificateError("사업자등록증 파일을 첨부해주세요.");
        }
    });

    // 파일 선택·취소 직후 검사
    certificateInput.addEventListener("change", () => {
        clearCertificateError();

        const error = validateCertificate();

        if (error !== null) {
            showCertificateError(error);
        }
    });

    passwordInput.addEventListener("input", checkPasswordMatch);
    passwordConfirm.addEventListener("input", checkPasswordMatch);

    let verifiedEmail = null;
    let busy = false;

    function updateButtons() {
        // 발송 후 이메일이 잠기면 같은 위치에 다시 입력 버튼 표시
        const emailLocked = email.readOnly;

        sendButton.hidden = emailLocked;
        changeButton.hidden = !emailLocked;

        sendButton.disabled = busy || verifiedEmail !== null;
        changeButton.disabled = busy;

        confirmButton.disabled =
            busy || verifiedEmail !== null || !emailLocked;

        joinButton.disabled =
            busy || verifiedEmail !== email.value;
    }

    async function requestVerification(url, body) {
        const response = await fetch(url, {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(body)
        });

        const contentType = response.headers.get("content-type") || "";

        if (!contentType.includes("application/json")) {
            throw new Error(
                "인증 요청을 처리하지 못했습니다. HTTP " + response.status
            );
        }

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.message || "이메일 인증 요청에 실패했습니다.");
        }

        return data;
    }

    sendButton.addEventListener("click", async () => {

        if (!email.reportValidity() || busy) {
            return;
        }

        const targetEmail = email.value;
        busy = true;
        email.readOnly = true;
        verifiedEmail = null;
        updateButtons();
        verificationMessage.textContent = "인증번호를 발송하고 있습니다.";

        try {
            const data = await requestVerification(
                "/api/v1/email-verifications",
                {email: targetEmail}
            );

            code.value = "";
            verificationMessage.textContent = data.message;
        } catch (error) {
            email.readOnly = false;
            verificationMessage.textContent = error.message;
        } finally {
            busy = false;
            updateButtons();
        }
    });

    confirmButton.addEventListener("click", async () => {
        if (!code.value.trim()) {
            verificationMessage.textContent = "인증번호를 입력해주세요.";
            return;
        }

        if (busy) {
            return;
        }

        busy = true;
        updateButtons();

        try {
            const data = await requestVerification(
                "/api/v1/email-verifications/confirm",
                {
                    email: email.value,
                    code: code.value.trim()
                }
            );

            verifiedEmail = data.verified ? email.value : null;
            verificationMessage.textContent = data.message;
        } catch (error) {
            verificationMessage.textContent = error.message;
        } finally {
            busy = false;
            updateButtons();
        }
    });

    changeButton.addEventListener("click", () => {
        verifiedEmail = null;
        email.readOnly = false;
        code.value = "";
        changeButton.hidden = true;
        verificationMessage.textContent = "이메일을 다시 인증해주세요.";
        updateButtons();
        email.focus();
    });

    form.addEventListener("submit", (event) => {
        formMessage.textContent = "";

        if (!verifiedEmail || verifiedEmail !== email.value) {
            event.preventDefault();
            formMessage.textContent = "가입 이메일 인증을 완료해주세요.";
            return;
        }

        const password = document.getElementById("password").value;
        const confirmation = document.getElementById("passwordConfirm").value;
        const passwordPattern =
            /^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@!%*#?&])[A-Za-z\d$@!%*#?&]{8,16}$/;

        if (!passwordPattern.test(password)) {
            event.preventDefault();
            formMessage.textContent =
                "비밀번호는 영문·숫자·특수문자를 포함한 8~16자로 입력해주세요.";
            return;
        }

        if (password !== confirmation) {
            event.preventDefault();
            formMessage.textContent = "비밀번호 확인이 일치하지 않습니다.";
            return;
        }

        const certificateError = validateCertificate();

        if (certificateError !== null) {
            event.preventDefault();
            formMessage.textContent = certificateError;
            showCertificateError(certificateError);
            certificateInput.focus();
            return;
        }

        joinButton.disabled = true;
    });

    function checkPasswordMatch() {
        const hasConfirmation = passwordConfirm.value !== "";
        const mismatch =
            hasConfirmation
            && passwordInput.value !== passwordConfirm.value;

        passwordConfirm.setCustomValidity(
            mismatch ? "새 비밀번호와 일치하지 않습니다." : ""
        );

        passwordMatchMessage.textContent = !hasConfirmation
            ? ""
            : mismatch
                ? "새 비밀번호와 일치하지 않습니다."
                : "비밀번호가 일치합니다.";

        passwordMatchMessage.style.color =
            mismatch ? "#b42318" : "#087443";
    }

    // 가입 실패 후 뒤로 돌아왔을 때 버튼과 비밀번호 안내 복원
    window.addEventListener("pageshow", () => {
        updateButtons();
        checkPasswordMatch();
    });

    updateButtons();
</script>
</body>
</html>
