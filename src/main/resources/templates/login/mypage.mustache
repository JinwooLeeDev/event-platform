<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>마이페이지 | Busan Play</title>
    <style>
        .member-page { background: #f8f9fb; padding: 44px 24px 60px; color: #292f3d; font-family: 'Pretendard',sans-serif; }
        .member-page * { box-sizing: border-box; }
        .member-page [hidden] { display: none !important; }
        .member-wrap { max-width: 1100px; margin: auto; }
        .member-eyebrow { color: #0750d8; font-size: 11px; font-weight: 800; letter-spacing: 2px; }
        .member-page h1 { font-size: clamp(26px,4vw,36px); margin: 14px 0 10px; letter-spacing: -1px; overflow-wrap: anywhere; }
        .member-muted { color: #72757e; line-height: 1.7; font-size: 14px; }
        .member-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 28px 0; }
        .member-box { background: white; border: 1px solid #e6e7eb; padding: 28px; border-radius: 20px; box-shadow: 0 6px 24px rgba(20,40,95,.035); }
        .member-box h2 { font-size: 21px; margin: 0 0 10px; }
        .member-point { background: #f3efe8; color: #292f3d; border-color: #e7e1d7; }
        .member-point strong { display: block; font-size: 34px; margin: 14px 0; overflow-wrap: anywhere; }
        .member-point p { color: #72716e; }
        .member-point a { color: #0750d8; text-underline-offset: 4px; }
        .member-button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; padding: 12px 20px; border: 1px solid #0750d8; border-radius: 10px; background: #0750d8; color: white; font: inherit; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; }
        .member-button.secondary { color: #292f3d; background: white; border-color: #d9dbe1; }
        .member-button:disabled { opacity: .6; cursor: wait; }
        .member-page a:focus-visible,.member-page button:focus-visible,.member-page input:focus-visible,.member-page select:focus-visible { outline: 3px solid #9cbfff; outline-offset: 3px; }
        .member-details { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin: 12px 0 24px; }
        .member-details div { padding: 18px 0; border-bottom: 1px solid #ececef; }
        .member-details dt { font-size: 12px; color: #72757e; margin-bottom: 8px; }
        .member-details dd { margin: 0; line-height: 1.6; overflow-wrap: anywhere; }
        .member-form { max-width: 560px; margin-top: 24px; }
        .member-field { margin-bottom: 18px; }
        .member-field label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 8px; }
        .member-field input,.member-field select { width: 100%; padding: 13px; border: 1px solid #d9dbe1; border-radius: 10px; font: inherit; color: #292f3d; background: white; }
        .member-field input[readonly] { background: #f5f5f6; }
        .member-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .member-success { background: #eaf7ee; color: #21613c; padding: 14px; border-radius: 10px; }
        .member-error { color: #b42318; font-size: 14px; }
        .member-bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px; }
        @media(max-width:650px) { .member-page { padding: 30px 16px 40px; } .member-summary,.member-details { grid-template-columns: 1fr; } .member-box { padding: 22px; } .member-bottom { align-items: flex-start; flex-direction: column; } }
    </style>
</head>
<body>
{{> layout/header}}
{{> layout/account-style}}
<main class="member-page">
    <div class="account-layout">
        {{> layout/account-nav}}
    <div class="member-wrap account-content">
        <span class="member-eyebrow">BUSAN PLAY · MY PAGE</span>
        <h1>반가워요, {{myPage.displayName}} 님.</h1>
        <p class="member-muted">내 정보를 관리하고 부산에서의 즐거운 경험을 이어가세요.</p>
        <div class="member-summary">
            <section class="member-box member-point" aria-labelledby="point-title">
                <h2 id="point-title">내 보유 포인트</h2>
                <strong id="member-point">{{myPage.point}}</strong>
                <p>현재 계정에 저장된 실제 포인트입니다.</p>
                <a href="/mypoint">포인트 관리 페이지 →</a>
            </section>
            <section class="member-box" aria-labelledby="history-title">
                <h2 id="history-title">내 행사</h2>
                <p class="member-muted">신청한 행사와 참가 상태를 확인하는 공간입니다.<br>현재 내역 화면은 임시 데이터로 구성되어 있습니다.</p>
                <a class="member-button" href="/myhistory">내 행사 내역 보기 →</a>
            </section>
        </div>
        <section class="member-box" aria-labelledby="profile-title">
            <h2 id="profile-title">내 정보</h2>
            <p class="member-muted">실제 가입 정보입니다. 이름과 선호 언어를 변경할 수 있습니다.</p>
            {{#successMessage}}<p class="member-success" role="status">{{successMessage}}</p>{{/successMessage}}
            <div id="member-view">
                <dl class="member-details">
                    <div><dt>이메일</dt><dd>{{myPage.email}}</dd></div>
                    <div><dt>이름</dt><dd>{{myPage.displayName}}</dd></div>
                    <div><dt>선호 언어</dt><dd id="member-language">{{myPage.preferredLocale}}</dd></div>
                    <div><dt>가입일</dt><dd>{{myPage.createdAt}}</dd></div>
                </dl>
                <button id="member-edit" class="member-button" type="button" aria-controls="member-form" aria-expanded="false" hidden>내 정보 수정</button>
            </div>
            <form id="member-form" class="member-form" action="/mypage" method="post" hidden>
                <div class="member-field"><label for="member-email">이메일</label><input id="member-email" type="email" value="{{myPage.email}}" readonly><p class="member-muted">이메일은 변경할 수 없습니다.</p></div>
                <div class="member-field"><label for="member-name">이름</label><input id="member-name" name="displayName" value="{{myPage.displayName}}" autocomplete="name" maxlength="100" required></div>
                <div class="member-field"><label for="member-locale">선호 언어</label><select id="member-locale" name="preferredLocale" data-current="{{myPage.preferredLocale}}" required><option value="" disabled>언어 선택</option><option value="ko">한국어</option><option value="en">English</option><option value="ja">日本語</option><option value="zh-CN">简体中文</option></select></div>
                <p id="member-message" class="member-error" role="status"></p>
                <div class="member-actions"><button id="member-save" class="member-button" type="submit">변경 사항 저장</button><button id="member-cancel" class="member-button secondary" type="button">취소</button></div>
            </form>
            <noscript><p class="member-muted">정보 수정은 JavaScript를 활성화한 뒤 이용해주세요.</p></noscript>
        </section>
        <section id="password-settings" class="member-box" aria-labelledby="password-title" style="margin-top: 24px;">
            <h2 id="password-title">비밀번호 변경</h2>
            <p class="member-muted">변경 후 현재 기기에서 로그아웃됩니다. 새 비밀번호로 다시 로그인해주세요.</p>
            {{#passwordError}}<p class="member-error" role="alert">{{passwordError}}</p>{{/passwordError}}
            <form id="password-form" class="member-form" action="/mypage/password" method="post">
                <div class="member-field"><label for="current-password">현재 비밀번호</label><input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required></div>
                <div class="member-field"><label for="new-password">새 비밀번호</label><input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="8" aria-describedby="password-rule" required><p id="password-rule" class="member-muted">8자 이상, UTF-8 기준 72바이트 이하로 입력해주세요. 현재 비밀번호는 사용할 수 없습니다.</p></div>
                <div class="member-field"><label for="new-password-confirm">새 비밀번호 확인</label><input id="new-password-confirm" name="newPasswordConfirm" type="password" autocomplete="new-password" required></div>
                <p id="password-form-message" class="member-error" role="status"></p>
                <button id="password-save" class="member-button" type="submit">비밀번호 변경</button>
            </form>
        </section>
        <div class="member-bottom">
            <a class="member-button secondary" href="/">메인으로 돌아가기</a>
            <form action="/logout" method="post"><button class="member-button secondary" type="submit">로그아웃</button></form>
        </div>
    </div>
    </div>
</main>
{{> layout/footer}}
<script>
(() => {
    const form = document.getElementById('password-form');
    const password = document.getElementById('new-password');
    const confirmation = document.getElementById('new-password-confirm');
    const message = document.getElementById('password-form-message');
    const button = document.getElementById('password-save');
    let submitting = false;
    function validateConfirmation() {
        confirmation.setCustomValidity(confirmation.value && confirmation.value !== password.value ? '새 비밀번호 확인이 일치하지 않습니다.' : '');
    }
    password.addEventListener('input', validateConfirmation);
    confirmation.addEventListener('input', validateConfirmation);
    form.addEventListener('submit', event => {
        if (submitting) { event.preventDefault(); return; }
        validateConfirmation();
        if (!form.reportValidity()) { event.preventDefault(); return; }
        if (new TextEncoder().encode(password.value).length > 72) {
            event.preventDefault(); message.textContent = '새 비밀번호는 UTF-8 기준 72바이트 이하로 입력해주세요.'; password.focus(); return;
        }
        message.textContent = ''; submitting = true; button.disabled = true; button.textContent = '변경 중…';
    });
    window.addEventListener('pageshow', () => { form.reset(); submitting = false; button.disabled = false; button.textContent = '비밀번호 변경'; message.textContent = ''; validateConfirmation(); });
})();
(() => {
    const get = id => document.getElementById(id);
    const form = get('member-form'), view = get('member-view'), edit = get('member-edit');
    const name = get('member-name'), locale = get('member-locale'), save = get('member-save'), cancel = get('member-cancel');
    const languages = {ko:'한국어',en:'English',ja:'日本語','zh-CN':'简体中文'};
    const originalName = name.value, originalLocale = locale.dataset.current;
    let submitting = false;
    locale.value = Object.hasOwn(languages, originalLocale) ? originalLocale : '';
    get('member-language').textContent = languages[originalLocale] || originalLocale;
    edit.hidden = false;
    function editing(enabled) { view.hidden = enabled; form.hidden = !enabled; edit.setAttribute('aria-expanded', String(enabled)); get('member-message').textContent = ''; }
    edit.addEventListener('click', () => { editing(true); name.focus(); });
    cancel.addEventListener('click', () => { if(submitting) return; name.value = originalName; locale.value = Object.hasOwn(languages, originalLocale) ? originalLocale : ''; editing(false); edit.focus(); });
    form.addEventListener('submit', event => {
        if(submitting || form.hidden) { event.preventDefault(); return; }
        if(!name.value.trim()) { event.preventDefault(); get('member-message').textContent = '이름을 입력해주세요.'; name.focus(); return; }
        if(!form.reportValidity()) { event.preventDefault(); return; }
        submitting = true; save.disabled = true; cancel.disabled = true; save.textContent = '저장 중…';
    });
    window.addEventListener('pageshow', () => { submitting = false; save.disabled = false; cancel.disabled = false; save.textContent = '변경 사항 저장'; });
    const point = get('member-point'), amount = Number(point.textContent.trim());
    if(Number.isFinite(amount)) point.textContent = amount.toLocaleString('ko-KR') + 'P';
})();
</script>
</body>
</html>
