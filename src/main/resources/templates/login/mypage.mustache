<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>마이페이지 | Busan Play</title>
    {{> login/style}}
    <style>
        .mypage-details {
            margin: 0;
        }

        .mypage-item {
            padding: 20px 0;
            border-bottom: 1px solid #e6edf7;
        }

        .mypage-item:first-child {
            padding-top: 0;
        }

        .mypage-item:last-child {
            border-bottom: none;
        }

        .mypage-item dt {
            margin-bottom: 8px;
            color: #7384a8;
            font-size: 13px;
            font-weight: 600;
        }

        .mypage-item dd {
            margin: 0;
            color: #14285f;
            font-size: 16px;
            font-weight: 600;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .mypage-actions {
            margin-top: 28px;
        }

        .mypage-edit-actions {
            display: flex;
            gap: 10px;
            margin-top: 24px;
        }

        .mypage-edit-actions .auth-button {
            flex: 1;
        }

        .mypage-logout {
            margin-top: 12px;
        }

        #mypage-locale {
            width: 100%;
            height: 48px;
            padding: 0 12px;
            border: 1px solid #cbd8ec;
            border-radius: 10px;
            background: white;
            color: #14285f;
            font: inherit;
            font-size: 14px;
        }

        #mypage-locale:focus-visible {
            outline: 3px solid #9cbfff;
            outline-offset: 3px;
        }

        @media (max-width: 400px) {
            .mypage-edit-actions {
                flex-direction: column;
            }
        }

        /* ========================================= */
        /* [f/5 브랜치 수정] 좌측 배치를 위한 신청 내역 스타일 변경 */
        /* ========================================= */
        .mypage-registrations {
            margin-top: 40px;
            padding: 28px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(20, 40, 95, 0.04); /* 우측 카드와 비슷한 그림자 효과 */
            width: 100%;
        }

        .mypage-registrations h3 {
            color: #14285f;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 16px;
            margin-top: 0;
        }

        .reg-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            text-align: left;
        }

        .reg-table th {
            padding: 12px 8px;
            color: #7384a8;
            font-weight: 600;
            border-bottom: 1px solid #e6edf7;
        }

        .reg-table td {
            padding: 16px 8px;
            color: #14285f;
            border-bottom: 1px solid #f1f5fa;
            vertical-align: middle;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-confirmed {
            background-color: #e3f2fd;
            color: #1565c0;
        }

        .status-waiting {
            background-color: #fff3e0;
            color: #ef6c00;
        }

        .status-cancelled {
            background-color: #ffebee;
            color: #c62828;
        }

        .btn-cancel {
            padding: 6px 12px;
            border: 1px solid #ff4d4f;
            background: transparent;
            color: #ff4d4f;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s ease-in-out;
        }

        .btn-cancel:hover {
            background: #ff4d4f;
            color: white;
        }

        .btn-cancel:disabled {
            border-color: #cbd8ec;
            color: #7384a8;
            cursor: not-allowed;
            background: transparent;
        }

        /* ========================================= */

    </style>
</head>
<body>
{{> layout/header}}
<main class="auth-page">
    <div class="auth-layout">
        <section class="auth-intro" aria-labelledby="welcome-title">
            <span class="auth-badge">BUSAN PLAY · MY PAGE</span>
            <h1 id="welcome-title">반가워요,<br>{{myPage.displayName}} 님.</h1>
            <p>나의 회원 정보를 확인하고<br>부산에서의 즐거움을 이어가세요.</p>

            <!-- ========================================= -->
            <!-- [f/5 브랜치 수정] 우측에서 좌측 하단으로 이동된 섹션 -->
            <!-- ========================================= -->
            <div class="mypage-registrations">
                <h3>나의 참가 신청 내역</h3>
                <table class="reg-table">
                    <thead>
                    <tr>
                        <th>행사명</th>
                        <th>신청 상태</th>
                        <th>대기 번호</th>
                        <th>관리</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#registrations}}
                        <tr>
                            <td>{{session.event.title}}</td>
                            <td>
                                <span class="status-badge
                                    {{#isConfirmed}}status-confirmed{{/isConfirmed}}
                                    {{#isPending}}status-confirmed{{/isPending}}
                                    {{#isWaiting}}status-waiting{{/isWaiting}}
                                    {{#isCancelled}}status-cancelled{{/isCancelled}}">
                                    {{status}}
                                </span>
                            </td>
                            <td>
                                {{#queueNumber}}{{queueNumber}}번{{/queueNumber}}
                                {{^queueNumber}}-{{/queueNumber}}
                            </td>
                            <td>
                                {{^isCancelled}}
                                    <button class="btn-cancel" data-reg-id="{{id}}">신청 취소</button>
                                {{/isCancelled}}
                            </td>
                        </tr>
                    {{/registrations}}

                    {{^registrations}}
                        <tr>
                            <td colspan="4" style="text-align: center; color: #7384a8; padding: 30px 0;">참가 신청 내역이
                                없습니다.
                            </td>
                        </tr>
                    {{/registrations}}
                    </tbody>
                </table>
            </div>
            <!-- ========================================= -->

        </section>

        <section class="auth-card" aria-labelledby="mypage-title">
            <h2 id="mypage-title">내 정보</h2>
            <p id="mypage-description" class="auth-subtitle">현재 등록된 회원 정보입니다.</p>
            {{#successMessage}}
                <p id="save-success" class="auth-message" data-state="success" role="status">{{successMessage}}</p>
            {{/successMessage}}


            <div id="mypage-view">
                <dl class="mypage-details">
                    <div class="mypage-item">
                        <dt>내 보유 포인트</dt>
                        <dd style="color: dodgerblue;" id="currentPoint">{{myPage.point}}</dd>
                    </div>
                    <div class="mypage-item">
                        <dt>이메일</dt>
                        <dd>{{myPage.email}}</dd>
                    </div>
                    <div class="mypage-item">
                        <dt>이름</dt>
                        <dd>{{myPage.displayName}}</dd>
                    </div>
                    <div class="mypage-item">
                        <dt>선호 언어</dt>
                        <dd id="locale-label" data-locale="{{myPage.preferredLocale}}">{{myPage.preferredLocale}}</dd>
                    </div>
                    <div class="mypage-item">
                        <dt>가입일</dt>
                        <dd>{{myPage.createdAt}}</dd>
                    </div>
                </dl>
                <div class="mypage-actions">
                    <button id="edit-button" class="auth-button auth-submit" type="button" aria-controls="mypage-form"
                            aria-expanded="false">내 정보 수정
                    </button>
                    <a href="/charge">
                        <button id="charge-button" class="auth-button auth-submit" type="button"
                                aria-controls="mypage-form" aria-expanded="false">포인트 충전하러 가기
                        </button>
                    </a>
                </div>
            </div>

            <form id="mypage-form" action="/mypage" method="post" hidden>
                <div class="auth-field">
                    <label for="mypage-email">이메일</label>
                    <input id="mypage-email" type="text" value="{{myPage.email}}" readonly>
                    <p class="auth-hint">이메일은 변경할 수 없습니다.</p>
                </div>
                <div class="auth-field">
                    <label for="mypage-name">이름</label>
                    <input id="mypage-name" name="displayName" type="text" value="{{myPage.displayName}}"
                           autocomplete="name" maxlength="100" required>
                </div>
                <div class="auth-field">
                    <label for="mypage-locale">선호 언어</label>
                    <select id="mypage-locale" name="preferredLocale" data-current="{{myPage.preferredLocale}}"
                            required>
                        <option value="" disabled>언어를 선택해주세요</option>
                        <option value="ko">한국어</option>
                        <option value="en">English</option>
                        <option value="ja">日本語</option>
                        <option value="zh-CN">简体中文</option>
                    </select>
                </div>
                <p class="auth-hint">가입일: {{myPage.createdAt}}</p>
                <p id="edit-message" class="auth-message" role="status" aria-live="polite"></p>
                <div class="mypage-edit-actions">
                    <button id="save-button" class="auth-button" type="submit">변경 사항 저장</button>
                    <button id="cancel-button" class="auth-button secondary" type="button">취소</button>
                </div>
            </form>

            <form class="mypage-logout" action="/logout" method="post">
                <button class="auth-button secondary auth-submit" type="submit">로그아웃</button>
            </form>
            <noscript><p class="auth-hint">정보 수정은 JavaScript를 활성화한 후 이용해주세요.</p></noscript>
        </section>
    </div>
</main>
{{> layout/footer}}
<script>
    (() => {
        const element = id => document.getElementById(id);
        const view = element('mypage-view');
        const form = element('mypage-form');
        const name = element('mypage-name');
        const locale = element('mypage-locale');
        const edit = element('edit-button');
        const save = element('save-button');
        const cancel = element('cancel-button');
        const message = element('edit-message');
        const currentPoint = element('currentPoint');
        const originalName = name.value;
        const originalLocale = locale.dataset.current;
        const languages = {ko: '한국어', en: 'English', ja: '日本語', 'zh-CN': '简体中文'};
        let editing = false;
        let submitting = false;

        locale.value = Object.hasOwn(languages, originalLocale) ? originalLocale : '';
        element('locale-label').textContent = Object.hasOwn(languages, originalLocale)
                ? languages[originalLocale] : originalLocale;

        function setEditing(enabled) {
            editing = enabled;
            view.hidden = enabled;
            form.hidden = !enabled;
            edit.setAttribute('aria-expanded', String(enabled));
            element('mypage-description').textContent = enabled
                    ? '이름과 선호 언어를 변경한 후 저장해주세요.'
                    : '현재 등록된 회원 정보입니다.';
            message.textContent = '';
        }

        edit.addEventListener('click', () => {
            const success = element('save-success');
            if (success) success.hidden = true;
            setEditing(true);
            name.focus();
        });

        cancel.addEventListener('click', () => {
            if (submitting) return;
            name.value = originalName;
            locale.value = Object.hasOwn(languages, originalLocale) ? originalLocale : '';
            setEditing(false);
            edit.focus();
        });

        form.addEventListener('submit', event => {
            if (!editing || submitting) {
                event.preventDefault();
                return;
            }
            if (!name.value.trim()) {
                event.preventDefault();
                message.textContent = '이름을 입력해주세요.';
                message.dataset.state = 'error';
                name.focus();
                return;
            }
            if (!form.reportValidity()) {
                event.preventDefault();
                return;
            }
            submitting = true;
            save.disabled = true;
            cancel.disabled = true;
            save.textContent = '저장 중…';
        });

        window.addEventListener('pageshow', () => {
            submitting = false;
            save.disabled = false;
            cancel.disabled = false;
            save.textContent = '변경 사항 저장';
        });
        setEditing(false);

        currentPoint.innerText = Number(currentPoint.innerText).toLocaleString("ko-KR") + "P"

// ========================================= //
        // [f/5 브랜치 추가] 참가 신청 취소 비동기 통신 로직
        // ========================================= //
        const cancelButtons = document.querySelectorAll('.btn-cancel');
        cancelButtons.forEach(button => {
            button.addEventListener('click', function () {
                const registrationId = this.getAttribute('data-reg-id');

                if (!confirm('정말 참가 신청을 취소하시겠습니까?\n유료 행사의 경우 차감된 포인트가 즉시 환불됩니다.')) {
                    return;
                }

                this.disabled = true;
                this.textContent = '처리 중...';

                fetch(`/api/registrations/cancel/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                        .then(response => {
                            if (!response.ok) {
                                return response.json().then(err => {
                                    throw new Error(err.message || '취소 중 오류가 발생했습니다.');
                                });
                            }
                            return response.text();
                        })
                        .then(() => {
                            alert('참가 신청이 정상적으로 취소되었습니다.');
                            window.location.reload();
                        })
                        .catch(error => {
                            alert(error.message);
                            this.disabled = false;
                            this.textContent = '신청 취소';
                        });
            });
        });
    })();
</script>
</body>
</html>
