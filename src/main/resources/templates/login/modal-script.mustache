<script>
(() => {
    if (window.BusanLogin) return;
    const dialog = document.getElementById('login-modal');
    const form = document.getElementById('login-modal-form');
    const email = document.getElementById('login-modal-email');
    const password = document.getElementById('login-modal-password');
    const submit = document.getElementById('login-modal-submit');
    const error = document.getElementById('login-modal-error');
    const close = dialog.querySelector('[data-login-close]');
    const tabs = [...dialog.querySelectorAll('[data-login-type]')];
    let kind = 'personal';
    let busy = false;
    let opener = null;

    const showError = message => { error.textContent = message; error.hidden = !message; };
    const buttonLabel = () => kind === 'company' ? '기업회원 로그인' : '개인회원 로그인';
    function selectType(type, focus = false) {
        if (busy) return;
        const next = type === 'company' ? 'company' : 'personal';
        if (kind !== next) password.value = '';
        kind = next;
        const company = kind === 'company';
        form.setAttribute('action', company ? '/login/company' : '/login');
        tabs.forEach(tab => {
            const selected = tab.dataset.loginType === kind;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            if (selected && focus) tab.focus();
        });
        document.getElementById('login-modal-panel').setAttribute('aria-labelledby', 'login-modal-' + kind + '-tab');
        document.getElementById('login-modal-description').textContent = company
            ? '기업회원으로 가입한 이메일을 입력해주세요.' : '개인회원으로 가입한 이메일을 입력해주세요.';
        document.getElementById('login-modal-personal-signup').hidden = company;
        document.getElementById('login-modal-company-signup').hidden = !company;
        submit.textContent = buttonLabel();
        showError('');
    }
    function open(options = {}) {
        if (busy) return;
        selectType(options.type);
        if (!dialog.open) {
            opener = document.activeElement;
            dialog.showModal();
            document.body.classList.add('login-modal-open');
        }
        email.focus();
    }
    function setBusy(value) {
        busy = value;
        [...tabs, email, password, submit, close].forEach(control => { control.disabled = value; });
        form.setAttribute('aria-busy', String(value));
        submit.textContent = value ? '로그인 중…' : buttonLabel();
    }
    window.BusanLogin = Object.freeze({open});
    close.addEventListener('click', () => { if (!busy) dialog.close(); });
    dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
    dialog.addEventListener('click', event => {
        const rect = dialog.getBoundingClientRect();
        if (!busy && event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
    });
    dialog.addEventListener('close', () => {
        form.reset();
        showError('');
        document.body.classList.remove('login-modal-open');
        if (opener instanceof HTMLElement && opener.isConnected) opener.focus();
    });
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectType(tab.dataset.loginType));
        tab.addEventListener('keydown', event => {
            let next;
            if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') next = 1 - index;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = 1;
            else return;
            event.preventDefault();
            selectType(tabs[next].dataset.loginType, true);
        });
    });
    document.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target.closest('a[href]');
        if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin || url.pathname !== '/login') return;
        event.preventDefault();
        open({type: url.searchParams.get('type')});
    });
    form.addEventListener('submit', async event => {
        event.preventDefault();
        if (busy || !form.reportValidity()) return;
        const data = new URLSearchParams(new FormData(form));
        showError('');
        setBusy(true);
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 20000);
        try {
            const response = await fetch(form.action, {
                method: 'POST', body: data, credentials: 'same-origin',
                headers: {Accept: 'text/html'}, signal: controller.signal
            });
            if (response.ok && response.redirected && new URL(response.url).origin === location.origin && new URL(response.url).pathname === '/') {
                password.value = '';
                if (location.pathname === '/login' || location.pathname.startsWith('/signup')) location.assign('/');
                else location.reload();
                return;
            }
            let message = '로그인하지 못했습니다. 이메일과 비밀번호를 확인해주세요.';
            if ((response.headers.get('content-type') || '').includes('application/json')) {
                const result = await response.json();
                if (typeof result.message === 'string') message = result.message;
            } else {
                const html = new DOMParser().parseFromString(await response.text(), 'text/html');
                const description = html.querySelector('.error-description');
                if (description?.textContent.trim()) message = description.textContent.trim().slice(0, 500);
            }
            showError(message);
            password.value = '';
        } catch (_) {
            showError('연결을 확인한 뒤 다시 시도해주세요.');
        } finally {
            clearTimeout(timeout);
            setBusy(false);
            if (!error.hidden) password.focus();
        }
    });
    const autoOpen = () => {
        if (location.pathname !== '/login') return;
        const showLogin = () => open({type: new URLSearchParams(location.search).get('type')});
        const localeWidget = document.querySelector('.bp-locale');
        if (localeWidget?.dataset.firstVisit === 'true') {
            document.addEventListener('busan:locale-ready', showLogin, {once: true});
        } else showLogin();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', autoOpen, {once: true});
    else autoOpen();
})();
</script>
