<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.auth.ui0056}}</title></head>
<body>
{{> layout/header}}
<main class="login-gateway"><h1>{{i18n.auth.ui0057}}</h1>
    <p>{{i18n.auth.ui0058}}</p><a href="/login">{{i18n.auth.ui0059}}</a>
    <p><a href="/">{{i18n.common.ui0031}}</a></p>
    <noscript>
        <section><h2>{{i18n.auth.ui0061}}</h2>
            <form action="/login" method="post"><label>{{i18n.admin.ui0033}} <input name="email" type="email" autocomplete="username"
                                                                  required></label><label>{{i18n.auth.ui0027}} <input name="password"
                                                                                                      type="password"
                                                                                                      autocomplete="current-password"
                                                                                                      required></label>
                <button type="submit">{{i18n.auth.ui0061}}</button>
            </form>
        </section>
        <section><h2>{{i18n.company.ui0028}}</h2>
            <form action="/login/company" method="post"><label>{{i18n.admin.ui0033}} <input name="email" type="email"
                                                                          autocomplete="username"
                                                                          required></label><label>{{i18n.auth.ui0027}} <input
                    name="password" type="password" autocomplete="current-password" required></label>
                <button type="submit">{{i18n.company.ui0028}}</button>
            </form>
        </section>
    </noscript>
</main>
{{> layout/footer}}
</body>
</html>
