{{> layout/header}}
{{> layout/main-style}}
{{> layout/favorite-assets}}

<main class="main-page" id="main-content">
    <section class="main-hero" aria-labelledby="main-hero-title">
        <div class="main-hero__inner">
            <div class="main-hero__copy">
                <p class="main-hero__location">{{i18n.main.ui0001}}</p>
                <h1 id="main-hero-title" class="main-hero__title">{{i18n.main.ui0002}}<br>{{i18n.main.ui0003}}</h1>
                <p class="main-hero__description">{{i18n.main.ui0004}}<br>{{i18n.main.ui0005}}</p>
                <div class="main-hero__actions">
                    <a class="main-button main-button--primary" href="/events/list">{{i18n.main.ui0006}} <span aria-hidden="true">↗</span></a>
                    <a class="main-button main-button--text" href="#recent-events">{{i18n.main.ui0007}} <span aria-hidden="true">↓</span></a>
                </div>
            </div>
            <div class="main-hero__scene" role="img" aria-label="{{i18n.main.ui0008}}">
                <span class="main-hero__scene-label">{{i18n.main.ui0009}}</span>
            </div>
        </div>
    </section>
    <!-- 최근 등록된 행사 -->
    <section class="main-events" id="recent-events" aria-labelledby="main-events-title">
    <div class="main-events__heading">
            <div><h2 id="main-events-title">{{i18n.main.ui0010}}</h2><p class="main-events__description">{{i18n.main.ui0011}}</p></div>
            <a class="main-events__more" href="/events/list">{{i18n.main.ui0006}} <span aria-hidden="true">→</span></a>
        </div>
        <div class="event-grid">
            {{#eventPage.eventList}}
            {{> layout/event-card}}
            {{/eventPage.eventList}}
        </div>
        {{^eventPage.eventList}}
        <div class="main-events__empty"><h3>{{i18n.main.ui0012}}</h3><p>{{i18n.main.ui0013}}</p><a class="main-button main-button--primary" href="/events/list">{{i18n.main.ui0014}}</a></div>
        {{/eventPage.eventList}}
    </section>
</main>
{{> layout/footer}}
