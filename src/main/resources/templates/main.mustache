{{> layout/header}}
{{> layout/main-style}}

<main class="main-page">
    <section class="main-hero" aria-labelledby="main-hero-title">
        <div class="main-hero__inner">
            <h1 id="main-hero-title" class="main-hero__title">부산의 오늘을 더 특별하게,<span>문화가 만드는 새로운 일상</span></h1>
            <p class="main-hero__description">팝업 · 전시 · 문화행사부터 축제까지,<br>지금, 부산에서 새로운 경험을 시작해보세요.</p>
        </div>
    </section>
    <section class="main-events" aria-labelledby="main-events-title">
    </section>
    <!-- 카테고리 선택 -->
    <section class="main-category">
        <details class="main-category__dropdown">
            <summary class="main-category__button">
                <span>카테고리 선택</span>
                <span class="main-category__arrow">⌄</span>
            </summary>
            <div class="main-category__list">
                <a href="/events/list" class="main-category__item">
                    전체 행사
                </a>
                {{#categoryList}}
                    <a href="/events/list?categoryId={{id}}"
                    class="main-category__item">
                    {{name}}
                    </a>
                {{/categoryList}}
            </div>
        </details>
    </section>
    <!-- 최근 등록된 행사 -->
    <section class="main-events" aria-labelledby="main-events-title">
    <div class="main-events__heading">
            <div><p class="main-events__eyebrow">DISCOVER BUSAN</p><h2 id="main-events-title">최근 등록된 행사</h2></div>
            <a class="main-events__more" href="/events/list">전체 보기 <span aria-hidden="true">→</span></a>
        </div>
        <p class="main-events__notice">공개된 행사 중 최신 등록순으로 최대 12개를 보여드립니다. 대표 이미지와 상세 화면 연결은 준비 중입니다.</p>
        <div class="event-grid">
            {{#eventPage.eventList}}
                <a href="/events/{{id}}" class="event-card">
                    <div class="event-card__visual"
                         data-category="{{categoryName}}"
                         aria-hidden="true">
                        <span class="event-card__badge">공개 행사</span>
                        <span class="event-card__art">DISCOVER<br>BUSAN</span>
                        <span class="event-card__visual-caption">이미지 준비 중</span>
                    </div>
                    <div class="event-card__body">
                        <h3 class="event-card__title">{{title}}</h3>
                        <p class="event-card__summary">{{summary}}</p>
                        {{#categoryName}}
                            <span class="event-card__category">{{categoryName}}</span>
                        {{/categoryName}}
                        {{^categoryName}}
                            <span class="event-card__category">카테고리 준비 중</span>
                        {{/categoryName}}
                    </div>
                </a>
            {{/eventPage.eventList}}
        </div>
        {{^eventPage.eventList}}
        <div class="main-events__empty"><h3>현재 공개된 행사가 없습니다.</h3><p>새로운 행사가 등록되면 이곳에서 확인할 수 있습니다.</p></div>
        {{/eventPage.eventList}}
    </section>
</main>
{{> layout/footer}}
