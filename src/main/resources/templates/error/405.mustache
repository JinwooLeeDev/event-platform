{{! 공통 헤더 }}
{{> layout/header}}
{{! 공통 오류 화면 CSS }}
{{> layout/ErrorCss}}

<main class="error-page">
    <div class="error-content">
        <div class="error-label">
            BUSAN PLAY · ERROR
        </div>
        <div class="error-code">
            405
        </div>
        <div class="error-divider"></div>
        <h1 class="error-title">
            {{i18n.error.ui0016}}
        </h1>
        <div class="error-description">
            {{#errorMessage}}
                <p>{{errorMessage}}</p>
            {{/errorMessage}}

            {{^errorMessage}}
                <p>{{i18n.error.ui0017}}</p>
                <p>{{i18n.error.ui0018}}</p>
            {{/errorMessage}}
        </div>
        <div class="error-actions">
            <a href="/" class="error-btn error-btn-primary">
                {{i18n.error.ui0004}}
            </a>
            <button type="button"
                    class="error-btn error-btn-secondary"
                    onclick="history.back()">
                {{i18n.error.ui0005}}
            </button>
        </div>
        <div class="error-bottom">
            {{i18n.error.ui0006}} <strong>Busan Play</strong>
        </div>
    </div>
</main>
{{! 공통 푸터 }}
{{> layout/footer}}
