{{! 공통 헤더 }}
{{> layout/header}}
{{! 공통 오류 화면 CSS }}
{{> layout/ErrorCss}}

<main class="error-page">
    <div class="error-content">
        <div class="error-label">
            BUSAN PLAY · ERROR
        </div>
        <div class="error-code">
            400
        </div>
        <div class="error-divider"></div>
        <h1 class="error-title">
            올바르지 않은 요청입니다
        </h1>
        <div class="error-description">
            {{#errorMessage}}
                <p>{{errorMessage}}</p>
            {{/errorMessage}}

            {{^errorMessage}}
                <p>요청 형식이나 입력 내용이 올바르지 않습니다.</p>
                <p>내용을 확인한 후 다시 시도해 주세요.</p>
            {{/errorMessage}}
        </div>
        <div class="error-actions">
            <a href="/" class="error-btn error-btn-primary">
                메인으로 돌아가기 &rarr;
            </a>
            <button type="button"
                    class="error-btn error-btn-secondary"
                    onclick="history.back()">
                &larr; 이전 페이지
            </button>
        </div>
        <div class="error-bottom">
            부산의 모든 즐거움, <strong>Busan Play</strong>
        </div>
    </div>
</main>
{{! 공통 푸터 }}
{{> layout/footer}}
