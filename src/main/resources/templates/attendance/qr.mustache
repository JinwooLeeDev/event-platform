<!DOCTYPE html>
<html lang="ko">
<head>{{> layout/head-meta}}<title>출석 QR | Busan Play</title></head>
<body>
{{> layout/header}}
{{> attendance/style}}
<main class="attendance-page">
    {{#qr}}
        <!-- ★ [f/42] 주최 기업용 출석 QR — 사이트가 QR 을 만들어 보여준다 (현장 화면·태블릿에 띄움) -->
        <section class="attendance-card" aria-labelledby="attendance-title">
            <span class="attendance-tag">현장 출석 QR</span>
            <h1 id="attendance-title">{{eventTitle}}</h1>
            <p class="attendance-sub">{{sessionName}} · {{scheduleText}}</p>
            {{#checkTimeText}}<p class="attendance-time">{{checkTimeText}}</p>{{/checkTimeText}}

            <div id="attendance-qr" class="attendance-qr" role="img" aria-label="출석 QR 코드" data-check-path="{{checkPath}}"></div>
            <p class="attendance-help">참가가 확정된 회원이 휴대폰 카메라로 QR을 인식하면 출석이 완료됩니다.<br>참가자는 Busan Play에 로그인되어 있어야 합니다.</p>

            <p class="attendance-count" role="status">출석 <strong>{{attendedCount}}</strong>명 / 참가 확정 {{confirmedCount}}명</p>
            <div class="attendance-actions">
                <button id="attendance-refresh" type="button" class="attendance-button attendance-button--secondary">출석 인원 새로고침</button>
            </div>
            <p id="attendance-url" class="attendance-url"></p>
        </section>
    {{/qr}}
</main>
{{> layout/footer}}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
    // ★ [f/42] 지금 접속한 사이트 주소 + 출석 경로로 QR 생성 (localhost 로 띄우면 휴대폰에서 열 수 없으니 PC 의 IP 주소로 접속)
    (() => {
        const box = document.getElementById('attendance-qr');
        if (!box) return;
        const url = location.origin + box.dataset.checkPath;
        document.getElementById('attendance-url').textContent = url;
        if (window.QRCode) {
            new QRCode(box, { text: url, width: 260, height: 260, correctLevel: QRCode.CorrectLevel.M });
        } else {
            box.textContent = 'QR을 불러오지 못했습니다. 아래 주소로 접속해 주세요.';
        }
        document.getElementById('attendance-refresh').addEventListener('click', () => location.reload());
    })();
</script>
</body>
</html>
