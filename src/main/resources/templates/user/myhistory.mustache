<!DOCTYPE html>
<html lang="ko"><head>{{> layout/head-meta}}<title>내 행사 | Busan Play</title></head><body>
{{> layout/header}}

{{> layout/bootstrap}}

<style>
    .history-page {
        min-height: 85vh;
        background: #f8f9fb;
        color: #1a2340;
    }

    .history-container {
        max-width: 1100px;
    }

    .history-card {
        border: 1px solid #e6e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }

    .history-title {
        color: #0044cc;
        font-weight: 800;
        font-size: 12px;
        letter-spacing: 2px;
    }

    /* 보유 포인트 */
    .point-box {
        background: #eaf7f0;
        border: 1px solid #d3ebde;
        border-radius: 16px;
        padding: 24px;
    }

    .point-value {
        color: #198754;
        font-size: clamp(18px, 3vw, 24px);
        font-weight: 800;
    }

    /* 참가 현황 */
    .summary-card {
        padding: 22px;
        min-height: 120px;
    }

    .summary-label {
        font-size: 13px;
        color: #75849a;
        font-weight: 600;
    }

    .summary-number {
        font-size: 27px;
        font-weight: 800;
        margin-top: 10px;
    }

    /* 필터 메뉴 */
    .history-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .history-tabs .nav-link {
        border-radius: 10px;
        padding: 11px 17px;
        color: #71829b;
        font-weight: 700;
        border: none;
    }

    .history-tabs .nav-link.active {
        color: #0044cc;
        background: #efeff2;
    }

    /* 임시 행사 포스터 */
    .event-poster {
        min-height: 240px;
        height: 100%;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .event-poster::after {
        content: "";
        position: absolute;
        right: -60px;
        bottom: -70px;
        width: 190px;
        height: 190px;
        border: 30px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
    }

    .event-poster small {
        font-size: 10px;
        letter-spacing: 2px;
        z-index: 1;
    }

    .event-poster h3 {
        font-weight: 800;
        font-size: 26px;
        line-height: 1.1;
        z-index: 1;
    }

    .poster-ocean {
        background: linear-gradient(145deg, #d6d0e5, #eee9f2);
    }

    .poster-cinema {
        background: linear-gradient(135deg, #414653, #6c697b);
    }

    .poster-market {
        background: linear-gradient(145deg, #c4d3c5, #e5ebe0);
    }

    .poster-jazz {
        background: linear-gradient(145deg, #583449, #b76c62, #eab485);
    }

    /* 행사 상세 */
    .event-body {
        padding: 24px;
    }

    .event-title {
        font-size: 19px;
        font-weight: 800;
    }

    .event-meta {
        color: #75849a;
        font-size: 13px;
    }

    .event-meta i {
        margin-right: 7px;
    }

    /* 참가 상태 */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 50px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-confirmed {
        color: #198754;
        background: #e9f7ee;
    }

    .status-pending {
        color: #b47811;
        background: #fff4dd;
    }

    .status-waiting {
        color: #245cc5;
        background: #efeff2;
    }

    .status-cancelled {
        color: #687687;
        background: #f0f1f4;
    }

    .status-note {
        background: #f4f4f6;
        border-radius: 10px;
        padding: 12px 15px;
        color: #666b75;
        font-size: 13px;
    }

    /* 결제 정보 */
    .purchase-info {
        border-top: 1px solid #edf0f5;
        padding-top: 17px;
        margin-top: 20px;
    }

    .purchase-price {
        color: #0044cc;
        font-size: 20px;
        font-weight: 800;
    }

    .purchase-caption {
        font-size: 12px;
        color: #8190a4;
    }

    .event-actions .btn {
        font-size: 13px;
        font-weight: 700;
        padding: 10px 16px;
    }

    /* 페이지 번호 */
    .pagination .page-link {
        color: #0044cc;
        border-color: #e0e8f4;
        padding: 10px 15px;
    }

    .pagination .active .page-link {
        background: #0044cc;
        color: white;
        border-color: #0044cc;
    }

    /* 안내 */
    .history-notice {
        background: #f3f0eb;
        border: 1px solid #e7e1d7;
        border-radius: 15px;
        padding: 24px;
    }

    @media (max-width: 767px) {
        .event-poster {
            min-height: 150px;
        }

        .event-body {
            padding: 18px;
        }

        .summary-card {
            padding: 16px;
        }

        .event-actions {
            width: 100%;
        }

        .event-actions .btn {
            flex: 1;
        }
    }
    /* 메인 화면과 동일한 중립색 바탕, 상태 색상은 의미 구분에만 사용 */
    .history-page .poster-ocean, .history-page .poster-market { color: #353b43; }
    .history-page .history-tabs .nav-link { background: transparent; color: #666b75; }
    .history-page .history-tabs .nav-link.active { background: #eeeff2; color: #0750d8; box-shadow: inset 0 -2px #0750d8; }
    .history-page .alert-primary { background: #f0ede7; border-color: #e2ddd4; color: #64615a; }
    .history-page .status-waiting { background: #f0edf5; color: #665482; }
    .history-page .status-confirmed { background: #edf3ee; color: #3d725c; }
    .history-page .status-pending { background: #f6f0e5; color: #8a682d; }
    .history-page .text-secondary { color: #72757e !important; }
    .history-page .history-card { background: white; }
    .history-page .event-title { color: #292f3d; }
    .history-page .history-tabs a:focus-visible { outline: 3px solid #9cbfff; outline-offset: 3px; }
    .history-page .status-ended { background: #edf0f3; color: #637084; }
    .history-page .status-rejected { background: #faecec; color: #a34b4b; }
</style>

{{> layout/account-style}}
<main class="history-page py-5">
    <div class="account-layout">
        {{> layout/account-nav}}
    <div class="container history-container account-content">

        <!-- 경로 -->
        <nav class="mb-4 small text-secondary">
            <a href="/" class="text-secondary text-decoration-none">홈</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <a href="/mypage" class="text-secondary text-decoration-none">마이페이지</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <strong class="text-dark">내 행사</strong>
        </nav>

        <!-- 페이지 제목 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <div class="history-title mb-2">BUSAN PLAY · MY TICKETS</div>
                <h1 class="account-page-title">
                    <i class="bi bi-ticket-perforated text-primary me-2"></i>
                    내 행사
                </h1>
                <p class="text-secondary mb-0">
                    나의 행사 신청 내역을 확인하세요.
                </p>
            </div>

            <a href="/events/list" class="btn btn-outline-primary rounded-3 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i>
                다른 행사 둘러보기
            </a>
        </div>

        {{> user/history-content}}

        <div class="text-end mt-4">
            <a href="/mypage"
               class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-left me-1"></i>
                마이페이지로 돌아가기
            </a>
        </div>

    </div>
    </div>
</main>

<script>
    document.querySelectorAll(".format-point").forEach(element => {
        const value = Number(element.textContent.trim());

        if (Number.isFinite(value)) {
            element.textContent = value.toLocaleString("ko-KR") + "P";
        }
    });
</script>

{{> layout/footer}}
</body></html>
