
{{> layout/header}}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
    .history-page {
        min-height: 85vh;
        background: linear-gradient(#f7faff, #ffffff);
        color: #1a2340;
    }

    .history-container {
        max-width: 1100px;
    }

    .history-card {
        border: 1px solid #e7edf5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }

    .history-title {
        color: #0044cc;
        font-weight: 800;
        font-size: 12px;
        letter-spacing: 2px;
    }

    /* 보유 포인트 */
    .point-box {
        background: #eaf7f0;
        border: 1px solid #d3ebde;
        border-radius: 16px;
        padding: 24px;
    }

    .point-value {
        color: #198754;
        font-size: 28px;
        font-weight: 800;
    }

    /* 참가 현황 */
    .summary-card {
        padding: 22px;
        min-height: 120px;
    }

    .summary-label {
        font-size: 13px;
        color: #75849a;
        font-weight: 600;
    }

    .summary-number {
        font-size: 27px;
        font-weight: 800;
        margin-top: 10px;
    }

    /* 필터 메뉴 */
    .history-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .history-tabs .nav-link {
        border-radius: 10px;
        padding: 11px 17px;
        color: #71829b;
        font-weight: 700;
        border: none;
    }

    .history-tabs .nav-link.active {
        color: #0044cc;
        background: #eaf1ff;
    }

    /* 임시 행사 포스터 */
    .event-poster {
        min-height: 240px;
        height: 100%;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .event-poster::after {
        content: "";
        position: absolute;
        right: -60px;
        bottom: -70px;
        width: 190px;
        height: 190px;
        border: 30px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
    }

    .event-poster small {
        font-size: 10px;
        letter-spacing: 2px;
        z-index: 1;
    }

    .event-poster h3 {
        font-weight: 800;
        font-size: 26px;
        line-height: 1.1;
        z-index: 1;
    }

    .poster-ocean {
        background: linear-gradient(145deg, #144e86, #1689b6, #44c2bb);
    }

    .poster-cinema {
        background: linear-gradient(135deg, #242859, #7961bf, #e37b9c);
    }

    .poster-market {
        background: linear-gradient(145deg, #0e5f77, #1d9f97, #94c991);
    }

    .poster-jazz {
        background: linear-gradient(145deg, #583449, #b76c62, #eab485);
    }

    /* 행사 상세 */
    .event-body {
        padding: 24px;
    }

    .event-title {
        font-size: 19px;
        font-weight: 800;
    }

    .event-meta {
        color: #75849a;
        font-size: 13px;
    }

    .event-meta i {
        margin-right: 7px;
    }

    /* 참가 상태 */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 50px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-confirmed {
        color: #198754;
        background: #e9f7ee;
    }

    .status-pending {
        color: #b47811;
        background: #fff4dd;
    }

    .status-waiting {
        color: #245cc5;
        background: #eaf1ff;
    }

    .status-cancelled {
        color: #687687;
        background: #f0f1f4;
    }

    .status-note {
        background: #f5f8fd;
        border-radius: 10px;
        padding: 12px 15px;
        color: #52708b;
        font-size: 13px;
    }

    /* 결제 정보 */
    .purchase-info {
        border-top: 1px solid #edf0f5;
        padding-top: 17px;
        margin-top: 20px;
    }

    .purchase-price {
        color: #0044cc;
        font-size: 20px;
        font-weight: 800;
    }

    .purchase-caption {
        font-size: 12px;
        color: #8190a4;
    }

    .event-actions .btn {
        font-size: 13px;
        font-weight: 700;
        padding: 10px 16px;
    }

    /* 페이지 번호 */
    .pagination .page-link {
        color: #0044cc;
        border-color: #e0e8f4;
        padding: 10px 15px;
    }

    .pagination .active .page-link {
        background: #0044cc;
        color: white;
        border-color: #0044cc;
    }

    /* 안내 */
    .history-notice {
        background: #f7f9fd;
        border: 1px solid #e8eef7;
        border-radius: 15px;
        padding: 24px;
    }

    @media (max-width: 767px) {
        .event-poster {
            min-height: 150px;
        }

        .event-body {
            padding: 18px;
        }

        .summary-card {
            padding: 16px;
        }

        .event-actions {
            width: 100%;
        }

        .event-actions .btn {
            flex: 1;
        }
    }
</style>

<main class="history-page py-5">
    <div class="container history-container">

        <!-- 경로 -->
        <nav class="mb-4 small text-secondary">
            <a href="/" class="text-secondary text-decoration-none">홈</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <a href="/mypage" class="text-secondary text-decoration-none">마이페이지</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <strong class="text-dark">내 행사 · 구매내역</strong>
        </nav>

        <!-- 페이지 제목 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <div class="history-title mb-2">BUSAN PLAY · MY TICKETS</div>
                <h2 class="fw-bold mb-2">
                    <i class="bi bi-ticket-perforated text-primary me-2"></i>
                    내 행사 · 구매내역
                </h2>
                <p class="text-secondary mb-0">
                    참가 예정 행사, 대기열, 구매내역을 한눈에 확인하세요.
                </p>
            </div>

            <a href="/events" class="btn btn-outline-primary rounded-3 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i>
                다른 행사 둘러보기
            </a>
        </div>

        <!-- 보유 포인트 -->
        <section class="point-box mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="text-success fw-semibold mb-2">
                        <i class="bi bi-wallet2 me-2"></i>
                        현재 보유 포인트
                    </div>

                    <h3 class="point-value format-point mb-1">
                        {{myPoint}}
                    </h3>

                    <small class="text-secondary">
                        행사 결제에 사용할 수 있는 포인트
                    </small>
                </div>

                <a href="/charge" class="btn btn-success fw-bold px-4 py-3">
                    <i class="bi bi-plus-lg me-1"></i>
                    포인트 충전하기
                </a>
            </div>
        </section>

        <!-- 참가 현황 요약 -->
        <section class="row g-3 mb-5">

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-check-circle me-1"></i>
                            참가 확정
                        </div>
                        <div class="summary-number text-success">
                            {{confirmedCount}}<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-hourglass-split me-1"></i>
                            승인 대기
                        </div>
                        <div class="summary-number text-warning">
                            {{pendingCount}}<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-people me-1"></i>
                            대기열 등록
                        </div>
                        <div class="summary-number text-primary">
                            {{waitingCount}}<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-receipt me-1"></i>
                            전체 구매내역
                        </div>
                        <div class="summary-number">
                            {{purchaseCount}}<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

        </section>

        <!-- 내 행사 -->
        <div class="mb-3">
            <h5 class="fw-bold">나의 행사</h5>
            <p class="text-secondary small mb-0">
                참가 상태와 포인트 구매내역을 확인할 수 있습니다.
            </p>
        </div>

        <!-- 필터와 검색 -->
        <section class="card history-card mb-4">
            <div class="card-body p-4">

                <div class="history-tabs nav mb-4">
                    <a href="/mypage/purchases?status=ALL&page=0"
                       class="nav-link active">
                        전체 내역
                    </a>

                    <a href="/mypage/purchases?status=UPCOMING&page=0"
                       class="nav-link">
                        예정 행사
                    </a>

                    <a href="/mypage/purchases?status=WAITING&page=0"
                       class="nav-link">
                        대기 중
                    </a>

                    <a href="/mypage/purchases?status=HISTORY&page=0"
                       class="nav-link">
                        지난 · 취소 내역
                    </a>
                </div>

                <form action="/mypage/purchases" method="get">
                    <div class="row g-2">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="search"
                                       class="form-control"
                                       name="keyword"
                                       value="{{keyword}}"
                                       placeholder="행사명으로 검색">

                                <button type="submit" class="btn btn-outline-secondary">
                                    검색
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <select class="form-select" name="sort">
                                <option value="latest">최신 구매순</option>
                                <option value="oldest">오래된 구매순</option>
                                <option value="eventDate">행사 날짜순</option>
                            </select>
                        </div>
                    </div>
                </form>

            </div>
        </section>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small text-secondary">
                조회 결과 <strong class="text-primary">{{totalCount}}</strong>건
            </span>

            <small class="text-secondary">
                참가 상태는 변경될 수 있습니다.
            </small>
        </div>

        <!-- 구매내역 목록 -->
        {{#purchaseList}}
            <article class="card history-card mb-4">

                <div class="row g-0">

                    <!-- 행사 포스터 -->
                    <div class="col-md-3">
                        <div class="event-poster {{posterClass}}">
                            <small>BUSAN PLAY · EVENT</small>

                            <div>
                                <h3>{{posterTitle}}</h3>
                                <small>BUSAN EVENT 2026</small>
                            </div>
                        </div>
                    </div>

                    <!-- 행사 정보 -->
                    <div class="col-md-9">
                        <div class="event-body">

                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <small class="text-secondary">
                                        {{category}}
                                    </small>

                                    <h5 class="event-title mt-2 mb-0">
                                        {{title}}
                                    </h5>
                                </div>

                                <span class="status-badge {{statusClass}}">
                                <i class="bi bi-circle-fill" style="font-size: 6px;"></i>
                                    {{statusLabel}}
                            </span>
                            </div>

                            <!-- 행사 일정 -->
                            <div class="event-meta mb-3">
                                <div class="mb-2">
                                    <i class="bi bi-calendar-event"></i>
                                    {{eventDate}}
                                </div>

                                <div class="mb-2">
                                    <i class="bi bi-geo-alt"></i>
                                    {{location}}
                                </div>

                                <div>
                                    <i class="bi bi-ticket-perforated"></i>
                                    {{sessionName}} · 1매
                                </div>
                            </div>

                            <!-- 상태별 안내 문구 -->
                            <div class="status-note">
                                <i class="bi bi-info-circle me-1"></i>
                                {{statusMessage}}
                            </div>

                            <!-- 결제 정보 -->
                            <div class="purchase-info">
                                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">

                                    <div>
                                        <div class="purchase-caption mb-1">
                                            결제 포인트 · 1매
                                        </div>

                                        <div class="purchase-price format-point">
                                            {{price}}
                                        </div>

                                        <div class="purchase-caption mt-1">
                                            구매일 : {{purchaseDate}}
                                        </div>
                                    </div>

                                    <!-- 버튼 영역 -->
                                    <div class="event-actions d-flex gap-2">

                                        {{#canCancel}}
                                            <form action="{{cancelUrl}}"
                                                  method="post"
                                                  onsubmit="return confirm('참가 신청을 취소하시겠습니까?')">

                                                <button type="submit"
                                                        class="btn btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    참가 취소
                                                </button>
                                            </form>
                                        {{/canCancel}}

                                        {{^canCancel}}
                                            <button type="button"
                                                    class="btn btn-light border"
                                                    disabled>
                                                취소 불가
                                            </button>
                                        {{/canCancel}}

                                        <a href="{{detailUrl}}"
                                           class="btn btn-primary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>
                                            행사 상세
                                        </a>

                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </article>
        {{/purchaseList}}

        <!-- 내역이 없는 경우 -->
        {{^purchaseList}}
            <div class="card history-card text-center py-5 mb-4">
                <div class="card-body">
                    <i class="bi bi-ticket-perforated fs-1 text-secondary"></i>
                    <h5 class="fw-bold mt-3">
                        조회되는 행사 내역이 없습니다.
                    </h5>
                    <p class="text-secondary small">
                        다른 검색 조건을 선택하거나 새로운 행사를 찾아보세요.
                    </p>

                    <a href="/events" class="btn btn-outline-primary mt-2">
                        행사 둘러보기
                    </a>
                </div>
            </div>
        {{/purchaseList}}

        <!-- 서버 페이징 -->
        <nav aria-label="구매내역 페이지" class="mt-4">
            <ul class="pagination justify-content-center">

                {{#hasPrevious}}
                    <li class="page-item">
                        <a class="page-link" href="{{previousUrl}}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                {{/hasPrevious}}

                {{^hasPrevious}}
                    <li class="page-item disabled">
                    <span class="page-link">
                        <i class="bi bi-chevron-left"></i>
                    </span>
                    </li>
                {{/hasPrevious}}

                {{#pages}}
                    <li class="page-item {{activeClass}}">
                        <a class="page-link" href="{{url}}">
                            {{number}}
                        </a>
                    </li>
                {{/pages}}

                {{#hasNext}}
                    <li class="page-item">
                        <a class="page-link" href="{{nextUrl}}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                {{/hasNext}}

                {{^hasNext}}
                    <li class="page-item disabled">
                    <span class="page-link">
                        <i class="bi bi-chevron-right"></i>
                    </span>
                    </li>
                {{/hasNext}}

            </ul>
        </nav>

        <!-- 취소 및 환불 안내 -->
        <div class="history-notice mt-5">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                참가 취소 및 환불 안내
            </h6>

            <p class="small text-secondary mb-2">
                <i class="bi bi-check2 me-2"></i>
                참가 신청 취소는 행사 시작 3일 전까지 가능합니다.
            </p>

            <p class="small text-secondary mb-2">
                <i class="bi bi-check2 me-2"></i>
                승인 대기 또는 대기열 등록 상태에서도 운영 정책에 따라 취소할 수 있습니다.
            </p>

            <p class="small text-secondary mb-0">
                <i class="bi bi-check2 me-2"></i>
                참가 취소 시 환불 포인트는 환불 정책에 따라 지급됩니다.
            </p>
        </div>

        <div class="text-end mt-4">
            <a href="/mypage"
               class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-left me-1"></i>
                마이페이지로 돌아가기
            </a>
        </div>

    </div>
</main>

<script>
    // 포인트를 1,000P 형태로 표시
    document.querySelectorAll(".format-point").forEach(element => {
        const value = Number(element.textContent.trim());

        if (Number.isFinite(value)) {
            element.textContent = value.toLocaleString("ko-KR") + "P";
        }
    });
</script>

{{> layout/footer}}
