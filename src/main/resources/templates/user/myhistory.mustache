<!DOCTYPE html>
<html lang="ko"><head>{{> layout/head-meta}}<title>내 행사 | Busan Play</title></head><body>
{{> layout/header}}

{{> layout/bootstrap}}

<style>
    .history-page {
        min-height: 85vh;
        background: #f8f9fb;
        color: #1a2340;
    }

    .history-container {
        max-width: 1100px;
    }

    .history-card {
        border: 1px solid #e6e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }

    .history-title {
        color: #0044cc;
        font-weight: 800;
        font-size: 12px;
        letter-spacing: 2px;
    }

    /* 보유 포인트 */
    .point-box {
        background: #eaf7f0;
        border: 1px solid #d3ebde;
        border-radius: 16px;
        padding: 24px;
    }

    .point-value {
        color: #198754;
        font-size: clamp(18px, 3vw, 24px);
        font-weight: 800;
    }

    /* 참가 현황 */
    .summary-card {
        padding: 22px;
        min-height: 120px;
    }

    .summary-label {
        font-size: 13px;
        color: #75849a;
        font-weight: 600;
    }

    .summary-number {
        font-size: 27px;
        font-weight: 800;
        margin-top: 10px;
    }

    /* 필터 메뉴 */
    .history-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .history-tabs .nav-link {
        border-radius: 10px;
        padding: 11px 17px;
        color: #71829b;
        font-weight: 700;
        border: none;
    }

    .history-tabs .nav-link.active {
        color: #0044cc;
        background: #efeff2;
    }

    /* 임시 행사 포스터 */
    .event-poster {
        min-height: 240px;
        height: 100%;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .event-poster::after {
        content: "";
        position: absolute;
        right: -60px;
        bottom: -70px;
        width: 190px;
        height: 190px;
        border: 30px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
    }

    .event-poster small {
        font-size: 10px;
        letter-spacing: 2px;
        z-index: 1;
    }

    .event-poster h3 {
        font-weight: 800;
        font-size: 26px;
        line-height: 1.1;
        z-index: 1;
    }

    .poster-ocean {
        background: linear-gradient(145deg, #d6d0e5, #eee9f2);
    }

    .poster-cinema {
        background: linear-gradient(135deg, #414653, #6c697b);
    }

    .poster-market {
        background: linear-gradient(145deg, #c4d3c5, #e5ebe0);
    }

    .poster-jazz {
        background: linear-gradient(145deg, #583449, #b76c62, #eab485);
    }

    /* 행사 상세 */
    .event-body {
        padding: 24px;
    }

    .event-title {
        font-size: 19px;
        font-weight: 800;
    }

    .event-meta {
        color: #75849a;
        font-size: 13px;
    }

    .event-meta i {
        margin-right: 7px;
    }

    /* 참가 상태 */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 50px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-confirmed {
        color: #198754;
        background: #e9f7ee;
    }

    .status-pending {
        color: #b47811;
        background: #fff4dd;
    }

    .status-waiting {
        color: #245cc5;
        background: #efeff2;
    }

    .status-cancelled {
        color: #687687;
        background: #f0f1f4;
    }

    .status-note {
        background: #f4f4f6;
        border-radius: 10px;
        padding: 12px 15px;
        color: #666b75;
        font-size: 13px;
    }

    /* 결제 정보 */
    .purchase-info {
        border-top: 1px solid #edf0f5;
        padding-top: 17px;
        margin-top: 20px;
    }

    .purchase-price {
        color: #0044cc;
        font-size: 20px;
        font-weight: 800;
    }

    .purchase-caption {
        font-size: 12px;
        color: #8190a4;
    }

    .event-actions .btn {
        font-size: 13px;
        font-weight: 700;
        padding: 10px 16px;
    }

    /* 페이지 번호 */
    .pagination .page-link {
        color: #0044cc;
        border-color: #e0e8f4;
        padding: 10px 15px;
    }

    .pagination .active .page-link {
        background: #0044cc;
        color: white;
        border-color: #0044cc;
    }

    /* 안내 */
    .history-notice {
        background: #f3f0eb;
        border: 1px solid #e7e1d7;
        border-radius: 15px;
        padding: 24px;
    }

    @media (max-width: 767px) {
        .event-poster {
            min-height: 150px;
        }

        .event-body {
            padding: 18px;
        }

        .summary-card {
            padding: 16px;
        }

        .event-actions {
            width: 100%;
        }

        .event-actions .btn {
            flex: 1;
        }
    }
    /* 메인 화면과 동일한 중립색 바탕, 상태 색상은 의미 구분에만 사용 */
    .history-page .poster-ocean, .history-page .poster-market { color: #353b43; }
    .history-page .history-tabs .nav-link { background: transparent; color: #666b75; }
    .history-page .history-tabs .nav-link.active { background: #eeeff2; color: #0750d8; box-shadow: inset 0 -2px #0750d8; }
    .history-page .alert-primary { background: #f0ede7; border-color: #e2ddd4; color: #64615a; }
    .history-page .status-waiting { background: #f0edf5; color: #665482; }
    .history-page .status-confirmed { background: #edf3ee; color: #3d725c; }
    .history-page .status-pending { background: #f6f0e5; color: #8a682d; }
    .history-page .text-secondary { color: #72757e !important; }
    .history-page .history-card { background: white; }
    .history-page .event-title { color: #292f3d; }
    .history-page .history-tabs button:focus-visible { outline: 3px solid #9cbfff; outline-offset: 3px; }
</style>

{{> layout/account-style}}
<main class="history-page py-5">
    <div class="account-layout">
        {{> layout/account-nav}}
    <div class="container history-container account-content">

        <!-- 경로 -->
        <nav class="mb-4 small text-secondary">
            <a href="/" class="text-secondary text-decoration-none">홈</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <a href="/mypage" class="text-secondary text-decoration-none">마이페이지</a>
            <i class="bi bi-chevron-right mx-2"></i>
            <strong class="text-dark">내 행사</strong>
        </nav>

        <!-- 페이지 제목 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <div class="history-title mb-2">BUSAN PLAY · MY TICKETS</div>
                <h1 class="account-page-title">
                    <i class="bi bi-ticket-perforated text-primary me-2"></i>
                    내 행사
                </h1>
                <p class="text-secondary mb-0">
                    {{#history}}나의 참가 신청과 회차별 진행 상태를 확인하세요.{{/history}}{{^history}}임시 데이터로 살펴보는 참가 신청·대기 현황입니다. 실제 신청 기록이 아닙니다.{{/history}}
                </p>
            </div>

            <a href="/events/list" class="btn btn-outline-primary rounded-3 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i>
                다른 행사 둘러보기
            </a>
        </div>

{{^history}}<div class="alert alert-primary mb-4" role="status"><strong>임시 데이터 안내</strong> · 탭으로 아래 예시 행사를 분류해서 볼 수 있습니다. 집계·검색·취소·페이지 이동은 아직 연결되지 않았습니다.</div>{{/history}}
        <!-- 참가 현황 요약 -->
        <section class="row g-3 mb-5">

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-check-circle me-1"></i>
                            참가 확정
                        </div>
                        <div class="summary-number text-success">
                            —<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-hourglass-split me-1"></i>
                            승인 대기
                        </div>
                        <div class="summary-number text-warning">
                            —<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-people me-1"></i>
                            대기열 등록
                        </div>
                        <div class="summary-number text-primary">
                            —<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card history-card h-100">
                    <div class="summary-card">
                        <div class="summary-label">
                            <i class="bi bi-receipt me-1"></i>
                            지난 행사
                        </div>
                        <div class="summary-number">
                            —<small class="fs-6">건</small>
                        </div>
                    </div>
                </div>
            </div>

        </section>

        <!-- 내 행사 -->
        <div class="mb-3">
            <h5 class="fw-bold">나의 행사</h5>
            <p class="text-secondary small mb-0">
                신청한 행사와 참가 상태를 확인할 수 있습니다.
            </p>
        </div>

        <!-- 필터와 검색 -->
        <section class="card history-card mb-4">
            <div class="card-body p-4">

                <div class="history-tabs nav mb-4" role="group" aria-label="나의 행사 분류">
                    <button type="button" class="nav-link active" data-history-filter="ALL" aria-pressed="true" aria-controls="history-results">
                        전체 내역
                    </button>

                    <button type="button" class="nav-link" data-history-filter="UPCOMING" aria-pressed="false" aria-controls="history-results">
                        예정 행사
                    </button>

                    <button type="button" class="nav-link" data-history-filter="WAITING" aria-pressed="false" aria-controls="history-results">
                        대기 중
                    </button>

                    <button type="button" class="nav-link" data-history-filter="HISTORY" aria-pressed="false" aria-controls="history-results">
                        지난 · 취소 내역
                    </button>
                </div>

                <fieldset disabled aria-label="내역 검색 준비 중">
                    <div class="row g-2">
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="search"
                                       class="form-control"
                                       name="keyword"
                                       value=""
                                       placeholder="행사명으로 검색">

                                <button type="submit" class="btn btn-outline-secondary">
                                    검색
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <select class="form-select" name="sort">
                                <option value="latest">최신 구매순</option>
                                <option value="oldest">오래된 구매순</option>
                                <option value="eventDate">행사 날짜순</option>
                            </select>
                        </div>
                    </div>
                </fieldset>

            </div>
        </section>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small text-secondary" role="status" aria-live="polite" aria-atomic="true">
                <span id="history-filter-label">전체 내역</span> · {{#history}}현재 조회 내역{{/history}}{{^history}}임시 데이터{{/history}} <strong id="history-result-count" class="text-primary">3</strong>건
            </span>

            <small class="text-secondary">
                참가 상태는 변경될 수 있습니다.
            </small>
        </div>

        {{! 향후 Model 계약: history = { registrations: List<신청 DTO> }.
            조회 완료 후 0건도 history 객체를 전달해야 임시 데이터로 돌아가지 않습니다.}}
        <div id="history-results">
        {{#history}}
            {{#registrations}}
            <article class="card history-card mb-4" data-history-group="ACTUAL"
                     data-registration-status="{{status}}"
                     data-session-ends-at="{{#session.endsAt}}{{session.endsAt}}{{/session.endsAt}}">
                <div class="row g-0">
                    <div class="col-md-3"><div class="event-poster poster-ocean" aria-hidden="true"><small>BUSAN PLAY · EVENT</small><h3>MY<br>EVENT</h3><small>대표 이미지 준비 중</small></div></div>
                    <div class="col-md-9"><div class="event-body">
                        {{#session.event.category.name}}<span class="badge text-bg-light mb-2">{{session.event.category.name}}</span>{{/session.event.category.name}}
                        <h3 class="event-title">{{session.event.title}}</h3>
                        <span class="status-badge status-cancelled" data-registration-label>{{status}}</span>
                        <p class="event-meta mt-3">{{session.event.summary}}</p>
                        <dl class="event-meta">
                            <div><dt>회차</dt><dd>{{session.name}}</dd></div>
                            <div><dt>개최 일시</dt><dd>{{#session.startsAt}}<time data-history-time>{{session.startsAt}}</time>{{/session.startsAt}}{{^session.startsAt}}일정 준비 중{{/session.startsAt}}{{#session.endsAt}} ~ <time data-history-time>{{session.endsAt}}</time>{{/session.endsAt}}</dd></div>
                            <div><dt>장소</dt><dd>{{session.event.address}}</dd></div>
                            {{#queueNumber}}<div><dt>대기번호</dt><dd>{{queueNumber}}번</dd></div>{{/queueNumber}}
                            <div><dt>신청일</dt><dd>{{#createdAt}}<time data-history-time>{{createdAt}}</time>{{/createdAt}}{{^createdAt}}확인 중{{/createdAt}}</dd></div>
                            <div><dt>회차 참가비</dt><dd>{{#session.fee}}<span class="format-point">{{session.fee}}</span>{{/session.fee}}{{^session.fee}}무료 또는 참가비 미등록{{/session.fee}}</dd></div>
                        </dl>
                        <p class="status-note">신청 상태를 기준으로 표시합니다. 실제 구매 내역은 포인트 관리에서 확인해주세요.</p>
                        <button type="button" class="btn btn-outline-secondary" disabled>상세·취소 기능 준비 중</button>
                    </div></div>
                </div>
            </article>
            {{/registrations}}
            {{^registrations}}<p class="status-note" data-history-no-records>아직 신청한 행사가 없습니다.</p>{{/registrations}}
        {{/history}}
        {{^history}}
        <article class="card history-card mb-4" data-history-group="UPCOMING">
            <div class="row g-0">
                <div class="col-md-3"><div class="event-poster poster-ocean"><small>BUSAN PLAY · SAMPLE</small><h3>ART<br>BY THE SEA</h3><small>임시 데이터</small></div></div>
                <div class="col-md-9"><div class="event-body">
                    <span class="badge text-bg-light mb-2">전시 · 임시 데이터</span>
                    <h3 class="event-title">부산 미디어아트 특별전</h3>
                    <span class="status-badge status-confirmed">신청 확정 예시</span>
                    <p class="event-meta mt-3 mb-1">일시: 2026.12.05 14:00 ~ 16:00</p><p class="event-meta">장소: 부산시립미술관 · 오후 회차</p>
                    <div class="status-note">참가가 확정되었을 때 표시할 화면 예시입니다.</div>
                    <div class="mt-3"><button type="button" class="btn btn-outline-secondary" disabled>상세·취소 기능 준비 중</button></div>
                </div></div>
            </div>
        </article>
        <article class="card history-card mb-4" data-history-group="UPCOMING">
            <div class="row g-0">
                <div class="col-md-3"><div class="event-poster poster-cinema"><small>BUSAN PLAY · SAMPLE</small><h3>CINEMA<br>NIGHT</h3><small>임시 데이터</small></div></div>
                <div class="col-md-9"><div class="event-body">
                    <span class="badge text-bg-light mb-2">영화 · 임시 데이터</span><h3 class="event-title">부산 야외 영화제</h3>
                    <span class="status-badge status-pending">승인 대기 예시</span>
                    <p class="event-meta mt-3 mb-1">일시: 2026.12.12 19:00 ~ 21:00</p><p class="event-meta">장소: 영화의전당 · 저녁 회차</p>
                    <div class="status-note">주최 측의 참가 승인을 기다리는 상태의 예시입니다.</div>
                    <div class="mt-3"><button type="button" class="btn btn-outline-secondary" disabled>상세·취소 기능 준비 중</button></div>
                </div></div>
            </div>
        </article>
        <article class="card history-card mb-4" data-history-group="WAITING">
            <div class="row g-0">
                <div class="col-md-3"><div class="event-poster poster-market"><small>BUSAN PLAY · SAMPLE</small><h3>LOCAL<br>WEEKEND</h3><small>임시 데이터</small></div></div>
                <div class="col-md-9"><div class="event-body">
                    <span class="badge text-bg-light mb-2">체험 · 임시 데이터</span><h3 class="event-title">로컬 크래프트 클래스</h3>
                    <span class="status-badge status-waiting">대기 중 · 대기번호 3번 예시</span>
                    <p class="event-meta mt-3 mb-1">일시: 2026.12.19 11:00 ~ 13:00</p><p class="event-meta">장소: 전포공방거리 · 오전 회차</p>
                    <div class="status-note">빈자리 발생 시 참가 상태가 변경되는 대기 화면 예시입니다.</div>
                    <div class="mt-3"><button type="button" class="btn btn-outline-secondary" disabled>상세·취소 기능 준비 중</button></div>
                </div></div>
            </div>
        </article>
        {{/history}}
        <div id="history-empty" class="card history-card text-center p-5 mb-4" hidden>
            <h3 class="h5 fw-bold">이 분류에 해당하는 행사가 없습니다.</h3>
            <p class="text-secondary mb-0">다른 분류를 선택해 확인해주세요.</p>
        </div>
        </div>
        <noscript><p class="text-secondary">분류 전환은 JavaScript를 활성화한 뒤 이용해주세요. 현재 전체 예시 내역을 표시합니다.</p></noscript>
        {{^history}}<nav aria-label="페이지 이동 준비 중" class="mt-4"><ul class="pagination justify-content-center"><li class="page-item disabled"><span class="page-link">이전</span></li><li class="page-item disabled"><span class="page-link">임시 화면</span></li><li class="page-item disabled"><span class="page-link">다음</span></li></ul></nav>
{{/history}}
        <!-- 참가 취소 안내 -->
        <div class="history-notice mt-5">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                참가 취소 안내
            </h6>

            <p class="small text-secondary mb-2">
                <i class="bi bi-check2 me-2"></i>
                취소 기능은 준비 중이며, 취소 가능 기간은 확정된 운영 정책에 따라 안내할 예정입니다.
            </p>

            <p class="small text-secondary mb-2">
                <i class="bi bi-check2 me-2"></i>
                승인 대기 또는 대기열 등록 상태에서도 운영 정책에 따라 취소할 수 있습니다.
            </p>

            <p class="small text-secondary mb-0">
                <i class="bi bi-check2 me-2"></i>
                포인트 충전·구매내역은 별도 포인트 관리 화면에서 안내합니다.
            </p>
        </div>

        <div class="text-end mt-4">
            <a href="/mypage"
               class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-left me-1"></i>
                마이페이지로 돌아가기
            </a>
        </div>

    </div>
    </div>
</main>

<script>
    (() => {
        const buttons = Array.from(document.querySelectorAll('[data-history-filter]'));
        const cards = Array.from(document.querySelectorAll('[data-history-group]'));
        const statusLabels = { HOLD: '처리 중', CONFIRMED: '신청 확정', PENDING_APPROVAL: '승인 대기', WAITING: '대기 중', CANCELLED: '취소됨' };
        cards.filter(card => card.dataset.historyGroup === 'ACTUAL').forEach(card => {
            const status = card.dataset.registrationStatus;
            const endsAt = Date.parse(card.dataset.sessionEndsAt);
            card.dataset.historyGroup = status === 'CANCELLED' || (Number.isFinite(endsAt) && endsAt <= Date.now())
                ? 'HISTORY' : status === 'WAITING' ? 'WAITING' : 'UPCOMING';
            const label = card.querySelector('[data-registration-label]');
            label.textContent = statusLabels[status] || '상태 확인 중';
            label.className = 'status-badge ' + ({CONFIRMED:'status-confirmed',PENDING_APPROVAL:'status-pending',WAITING:'status-waiting'}[status] || 'status-cancelled');
        });
        document.querySelectorAll('[data-history-time]').forEach(element => {
            const date = new Date(element.textContent.trim());
            if (!Number.isNaN(date.getTime())) element.textContent = new Intl.DateTimeFormat('ko-KR', {timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(date);
        });
        function selectFilter(button) {
            const filter = button.dataset.historyFilter;
            let count = 0;
            cards.forEach(card => {
                const visible = filter === 'ALL' || card.dataset.historyGroup === filter;
                card.hidden = !visible;
                if (visible) count++;
            });
            buttons.forEach(item => {
                item.classList.toggle('active', item === button);
                item.setAttribute('aria-pressed', String(item === button));
            });
            document.getElementById('history-filter-label').textContent = button.textContent.trim();
            document.getElementById('history-result-count').textContent = count;
            document.getElementById('history-empty').hidden = count !== 0 || !!document.querySelector('[data-history-no-records]');
        }
        buttons.forEach(button => button.addEventListener('click', () => selectFilter(button)));
        selectFilter(buttons[0]);
    })();
    // 포인트를 1,000P 형태로 표시
    document.querySelectorAll(".format-point").forEach(element => {
        const value = Number(element.textContent.trim());

        if (Number.isFinite(value)) {
            element.textContent = value.toLocaleString("ko-KR") + "P";
        }
    });
</script>

{{> layout/footer}}
</body></html>
