<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.application.ui0039}}</title>{{> layout/favorite-assets}}</head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> layout/personal-account-style}}
<main class="personal-account-page favorites-page">
    <div class="account-layout">
        {{> layout/account-nav}}
        <section class="account-content" data-favorites-page>
            <header class="account-heading"><div><p class="account-location">{{i18n.community.ui0018}}</p><h1>{{i18n.common.ui0018}}</h1><p class="account-description">{{i18n.application.ui0040}}</p></div><a class="account-button account-button--secondary" href="/events/list">{{i18n.event.ui0004}} <span aria-hidden="true">↗</span></a></header>
            <div class="account-result-line favorites-result"><span role="status">{{i18n.application.ui0041}} <strong data-favorite-total>{{favoriteTotal}}</strong>{{i18n.company.ui0046}}</span><span>{{i18n.application.ui0042}}</span></div>
            <div class="account-favorites-grid">
                {{#favorites}}{{#event}}
                <article class="favorite-item account-favorite-card" data-favorite-item>
                    <div class="favorite-card-heading"><span class="account-category">{{#categoryName}}{{categoryName}}{{/categoryName}}{{^categoryName}}{{i18n.company.ui0044}}{{/categoryName}}</span><span class="account-event-status" data-favorite-event-status>{{status}}</span></div>
                    <h2><a href="/event/{{id}}">{{title}}</a></h2>
                    <p class="favorite-card-summary">{{summary}}</p>
                    <a class="favorite-card-link" href="/event/{{id}}">{{i18n.application.ui0043}} <span aria-hidden="true">↗</span></a>
                    {{> layout/favorite-button}}
                </article>
                {{/event}}{{/favorites}}
            </div>
            <div class="account-empty favorites-empty" data-favorites-empty {{#hasFavorites}}hidden{{/hasFavorites}}><span class="account-empty-symbol" aria-hidden="true">♡</span><h2>{{i18n.application.ui0044}}</h2><p>{{i18n.application.ui0045}}</p><a class="account-button account-button--secondary" href="/events/list">{{i18n.event.ui0004}}</a></div>
            <noscript>{{i18n.application.ui0046}}</noscript>
        </section>
    </div>
</main>
{{> layout/footer}}
</body>
</html>
