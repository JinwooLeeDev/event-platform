<section class="account-balance-strip" aria-label="{{i18n.admin.ui0165}}">
    <div><span class="account-point-symbol" aria-hidden="true">P</span>
        <div><span class="account-caption">{{i18n.admin.ui0165}}</span><strong class="point-value format-point">{{myPoint}}</strong>
        </div>
    </div>
    <a class="account-text-link" href="/mypoint">{{i18n.common.ui0019}} <span aria-hidden="true">›</span></a>
</section>
{{#history}}
    <section class="history-summary" aria-label="{{i18n.application.ui0009}}">
        <div><span>{{i18n.community.ui0027}}</span><strong>{{confirmedCount}}<small>{{i18n.admin.ui0014}}</small></strong></div>
        <div><span>{{i18n.application.ui0010}}</span><strong>{{waitingCount}}<small>{{i18n.admin.ui0014}}</small></strong></div>
        <div><span>{{i18n.application.ui0011}}</span><strong>{{pastCount}}<small>{{i18n.admin.ui0014}}</small></strong></div>
    </section>
    <section class="account-panel history-filter" aria-label="{{i18n.application.ui0012}}">
        <nav class="history-tabs" aria-label="{{i18n.application.ui0013}}">
            {{#historyTabs}}
                <a class="nav-link {{#active}}active{{/active}}" href="{{url}}"
                   {{#active}}aria-current="page"{{/active}}>{{label}} <span>{{count}}</span></a>{{/historyTabs}}
        </nav>
        <form class="history-search" action="/myhistory" method="get" role="search" aria-label="{{i18n.application.ui0014}}">
            <input type="hidden" name="tab" value="{{currentTab}}">
            <label for="history-keyword" class="account-sr-only">{{i18n.application.ui0015}}</label>
            <input id="history-keyword" type="search" name="keyword" value="{{keyword}}" placeholder="{{i18n.application.ui0016}}">
            <button type="submit" class="account-button">{{i18n.admin.ui0148}}</button>
        </form>
    </section>
    <div class="account-result-line"><span
            role="status">{{i18n.application.ui0017}} <strong>{{resultCount}}</strong>{{i18n.admin.ui0014}}</span><span>{{i18n.application.ui0018}}</span></div>
    <div id="history-results" class="history-results">
        {{#items}}
            <article class="account-panel history-ticket">
                <div class="history-ticket-heading">
                    <div>{{#category}}<span class="account-category">{{category}}</span>{{/category}}<h2
                            class="event-title"><a href="{{detailUrl}}">{{title}}</a></h2>
                        <p class="history-session-name">{{sessionName}}</p></div>
                    <span class="status-badge {{statusClass}}">{{statusLabel}}</span></div>
                <dl class="history-event-facts">
                    <div>
                        <dt>{{i18n.application.ui0019}}</dt>
                        <dd>{{scheduleText}}</dd>
                    </div>
                    <div>
                        <dt>{{i18n.payment.ui0046}}</dt>
                        <dd>{{place}}</dd>
                    </div>{{#waiting}}
                    <div class="history-waiting">
                        <dt>{{i18n.application.ui0020}}</dt>
                        <dd>{{waitingRank}}{{i18n.application.ui0021}}</dd>
                    </div>{{/waiting}}</dl>
                <p class="status-note">{{statusMessage}}</p>
                {{#attendanceText}}<p class="status-note history-attended" role="status">✔ {{attendanceText}}</p>{{/attendanceText}}
                <details class="history-payment-details">
                    <summary>{{i18n.application.ui0022}}</summary>
                    <ol class="history-change-list" aria-label="{{i18n.application.ui0023}}">
                        {{#changeHistory}}<li><strong>{{statusLabel}}</strong><time>{{occurredAtText}}</time>{{#reason}}<p>{{reason}}</p>{{/reason}}</li>{{/changeHistory}}
                    </ol>
                    {{^changeHistory}}<p class="account-description">{{i18n.application.ui0024}}</p>{{/changeHistory}}
                </details>
                {{! ★ [f/41] 취소·환불 카드(closed)는 결제·환불 정보를 펼쳐서 표시 }}
                <details class="history-payment-details" {{#closed}}open{{/closed}}>
                    <summary>{{i18n.application.ui0025}}</summary>
                    <dl>{{#purchasedAtText}}
                        <div>
                            <dt>{{i18n.application.ui0026}}</dt>
                            <dd>{{purchasedAtText}}</dd>
                        </div>{{/purchasedAtText}}
                        <div>
                            <dt>{{i18n.application.ui0027}}</dt>
                            <dd>{{paidPointText}}</dd>
                        </div>{{#expectedRefundText}}
                            <div>
                                <dt>{{i18n.application.ui0028}}</dt>
                                <dd>{{expectedRefundText}}</dd>
                            </div>{{/expectedRefundText}}{{#refundText}}
                            <div>
                                <dt>{{i18n.company.ui0106}}</dt>
                                <dd>{{refundText}}</dd>
                            </div>{{/refundText}}</dl>
                </details>
                {{! ★ [f/41] 취소·환불 카드(closed)는 '취소 불가' 버튼 숨김 }}
                <div class="history-ticket-bottom">
                    <div><span class="account-caption">{{i18n.application.ui0027}}</span><strong
                            class="history-paid-point">{{paidPointText}}</strong></div>
                    <div class="event-actions">{{#reviewUrl}}<a class="btn btn-primary" href="{{reviewUrl}}">{{i18n.application.ui0029}}</a>{{/reviewUrl}}{{#communityUrl}}
                        <a class="btn btn-primary" href="{{communityUrl}}">{{i18n.common.extra022}}</a>{{/communityUrl}}
                        <a class="btn btn-primary" href="{{detailUrl}}">{{i18n.event.ui0001}}</a>{{#cancelable}}
                            <button class="btn btn-outline-danger reg-cancel-btn" type="button"
                                    data-cancel-url="{{cancelUrl}}" data-confirm="{{cancelConfirmText}}"
                                    data-refund-policy="{{refundPolicyText}}">{{i18n.application.ui0007}}
                            </button>{{/cancelable}}{{^cancelable}}{{^closed}}{{^attended}}
                            <button class="btn btn-outline-secondary" type="button" disabled>{{i18n.application.ui0030}}
                            </button>{{/attended}}{{/closed}}{{/cancelable}}</div>
                </div>
            </article>
        {{/items}}
        {{#empty}}
            <div class="account-empty"><span class="account-empty-symbol" aria-hidden="true">▦</span>
                <h2>{{i18n.application.ui0031}}</h2>
                <p>{{i18n.application.ui0032}}</p><a href="/myhistory" class="account-button account-button--secondary">{{i18n.application.ui0033}}</a></div>{{/empty}}
    </div>
{{/history}}
<details class="account-guide">
    <summary>{{i18n.application.ui0034}}</summary>
    <ul>
        <li>{{i18n.application.ui0035}}</li>
        <li>{{i18n.application.ui0036}}</li>
        <li>{{i18n.application.ui0037}}</li>
        <li>{{i18n.application.ui0038}}</li>
    </ul>
</details>
