<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0200}} <span class="admin-badge">{{totalCount}}{{i18n.admin.ui0014}}</span></h2></div>
    <form action="/admin/sessions" method="get" class="admin-member-search">
        <label for="session-status">{{i18n.admin.ui0201}}</label>
        <select id="session-status" name="status"><option value="">{{i18n.admin.ui0144}}</option>{{#statusOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statusOptions}}</select>
        <button type="submit">{{i18n.admin.ui0078}}</button>
    </form>
    <div class="admin-table-wrap"><table class="admin-table">
        <caption class="admin-sr-only">{{i18n.admin.ui0202}}</caption>
        <thead><tr><th scope="col">{{i18n.admin.ui0203}}</th><th scope="col">{{i18n.admin.ui0082}}</th><th scope="col">{{i18n.admin.ui0065}}</th><th scope="col">{{i18n.admin.ui0099}}</th><th scope="col">{{i18n.admin.ui0204}}</th><th scope="col">{{i18n.admin.ui0101}}</th><th scope="col">{{i18n.admin.ui0205}}</th></tr></thead>
        <tbody>
        {{#sessions}}
        <tr>
            <td><a href="/admin/events/{{event.id}}">{{event.title}}</a><br>{{session.name}}</td>
            <td>{{event.company.name}}</td>
            <td><span data-session-date>{{session.startsAt}}</span><br>~ <span data-session-date>{{session.endsAt}}</span></td>
            <td><span data-session-date>{{session.applyStartAt}}</span><br>~ <span data-session-date>{{session.applyEndAt}}</span></td>
            <td>{{session.capacityLabel}} · {{session.occupiedCount}}{{i18n.admin.ui0206}}</td>
            <td data-session-point>{{session.fee}}</td>
            <td><span class="admin-badge" data-session-status>{{session.status}}</span></td>
        </tr>
        {{/sessions}}
        {{^sessions}}<tr><td colspan="7" class="admin-member-empty">{{i18n.admin.ui0207}}</td></tr>{{/sessions}}
        </tbody>
    </table></div>
    <nav class="admin-pagination" aria-label="{{i18n.admin.ui0208}}">
        {{#hasPrevious}}<a href="/admin/sessions?page={{previousPage}}&amp;status={{statusValue}}">{{i18n.admin.ui0159}}</a>{{/hasPrevious}}
        <span>{{currentPage}} / {{totalPages}}</span>
        {{#hasNext}}<a href="/admin/sessions?page={{nextPage}}&amp;status={{statusValue}}">{{i18n.admin.ui0161}}</a>{{/hasNext}}
    </nav>
</section>
<script src="/js/company-session.js" defer></script>
