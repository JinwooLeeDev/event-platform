<div data-admin-cancel-browser>
{{#reviewSuccess}}<p class="admin-company-warning" role="status">{{reviewSuccess}}</p>{{/reviewSuccess}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>회차 취소 신청 내역</h2></div>
    <nav class="admin-status-links" aria-label="취소 신청 상태별 조회">{{#cancelStatusOptions}}<a href="/admin/event-cancels?status={{value}}" data-cancel-status="{{value}}" {{#selected}}aria-current="page"{{/selected}}>{{label}}</a>{{/cancelStatusOptions}}</nav>
    <p class="admin-company-note">신청일이 오래된 순서로 표시합니다. 승인 시 해당 회차 취소와 환불 처리가 진행됩니다. 거절하면 회차는 기존 상태를 유지합니다.</p>
</section>
<p class="admin-company-note" data-cancel-loading role="status" hidden>취소 신청 내역을 불러오는 중입니다.</p>
<div class="cancel-load-error" data-cancel-load-error role="alert" hidden><p data-cancel-error-message></p><button class="admin-status-button" type="button" data-cancel-retry>다시 불러오기</button></div>
<div data-admin-cancel-list aria-busy="false">
{{#cancelRequests}}
<article class="admin-panel admin-history cancel-request-row">
    {{#request}}
    <div class="admin-panel-heading"><h2>{{eventSession.event.title}} · {{eventSession.name}}</h2><span class="admin-badge">{{statusLabel}}</span></div>
    <div class="cancel-request-body">
    <dl class="cancel-context"><div><dt>신청 기업</dt><dd>{{eventSession.event.company.name}}</dd></div><div><dt>신청 일시</dt><dd>{{createdAt}}</dd></div><div><dt>개최 일정</dt><dd>{{eventSession.startsAt}}<br>~ {{eventSession.endsAt}}</dd></div><div><dt>현재 점유 인원</dt><dd>{{eventSession.occupiedCount}}명</dd></div></dl>
    <section class="cancel-request-reason" aria-label="취소 신청 사유"><h3>취소 신청 사유</h3><p class="cancel-reason">{{reason}}</p></section>
    <div class="cancel-actions">
        <a class="admin-status-button cancel-detail-link" href="/admin/events/{{eventSession.event.id}}">행사 정보 확인</a>
        {{#pending}}
        <form action="/admin/event-cancels/{{id}}/approve" method="post" data-admin-confirm="회차 취소 승인" data-admin-target="{{eventSession.name}}" data-admin-danger="true"><button type="submit" class="admin-status-button admin-status-button-danger">취소 승인</button></form>
        <form action="/admin/event-cancels/{{id}}/reject" method="post" data-admin-confirm="취소 신청 거절" data-admin-target="{{eventSession.name}}"><button type="submit" class="admin-status-button">신청 거절</button></form>
        {{/pending}}
        {{^pending}}<p class="admin-company-note">처리된 신청입니다.</p>{{/pending}}
    </div>
    </div>
    {{/request}}
</article>
{{/cancelRequests}}
{{^cancelRequests}}<section class="admin-panel"><div class="admin-empty"><h2>이 상태의 취소 신청이 없습니다.</h2><p>다른 상태를 선택하거나 새로운 신청이 접수되면 확인해주세요.</p></div></section>{{/cancelRequests}}
</div>
</div>
