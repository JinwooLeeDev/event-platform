<div data-admin-cancel-browser>
{{#reviewSuccess}}<p class="admin-company-warning" role="status">{{reviewSuccess}}</p>{{/reviewSuccess}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0058}}</h2></div>
    <nav class="admin-status-links" aria-label="{{i18n.admin.ui0059}}">{{#cancelStatusOptions}}<a href="/admin/event-cancels?status={{value}}" data-cancel-status="{{value}}" {{#selected}}aria-current="page"{{/selected}}>{{label}}</a>{{/cancelStatusOptions}}</nav>
    <p class="admin-company-note">{{i18n.admin.ui0060}}</p>
</section>
<p class="admin-company-note" data-cancel-loading role="status" hidden>{{i18n.admin.ui0061}}</p>
<div class="cancel-load-error" data-cancel-load-error role="alert" hidden><p data-cancel-error-message></p><button class="admin-status-button" type="button" data-cancel-retry>{{i18n.admin.ui0062}}</button></div>
<div data-admin-cancel-list aria-busy="false">
{{#cancelRequests}}
<article class="admin-panel admin-history cancel-request-row">
    {{#request}}
    <div class="admin-panel-heading"><h2>{{eventSession.event.title}} · {{eventSession.name}}</h2><span class="admin-badge">{{statusLabel}}</span></div>
    <div class="cancel-request-body">
    <dl class="cancel-context"><div><dt>{{i18n.admin.ui0063}}</dt><dd>{{eventSession.event.company.name}}</dd></div><div><dt>{{i18n.admin.ui0064}}</dt><dd>{{createdAt}}</dd></div><div><dt>{{i18n.admin.ui0065}}</dt><dd>{{eventSession.startsAt}}<br>~ {{eventSession.endsAt}}</dd></div><div><dt>{{i18n.admin.ui0066}}</dt><dd>{{eventSession.occupiedCount}}{{i18n.admin.ui0067}}</dd></div></dl>
    <section class="cancel-request-reason" aria-label="{{i18n.admin.ui0068}}"><h3>{{i18n.admin.ui0068}}</h3><p class="cancel-reason">{{reason}}</p></section>
    <div class="cancel-actions">
        <a class="admin-status-button cancel-detail-link" href="/admin/events/{{eventSession.event.id}}">{{i18n.admin.ui0069}}</a>
        {{#pending}}
        <form action="/admin/event-cancels/{{id}}/approve" method="post" data-admin-confirm="{{i18n.admin.action.approveSessionCancellation}}" data-admin-target="{{eventSession.name}}" data-admin-danger="true"><button type="submit" class="admin-status-button admin-status-button-danger">{{i18n.admin.ui0070}}</button></form>
        <form action="/admin/event-cancels/{{id}}/reject" method="post" data-admin-confirm="{{i18n.admin.action.rejectCancellation}}" data-admin-target="{{eventSession.name}}"><button type="submit" class="admin-status-button">{{i18n.admin.ui0071}}</button></form>
        {{/pending}}
        {{^pending}}<p class="admin-company-note">{{i18n.admin.ui0072}}</p>{{/pending}}
    </div>
    </div>
    {{/request}}
</article>
{{/cancelRequests}}
{{^cancelRequests}}<section class="admin-panel"><div class="admin-empty"><h2>{{i18n.admin.ui0073}}</h2><p>{{i18n.admin.ui0074}}</p></div></section>{{/cancelRequests}}
</div>
</div>
