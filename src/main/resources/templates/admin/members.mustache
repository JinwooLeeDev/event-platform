{{#memberListPage}}
{{#memberPage}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0140}} <span class="admin-badge">{{totalElements}}{{i18n.admin.ui0067}}</span></h2></div>
    <form class="admin-member-search" action="/admin/members" method="get">
        <label for="member-keyword">{{i18n.admin.ui0141}}</label>
        <input id="member-keyword" name="keyword" type="search" value="{{keyword}}" placeholder="{{i18n.admin.ui0142}}">
        <label for="member-status">{{i18n.admin.ui0143}}</label>
        <select id="member-status" name="status">
            <option value="" {{#allSelected}}selected{{/allSelected}}>{{i18n.admin.ui0144}}</option>
            <option value="ACTIVE" {{#activeSelected}}selected{{/activeSelected}}>{{i18n.admin.ui0145}}</option>
            <option value="SUSPENDED" {{#suspendedSelected}}selected{{/suspendedSelected}}>{{i18n.admin.ui0146}}</option>
            <option value="WITHDRAWN" {{#withdrawnSelected}}selected{{/withdrawnSelected}}>{{i18n.admin.ui0147}}</option>
        </select>
        <button type="submit">{{i18n.admin.ui0148}}</button><a href="/admin/members">{{i18n.admin.ui0149}}</a>
    </form>
    <div class="admin-table-wrap"><table class="admin-table">
        <caption class="admin-sr-only">{{i18n.admin.ui0150}}</caption>
        <thead><tr><th scope="col">{{i18n.admin.ui0007}}</th><th scope="col">{{i18n.admin.ui0151}}</th><th scope="col">{{i18n.admin.ui0033}}</th><th scope="col">{{i18n.admin.ui0152}}</th><th scope="col">{{i18n.admin.ui0153}}</th><th scope="col">{{i18n.admin.ui0154}}</th><th scope="col">{{i18n.admin.ui0155}}</th></tr></thead>
        <tbody>
        {{#members}}
        <tr>
            <td>{{id}}</td><td>{{displayName}}</td><td>{{email}}</td><td>{{roleName}}</td>
            <td><span class="admin-badge {{#canSuspend}}admin-status-active{{/canSuspend}}{{#canActivate}}admin-status-suspended{{/canActivate}}">{{statusName}}</span></td>
            <td>{{createdAt}}</td>
            <td><div class="admin-member-actions"><a href="/admin/members/{{id}}" aria-label="{{i18n.admin.ui0231}}: {{displayName}}">{{i18n.admin.ui0156}}</a>{{> admin/member-status-actions}}</div></td>
        </tr>
        {{/members}}
        {{^members}}<tr><td colspan="7" class="admin-member-empty">{{i18n.admin.ui0157}}</td></tr>{{/members}}
        </tbody>
    </table></div>
    <nav class="admin-pagination" aria-label="{{i18n.admin.ui0158}}">
        {{#previousUrl}}<a href="{{previousUrl}}">{{i18n.admin.ui0159}}</a>{{/previousUrl}}
        <span>{{currentPage}} / {{totalPages}} {{i18n.admin.ui0160}}</span>
        {{#nextUrl}}<a href="{{nextUrl}}">{{i18n.admin.ui0161}}</a>{{/nextUrl}}
    </nav>
</section>
{{/memberPage}}
{{/memberListPage}}
{{#memberDetailPage}}
{{#member}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0162}}</h2><a href="/admin/members">{{i18n.admin.ui0163}}</a></div>
    <dl class="admin-member-facts">
        <div><dt>{{i18n.admin.ui0164}}</dt><dd>{{id}}</dd></div>
        <div><dt>{{i18n.admin.ui0151}}</dt><dd>{{displayName}}</dd></div>
        <div><dt>{{i18n.admin.ui0033}}</dt><dd>{{email}}</dd></div>
        <div><dt>{{i18n.admin.ui0152}}</dt><dd>{{roleName}}</dd></div>
        <div><dt>{{i18n.admin.ui0143}}</dt><dd><span class="admin-badge {{#canSuspend}}admin-status-active{{/canSuspend}}{{#canActivate}}admin-status-suspended{{/canActivate}}">{{statusName}}</span></dd></div>
        <div><dt>{{i18n.admin.ui0165}}</dt><dd>{{point}} P</dd></div>
        <div><dt>{{i18n.admin.ui0166}}</dt><dd>{{preferredLocale}}</dd></div>
        <div><dt>{{i18n.admin.ui0154}}</dt><dd>{{createdAt}}</dd></div>
        <div><dt>{{i18n.admin.ui0167}}</dt><dd>{{emailVerifiedAt}}</dd></div>
        <div><dt>{{i18n.admin.ui0168}}</dt><dd>{{withdrawnAt}}</dd></div>
    </dl>
    <div class="admin-member-status-panel">
        <div><h3>{{i18n.admin.ui0169}}</h3><p>{{i18n.admin.ui0170}}</p></div>
        <div class="admin-member-actions">{{> admin/member-status-actions}}</div>
    </div>
</section>
{{/member}}
{{/memberDetailPage}}
