{{#canSuspend}}
<form class="admin-status-form" action="/admin/members/{{id}}/status" method="post" data-admin-confirm="{{i18n.admin.ui0137}}" data-admin-target="{{displayName}}" data-admin-danger="true">
    <input type="hidden" name="status" value="SUSPENDED">
    <button class="admin-status-button admin-status-button-danger" type="submit" aria-label="{{i18n.admin.ui0137}}: {{displayName}}">{{i18n.admin.ui0137}}</button>
</form>
{{/canSuspend}}
{{#canActivate}}
<form class="admin-status-form" action="/admin/members/{{id}}/status" method="post" data-admin-confirm="{{i18n.admin.ui0138}}" data-admin-target="{{displayName}}">
    <input type="hidden" name="status" value="ACTIVE">
    <button class="admin-status-button admin-status-button-activate" type="submit" aria-label="{{i18n.admin.ui0138}}: {{displayName}}">{{i18n.admin.ui0138}}</button>
</form>
{{/canActivate}}
{{^canSuspend}}{{^canActivate}}<span class="admin-status-locked">{{i18n.admin.ui0139}}</span>{{/canActivate}}{{/canSuspend}}
