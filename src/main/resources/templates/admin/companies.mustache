{{#companyListPage}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0013}} <span class="admin-badge">{{companyCount}}{{i18n.admin.ui0014}}</span></h2></div>
    <p class="admin-company-note">{{i18n.admin.ui0015}}</p>
    <div class="admin-list-tools"><label for="admin-company-find">{{i18n.admin.ui0016}}</label><input id="admin-company-find" type="search" placeholder="{{i18n.admin.ui0017}}" data-admin-filter="#admin-company-rows" data-admin-count="#admin-company-visible"><span id="admin-company-visible" role="status">{{companyCount}}{{i18n.admin.ui0014}}</span></div>
    <div class="admin-table-wrap"><table class="admin-table">
        <caption class="admin-sr-only">{{i18n.admin.ui0018}}</caption>
        <thead><tr><th scope="col">{{i18n.admin.ui0007}}</th><th scope="col">{{i18n.admin.ui0019}}</th><th scope="col">{{i18n.admin.ui0020}}</th><th scope="col">{{i18n.admin.ui0021}}</th><th scope="col">{{i18n.admin.ui0022}}</th><th scope="col">{{i18n.admin.ui0023}}</th></tr></thead>
        <tbody id="admin-company-rows">
            {{#companies}}<tr data-admin-row><td>{{id}}</td><td><a class="admin-record-title" href="/admin/companies/{{id}}">{{name}}</a></td><td>{{businessNumber}}</td><td><span class="admin-badge">{{statusLabel}}</span></td><td><span class="admin-badge">{{verificationLabel}}</span></td><td><a class="admin-row-action" href="/admin/companies/{{id}}">{{i18n.admin.ui0024}}</a></td></tr>{{/companies}}
            {{^companies}}<tr><td colspan="6" class="admin-member-empty">{{i18n.admin.ui0025}}</td></tr>{{/companies}}
            <tr data-admin-filter-empty hidden><td colspan="6" class="admin-member-empty">{{i18n.admin.ui0026}}</td></tr>
        </tbody>
    </table></div>
</section>
{{/companyListPage}}
{{#companyDetailPage}}
{{#company}}
<nav class="admin-context-nav" aria-label="{{i18n.admin.ui0027}}"><a href="#admin-company-information">{{i18n.admin.ui0028}}</a><a href="#admin-company-history">{{i18n.admin.ui0029}}</a><a href="#admin-company-decision">{{i18n.admin.ui0030}}</a></nav>
<div class="admin-review-layout"><div class="admin-review-content">
<section class="admin-panel" id="admin-company-information">
    <div class="admin-panel-heading"><h2>{{name}}</h2><a href="/admin/companies">{{i18n.admin.ui0031}}</a></div>
    <dl class="admin-member-facts">
        <div><dt>{{i18n.admin.ui0032}}</dt><dd>{{id}}</dd></div>
        <div><dt>{{i18n.admin.ui0019}}</dt><dd>{{name}}</dd></div>
        <div><dt>{{i18n.admin.ui0033}}</dt><dd>{{email}}</dd></div>
        <div><dt>{{i18n.admin.ui0020}}</dt><dd>{{businessNumber}}</dd></div>
        <div><dt>{{i18n.admin.ui0034}}</dt><dd>{{representativeName}}</dd></div>
        <div><dt>{{i18n.admin.ui0035}}</dt><dd>{{#openedOn}}{{openedOn}}{{/openedOn}}{{^openedOn}}{{i18n.admin.ui0036}}{{/openedOn}}</dd></div>
        <div><dt>{{i18n.admin.ui0037}}</dt><dd>{{address}}</dd></div>
        <div><dt>{{i18n.admin.ui0038}}</dt><dd>{{contactPersonName}}</dd></div>
        <div><dt>{{i18n.admin.ui0039}}</dt><dd>{{contactPersonPhone}}</dd></div>
        <div><dt>{{i18n.admin.ui0021}}</dt><dd><span class="admin-badge">{{companyStatusLabel}}</span></dd></div>
        <div><dt>{{i18n.admin.ui0022}}</dt><dd>{{companyVerificationLabel}}</dd></div>
        <div><dt>{{i18n.admin.ui0040}}</dt><dd><a class="admin-company-certificate" href="/admin/companies/{{id}}/certificate" target="_blank" rel="noopener">{{i18n.admin.ui0041}}<span class="admin-sr-only"> {{i18n.admin.ui0042}}</span></a></dd></div>
        {{#reviewFeedback}}<div><dt>{{i18n.admin.ui0043}}</dt><dd class="admin-company-feedback">{{reviewFeedback}}</dd></div>{{/reviewFeedback}}
    </dl>
</section>
<section class="admin-panel" id="admin-company-history" aria-labelledby="admin-company-history-title">
    <div class="admin-panel-heading"><h2 id="admin-company-history-title">{{i18n.admin.ui0029}}</h2><span class="admin-badge">{{i18n.admin.ui0044}}</span></div>
    <p class="admin-company-note">{{i18n.admin.ui0045}}</p>
    <ol class="admin-review-history">
        {{#reviewHistoryRows}}<li><strong>{{fromLabel}} → {{toLabel}}</strong><p><time>{{createdAtText}}</time> {{i18n.admin.ui0046}} {{reviewerName}}</p>{{#hasFeedback}}<p class="admin-company-feedback">{{feedback}}</p>{{/hasFeedback}}</li>{{/reviewHistoryRows}}
    </ol>
    {{^reviewHistoryRows}}<p class="admin-company-note">{{i18n.admin.ui0047}}</p>{{/reviewHistoryRows}}
</section>
</div><aside class="admin-review-actions" aria-label="{{i18n.admin.ui0048}}">
<section class="admin-panel" id="admin-company-decision">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0049}}</h2></div>
    {{#reviewable}}
    <div class="admin-company-review">
        {{#verificationError}}<p class="admin-company-warning" role="status">{{i18n.admin.ui0050}}</p>{{/verificationError}}
        {{#approvable}}<form action="/admin/companies/{{id}}/approve" method="post" class="admin-company-approve" data-admin-confirm="{{i18n.admin.ui0052}}" data-admin-target="{{name}}"><p>{{i18n.admin.ui0051}}</p><button class="admin-status-button admin-status-button-activate" type="submit">{{i18n.admin.ui0052}}</button></form>{{/approvable}}
        <form action="/admin/companies/{{id}}/correction" method="post" class="admin-company-correction" data-admin-confirm="{{i18n.admin.action.requestCompanyCorrection}}" data-admin-target="{{name}}">
            <label for="company-feedback">{{i18n.admin.ui0053}}</label>
            <p id="company-feedback-help">{{i18n.admin.ui0054}}</p>
            <textarea id="company-feedback" name="feedback" rows="5" maxlength="2000" required aria-describedby="company-feedback-help" placeholder="{{i18n.admin.ui0055}}"></textarea>
            <button class="admin-status-button admin-status-button-danger" type="submit">{{i18n.admin.ui0056}}</button>
        </form>
    </div>
    {{/reviewable}}
    {{^reviewable}}<p class="admin-company-note">{{i18n.admin.ui0057}}</p>{{/reviewable}}
</section>
</aside></div>
{{/company}}
{{/companyDetailPage}}
