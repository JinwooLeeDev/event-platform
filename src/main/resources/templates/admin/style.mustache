<style>
    .bp-admin {
        --bp-blue: #0750d8;
        --bp-text: #1a2340;
        --bp-muted: #6a7b95;
        --bp-border: #dce6f5;
        --bp-soft: #edf4ff;

        background: linear-gradient(#f7faff, #ffffff);
        color: var(--bp-text);
        font-family: Pretendard, sans-serif;
        padding: 36px 24px 64px;
        min-height: 65vh;
    }

    .bp-admin *,
    .bp-admin *::before,
    .bp-admin *::after {
        box-sizing: border-box;
    }

    .bp-admin [hidden] {
        display: none !important;
    }

    .bp-admin .bp-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .bp-admin .bp-back {
        display: inline-block;
        margin-bottom: 24px;
        color: var(--bp-muted);
        font-size: 14px;
        text-decoration: none;
    }

    .bp-admin .bp-back:hover {
        color: var(--bp-blue);
    }

    .bp-admin .bp-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .bp-admin .bp-eyebrow {
        margin: 0 0 8px;
        color: var(--bp-blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .bp-admin h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -1px;
        overflow-wrap: anywhere;
    }

    .bp-admin .bp-description {
        margin: 10px 0 0;
        color: var(--bp-muted);
        font-size: 14px;
        line-height: 1.7;
    }

    .bp-admin .bp-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .bp-admin .bp-information {
        display: grid;
        gap: 20px;
        min-width: 0;
    }

    .bp-admin .bp-panel {
        min-width: 0;
        padding: 28px;
        background: #fff;
        border: 1px solid var(--bp-border);
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(20, 40, 95, .03);
    }

    .bp-admin h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }

    .bp-admin .bp-panel-title {
        padding-bottom: 18px;
        border-bottom: 1px solid var(--bp-border);
    }

    .bp-admin .bp-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 20px;
        margin: 24px 0 0;
    }

    .bp-admin .bp-info-grid .bp-wide {
        grid-column: 1 / -1;
    }

    .bp-admin dt {
        margin-bottom: 8px;
        color: var(--bp-muted);
        font-size: 13px;
    }

    .bp-admin dd {
        margin: 0;
        font-size: 15px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .bp-admin .bp-badge {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 7px 13px;
        border-radius: 30px;
        background: #f0f2f6;
        color: #5c687c;
        font-size: 13px;
        font-weight: 600;
    }

    .bp-admin .bp-badge[data-status="PENDING"] {
        background: #fff4dd;
        color: #95610a;
    }

    .bp-admin .bp-badge[data-status="APPROVED"] {
        background: #eaf7ef;
        color: #087443;
    }

    .bp-admin .bp-badge[data-status="FEEDBACK_NEEDED"],
    .bp-admin .bp-badge[data-status="REJECTED"] {
        background: #fff0ed;
        color: #b42318;
    }

    .bp-admin .bp-document {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 22px;
    }

    .bp-admin .bp-document strong {
        font-size: 14px;
    }

    .bp-admin .bp-hint {
        margin: 8px 0 0;
        color: var(--bp-muted);
        font-size: 12px;
        line-height: 1.7;
    }

    .bp-admin .bp-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 11px 18px;
        border: 1px solid var(--bp-border);
        border-radius: 10px;
        background: #fff;
        color: var(--bp-text);
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .bp-admin .bp-button:hover {
        background: #f5f8fd;
    }

    .bp-admin .bp-button-primary {
        background: var(--bp-blue);
        border-color: var(--bp-blue);
        color: #fff;
    }

    .bp-admin .bp-button-primary:hover {
        background: #003ba8;
    }

    .bp-admin .bp-button-secondary {
        background: var(--bp-soft);
        color: var(--bp-blue);
        border-color: #c3d7f8;
    }

    .bp-admin .bp-button:disabled {
        opacity: .55;
        cursor: default;
    }

    .bp-admin .bp-button-full {
        width: 100%;
    }

    .bp-admin .bp-actions {
        display: grid;
        gap: 12px;
        margin-top: 22px;
    }

    .bp-admin .bp-actions form {
        margin: 0;
    }

    .bp-admin .bp-verification {
        margin-top: 22px;
        padding: 16px;
        border-radius: 12px;
        background: #f2f5fa;
        font-size: 14px;
    }

    .bp-admin .bp-verification[data-verification="MATCHED"] {
        background: #eaf7ef;
        color: #087443;
    }

    .bp-admin .bp-verification[data-verification="ERROR"] {
        background: #fff4dd;
        color: #95610a;
    }

    .bp-admin .bp-verification[data-verification="MISMATCHED"] {
        background: #fff0ed;
        color: #b42318;
    }

    .bp-admin .bp-verification p {
        margin: 8px 0 0;
        font-size: 12px;
        line-height: 1.7;
    }

    .bp-admin .bp-feedback {
        margin-top: 20px;
        padding: 16px;
        border: 1px solid #f3c4bc;
        border-radius: 12px;
        background: #fff5f2;
        color: #98372b;
        font-size: 14px;
    }

    .bp-admin .bp-feedback p {
        margin: 8px 0 0;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* 브라우저 기본 dialog: 배경 접근과 포커스를 자동으로 관리 */
    .bp-admin .bp-dialog {
        width: min(500px, calc(100% - 32px));
        max-height: calc(100dvh - 48px);
        margin: auto;
        padding: 28px;
        overflow-y: auto;
        border: 1px solid var(--bp-border);
        border-radius: 20px;
        background: #fff;
        color: var(--bp-text);
        box-shadow: 0 24px 80px rgba(20, 40, 95, .2);
        font-family: inherit;
    }

    .bp-admin .bp-dialog::backdrop {
        background: rgba(18, 33, 59, .4);
    }

    .bp-admin .bp-dialog-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .bp-admin .bp-close {
        min-width: 36px;
        min-height: 36px;
        padding: 4px;
        border: 1px solid var(--bp-border);
        border-radius: 9px;
        background: #fff;
        color: var(--bp-muted);
        font-size: 24px;
        cursor: pointer;
    }

    .bp-admin .bp-field {
        margin-top: 22px;
    }

    .bp-admin .bp-field label {
        display: block;
        margin-bottom: 9px;
        font-size: 14px;
        font-weight: 600;
    }

    .bp-admin textarea {
        display: block;
        width: 100%;
        min-height: 160px;
        padding: 12px;
        resize: vertical;
        border: 1px solid #cbd8ec;
        border-radius: 10px;
        background: #fff;
        color: var(--bp-text);
        font: inherit;
        font-size: 14px;
        line-height: 1.7;
    }

    .bp-admin .bp-modal-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    .bp-admin .bp-error {
        margin: 12px 0 0;
        color: #b42318;
        font-size: 13px;
    }

    .bp-admin :is(button, a, textarea):focus-visible {
        outline: 3px solid #9cbfff;
        outline-offset: 3px;
    }

    @media (max-width: 800px) {
        .bp-admin .bp-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 480px) {
        .bp-admin {
            padding: 28px 16px 44px;
        }

        .bp-admin .bp-panel,
        .bp-admin .bp-dialog {
            padding: 22px 18px;
        }

        .bp-admin h1 {
            font-size: 25px;
        }

        .bp-admin .bp-info-grid {
            grid-template-columns: 1fr;
        }

        .bp-admin .bp-heading {
            align-items: flex-start;
        }

        .bp-admin .bp-modal-actions .bp-button {
            flex: 1;
        }
    }
</style>