<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>
    {{> layout/head-meta}}
    <title>{{pageTitle}} {{i18n.admin.ui0171}}</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/event-cancel.css">
</head>
<body class="admin-body">
<a class="admin-skip" href="#admin-main">{{i18n.admin.ui0172}}</a>
<div class="admin-shell">
    {{> admin/layout/sidebar}}
    <div class="admin-workspace">
        {{> admin/layout/header}}
        <main id="admin-main" class="admin-main">
            <div class="admin-page-heading"><h1>{{pageTitle}}</h1><p>{{pageDescription}}</p></div>
            {{#dashboardPage}}
                <div class="admin-section-heading"><h2>{{i18n.admin.ui0173}}</h2><p>{{i18n.admin.ui0174}}</p></div>
                <section class="admin-metrics" aria-label="{{i18n.admin.ui0175}}">
                    <a class="admin-card" href="/admin/companies"><span>{{i18n.admin.ui0176}}</span><strong>{{companyReviewCount}}</strong><small>{{i18n.admin.ui0177}}</small></a>
                    <a class="admin-card" href="/admin/events"><span>{{i18n.admin.ui0178}}</span><strong>{{eventReviewCount}}</strong><small>{{i18n.admin.ui0179}}</small></a>
                    <a class="admin-card" href="/admin/events?status=PAID_READY"><span>{{i18n.admin.ui0180}}</span><strong>{{eventPaymentCount}}</strong><small>{{i18n.admin.ui0181}}</small></a>
                    <a class="admin-card" href="/admin/events?status=FEEDBACK_REQUIRED"><span>{{i18n.admin.ui0182}}</span><strong>{{eventFeedbackCount}}</strong><small>{{i18n.admin.ui0183}}</small></a>
                </section>
                <div class="admin-panels">
                    <section class="admin-panel">
                        <div class="admin-panel-heading"><h2>{{i18n.admin.ui0013}}</h2><a href="/admin/companies">{{i18n.admin.ui0184}}</a></div>
                        {{#companyReviewItems}}<div class="admin-dashboard-company"><div><a href="/admin/companies/{{id}}">{{name}}</a><span>{{businessNumber}}</span></div><span class="admin-badge">{{verificationLabel}}</span><a href="/admin/companies/{{id}}" class="admin-dashboard-review">{{i18n.admin.ui0185}}</a></div>{{/companyReviewItems}}
                        {{^companyReviewItems}}<div class="admin-empty"><span class="admin-empty-icon" aria-hidden="true">✓</span><h3>{{i18n.admin.ui0186}}</h3><p>{{i18n.admin.ui0187}}</p></div>{{/companyReviewItems}}
                        <p class="admin-company-note">{{i18n.admin.ui0188}}</p>
                    </section>
                    <section class="admin-panel"><div class="admin-panel-heading"><h2>{{i18n.admin.ui0189}}</h2></div><div class="admin-task-links"><a href="/admin/events"><span><strong>{{i18n.admin.ui0190}}</strong><small>{{i18n.admin.ui0191}}</small></span><span aria-hidden="true">›</span></a><a href="/admin/sessions"><span><strong>{{i18n.admin.ui0131}}</strong><small>{{i18n.admin.ui0192}}</small></span><span aria-hidden="true">›</span></a><a href="/admin/members"><span><strong>{{i18n.admin.ui0132}}</strong><small>{{i18n.admin.ui0193}}</small></span><span aria-hidden="true">›</span></a><a href="/admin/categories"><span><strong>{{i18n.admin.ui0133}}</strong><small>{{i18n.admin.ui0194}}</small></span><span aria-hidden="true">›</span></a></div></section>
                </div>
            {{/dashboardPage}}
            {{^dashboardPage}}
                {{#cancelsPage}}{{> admin/event-cancels}}{{/cancelsPage}}
                {{#membersPage}}{{> admin/members}}{{/membersPage}}
                {{#companiesPage}}{{> admin/companies}}{{/companiesPage}}
                {{#eventsPage}}{{> admin/events}}{{/eventsPage}}
                {{#sessionsPage}}{{> admin/sessions}}{{/sessionsPage}}
                {{#categoriesPage}}{{> admin/categories}}{{/categoriesPage}}
                {{^cancelsPage}}
                {{^membersPage}}
                {{^companiesPage}}
                {{^eventsPage}}
                {{^sessionsPage}}
                {{^categoriesPage}}
                <section class="admin-panel"><div class="admin-panel-heading"><h2>{{pageTitle}}</h2><span class="admin-badge">{{i18n.admin.ui0195}}</span></div><div class="admin-empty admin-empty-large"><span class="admin-empty-icon" aria-hidden="true">☰</span><h3>{{i18n.admin.ui0196}}</h3><p>{{i18n.admin.ui0197}}</p><a class="admin-primary-link" href="/admin/dashboard">{{i18n.admin.ui0198}}</a></div></section>
                {{/categoriesPage}}
                {{/sessionsPage}}
                {{/eventsPage}}
                {{/companiesPage}}
                {{/membersPage}}
                {{/cancelsPage}}
            {{/dashboardPage}}
        </main>
        <footer class="admin-footer">{{i18n.admin.ui0199}}</footer>
    </div>
</div>
{{> admin/interaction}}
{{#cancelsPage}}<script src="/js/admin-event-cancels.js" defer></script>{{/cancelsPage}}
</body>
</html>
