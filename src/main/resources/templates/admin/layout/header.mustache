{{> layout/i18n-assets}}
<header class="admin-header">
    <div class="admin-header-context"><span class="admin-console-label">{{i18n.admin.ui0121}}</span><span class="admin-header-divider" aria-hidden="true">/</span><span>{{pageTitle}}</span></div>
    <div class="admin-account">
        {{> layout/locale}}
        {{#loginUser}}<span class="admin-avatar" aria-hidden="true">A</span><span>{{displayName}}<small>{{i18n.admin.ui0122}}</small></span>{{/loginUser}}
        <form action="/logout" method="post"><button type="submit">{{i18n.common.logout}}</button></form>
    </div>
</header>
