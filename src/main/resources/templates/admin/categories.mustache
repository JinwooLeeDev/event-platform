{{#categoryError}}<p class="admin-company-warning" role="alert">{{categoryError}}</p>{{/categoryError}}
<section class="admin-panel">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0001}}</h2></div>
    <form action="/admin/categories" method="post" class="admin-member-search">
        <label for="category-name">{{i18n.admin.ui0002}}</label>
        <input id="category-name" name="name" maxlength="100" required placeholder="{{i18n.admin.ui0003}}">
        <button type="submit">{{i18n.admin.ui0004}}</button>
    </form>
</section>
<section class="admin-panel admin-history">
    <div class="admin-panel-heading"><h2>{{i18n.admin.ui0005}}</h2></div>
    <div class="admin-table-wrap"><table class="admin-table">
        <caption class="admin-sr-only">{{i18n.admin.ui0006}}</caption>
        <thead><tr><th scope="col">{{i18n.admin.ui0007}}</th><th scope="col">{{i18n.admin.ui0008}}</th><th scope="col">{{i18n.admin.ui0009}}</th></tr></thead>
        <tbody>
        {{#categoryList}}
        <tr>
            <td>{{id}}</td>
            <td><form action="/admin/categories/update/{{id}}" method="post" class="admin-category-edit">
                <label class="admin-sr-only" for="category-name-{{id}}">{{i18n.admin.ui0002}}</label>
                <input id="category-name-{{id}}" name="name" value="{{name}}" maxlength="100" required>
                <button type="submit" class="admin-status-button admin-status-button-activate">{{i18n.admin.ui0010}}</button>
            </form></td>
            <td><form action="/admin/categories/delete/{{id}}" method="post" class="admin-status-form" data-admin-confirm="{{i18n.admin.action.deleteCategory}}" data-admin-target="{{name}}" data-admin-danger="true">
                <button type="submit" class="admin-status-button admin-status-button-danger">{{i18n.admin.ui0009}}</button>
            </form></td>
        </tr>
        {{/categoryList}}
        {{^categoryList}}<tr><td colspan="3" class="admin-member-empty">{{i18n.admin.ui0011}}</td></tr>{{/categoryList}}
        </tbody>
    </table></div>
    <p class="admin-company-note">{{i18n.admin.ui0012}}</p>
</section>
