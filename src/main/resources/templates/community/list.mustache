<!DOCTYPE html>
<html lang="{{localeCode}}"><head>{{> layout/head-meta}}<title>{{i18n.community.ui0016}}</title></head><body>
{{> layout/header}}
{{> layout/account-style}}
{{> community/style}}
<main class="community-page"><div class="account-layout">
    {{#host}}{{> layout/company-nav}}{{/host}}{{^host}}{{> layout/account-nav}}{{/host}}
    <div class="account-content">
        <header class="community-heading"><p class="community-location">{{#host}}{{i18n.community.ui0017}}{{/host}}{{^host}}{{i18n.community.ui0018}}{{/host}}</p><h1>{{i18n.community.ui0019}}</h1><p>{{#host}}{{i18n.community.ui0020}}{{/host}}{{^host}}{{i18n.community.ui0021}}{{/host}}</p></header>
        <div class="community-guide"><span aria-hidden="true">ⓘ</span><div><strong>{{#host}}{{i18n.community.ui0022}}{{/host}}{{^host}}{{i18n.community.ui0023}}{{/host}}</strong><p>{{i18n.community.ui0024}}</p></div></div>
        <section class="community-rooms" aria-label="{{i18n.community.ui0025}}">
            {{#communities}}<article class="community-room-link"><div class="community-room-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16v12H9l-5 4V4Z"/><path d="M8 8h8m-8 4h5"/></svg></div><div class="community-room-info"><span class="community-tag">{{#host}}{{i18n.community.ui0026}}{{/host}}{{^host}}{{i18n.community.ui0027}}{{/host}}</span><h2><a href="{{url}}">{{eventTitle}}</a></h2><p class="community-session">{{sessionName}}</p><p class="community-close">{{closeText}}</p></div><a class="community-button" href="{{url}}">{{i18n.community.ui0028}} <span aria-hidden="true">›</span></a></article>{{/communities}}
            {{#empty}}<div class="community-empty"><span aria-hidden="true">☏</span><h2>{{i18n.community.ui0029}}</h2><p>{{#host}}{{i18n.community.ui0030}}{{/host}}{{^host}}{{i18n.community.ui0031}}{{/host}}</p>{{#host}}<a class="community-button community-button--secondary" href="/events">{{i18n.community.ui0032}}</a>{{/host}}{{^host}}<a class="community-button community-button--secondary" href="/myhistory">{{i18n.community.ui0033}}</a>{{/host}}</div>{{/empty}}
        </section>
    </div>
</div></main>
{{> layout/footer}}
</body></html>
