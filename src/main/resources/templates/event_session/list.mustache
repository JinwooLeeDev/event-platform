<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.event.ui0202}}</title></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/session-style}}
<main class="company-workspace session-page"><div class="account-layout">
    {{> layout/company-nav}}
    <section class="account-content" data-session-picker>
        <header class="company-heading"><div><p class="company-location">{{i18n.event.ui0203}}</p><h1>{{i18n.event.ui0204}}</h1><p class="company-description">{{i18n.event.ui0205}}</p></div><a class="company-button company-button--secondary" href="/events">{{i18n.event.ui0183}}</a></header>
        <div class="session-choice-grid">
        {{#eventSession}}
        <a class="session-panel session-choice-link" href="/event-sessions/{{id}}" data-session-link><div class="company-panel-heading"><h2>{{name}}</h2><span class="company-state" data-session-status>{{status}}</span></div><dl class="session-facts"><div><dt>{{i18n.admin.ui0065}}</dt><dd><span data-session-date>{{startsAt}}</span><br>~ <span data-session-date>{{endsAt}}</span></dd></div><div><dt>{{i18n.admin.ui0099}}</dt><dd><span data-session-date>{{applyStartAt}}</span><br>~ <span data-session-date>{{applyEndAt}}</span></dd></div></dl><div class="session-choice-metrics"><div><span>{{i18n.admin.ui0100}}</span><strong>{{capacityLabel}}</strong></div><div><span>{{i18n.event.ui0156}}</span><strong>{{occupiedCount}}{{i18n.admin.ui0067}}</strong></div><div><span>{{i18n.admin.ui0101}}</span><strong data-session-point>{{fee}}</strong></div></div><span class="session-choice-action">{{i18n.company.ui0065}} <span aria-hidden="true">↗</span></span></a>
        {{/eventSession}}
        </div>
        {{^eventSession}}<div class="company-empty"><h2>{{i18n.admin.ui0102}}</h2><p>{{i18n.event.ui0206}}</p></div>{{/eventSession}}
        {{> event_session/create-form}}
        <noscript>{{i18n.event.ui0207}}</noscript>
    </section>
</div></main>
{{> layout/footer}}
<script src="/js/company-session.js" defer></script>
</body>
</html>
