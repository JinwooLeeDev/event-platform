<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.event.ui0176}}</title></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/session-style}}
<link rel="stylesheet" href="/css/event-cancel.css">
<main class="company-workspace session-page"><div class="account-layout">
    {{> layout/company-nav}}
    <section class="account-content">
        {{#eventSession}}
        <header class="company-heading"><div><p class="company-location">{{i18n.event.ui0177}}</p><h1>{{name}}</h1><p class="company-description">{{i18n.event.ui0178}}</p></div><a class="company-button company-button--secondary" href="/events/sessions/list/{{eventId}}?select=1">{{i18n.event.ui0179}}</a></header>
        <nav class="company-section-links" aria-label="{{i18n.event.ui0180}}"><a href="#session-information">{{i18n.event.ui0181}}</a><a href="#participants-panel">{{i18n.event.ui0182}}</a><a href="#session-create">{{i18n.company.ui0066}}</a><a href="/events">{{i18n.event.ui0183}}</a></nav>
        <section class="session-panel" id="session-information" aria-labelledby="session-information-title"><div class="company-panel-heading"><h2 id="session-information-title">{{i18n.event.ui0184}}</h2><span class="company-state" data-session-status>{{status}}</span></div><dl class="session-facts"><div><dt>{{i18n.admin.ui0065}}</dt><dd><span data-session-date>{{startsAt}}</span><br>~ <span data-session-date>{{endsAt}}</span></dd></div><div><dt>{{i18n.admin.ui0099}}</dt><dd><span data-session-date>{{applyStartAt}}</span><br>~ <span data-session-date>{{applyEndAt}}</span></dd></div></dl><div class="session-choice-metrics"><div><span>{{i18n.admin.ui0100}}</span><strong data-session-capacity>{{capacity}}</strong></div><div><span>{{i18n.admin.ui0066}}</span><strong data-session-occupied>{{occupiedCount}}{{i18n.admin.ui0067}}</strong></div><div><span>{{i18n.admin.ui0101}}</span><strong data-session-point>{{fee}}</strong></div></div></section>
        <section class="session-panel" id="participants-panel" data-participants="{{id}}" aria-labelledby="participants-title"><div class="company-panel-heading"><div><h2 id="participants-title">{{i18n.event.ui0182}}</h2><p class="company-description">{{i18n.event.ui0185}}</p></div><div class="session-participant-actions" style="display:flex;gap:8px;flex-wrap:wrap"><a class="company-button" href="/attendance/qr/{{id}}" target="_blank" rel="noopener">{{i18n.community.ui0045}}</a><button class="company-button company-button--secondary" type="button" data-participant-refresh>{{i18n.event.ui0186}}</button></div></div><div class="session-tools session-participant-tools"><label>{{i18n.event.ui0187}}<input type="search" data-participant-search placeholder="{{i18n.event.ui0188}}" disabled></label><label>{{i18n.event.ui0189}}<select data-participant-filter disabled><option value="">{{i18n.admin.ui0144}}</option><option value="CONFIRMED">{{i18n.community.ui0027}}</option><option value="PENDING">{{i18n.company.ui0034}}</option><option value="WAITING">{{i18n.event.ui0190}}</option></select></label></div>
            <p class="company-result" data-participant-summary role="status">{{i18n.event.ui0191}}</p><p class="company-error" data-participant-error role="alert" hidden></p><p data-participant-login hidden><a class="company-text-link" href="/login?type=company">{{i18n.event.ui0192}}</a></p>
            <p class="company-success" data-participant-notice role="status" hidden></p>
            <div class="session-table-wrap"><table class="session-table" aria-busy="true"><caption>{{i18n.event.ui0193}}</caption><thead><tr><th scope="col">{{i18n.event.ui0194}}</th><th scope="col">{{i18n.community.ui0054}}</th><th scope="col">{{i18n.event.ui0189}}</th><th scope="col">{{i18n.admin.ui0064}}</th><th scope="col">{{i18n.community.ui0012}}</th><th scope="col">{{i18n.event.ui0195}}</th></tr></thead><tbody data-participant-rows></tbody></table></div><noscript>{{i18n.event.ui0196}}</noscript>
        </section>
        {{> event_session/create-form}}
        <section class="session-panel cancel-panel" aria-labelledby="session-cancel-title">
            <div class="company-panel-heading"><div><h2 id="session-cancel-title">{{i18n.company.ui0068}}</h2><p class="company-description">{{i18n.event.ui0197}}</p></div></div>
            {{#successMessage}}<p class="cancel-notice" role="status">{{successMessage}}</p>{{/successMessage}}
            {{#latestCancel}}<div class="cancel-result cancel-result--{{cancelStatusTone}}"><strong>{{cancelStatusLabel}}</strong><p>{{i18n.admin.ui0084}} <span data-session-date>{{createdAt}}</span></p><p class="cancel-reason">{{reason}}</p></div>{{/latestCancel}}
            {{^latestCancel}}<p class="company-description">{{i18n.event.ui0198}}</p>{{/latestCancel}}
            {{#canRequestCancel}}<p class="company-description">{{i18n.event.ui0199}}</p><a class="company-button company-button--secondary" href="/event-cancels/save/{{id}}">{{i18n.event.ui0200}}</a>{{/canRequestCancel}}
            {{^canRequestCancel}}<p class="company-description">{{i18n.event.ui0201}}</p>{{/canRequestCancel}}
        </section>
        {{/eventSession}}
    </section>
</div></main>
{{> layout/footer}}
{{> company/participant-reject-dialog}}
<script src="/js/company-session.js" defer></script>
<script src="/js/company-participants.js" defer></script>
<script>document.querySelector('a[href="#session-create"]')?.addEventListener('click', () => { const panel = document.getElementById('session-create'); if (panel) panel.open = true; });</script>
</body>
</html>
