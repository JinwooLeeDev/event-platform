<!DOCTYPE html>
<html lang="ko">
<head>{{> layout/head-meta}}<title>회차·참가자 관리 | Busan Play</title></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/session-style}}
<main class="session-page"><div class="account-layout">
    {{> layout/company-nav}}
    <section class="account-content">
        {{#eventSession}}
        <a href="/events">← 주최 행사 목록</a>
        <p class="member-eyebrow">BUSAN PLAY · PARTNERS</p><h1>{{name}}</h1>
        <p class="session-muted">회차의 운영 정보와 신청자 현황을 확인하세요. <a href="/events/sessions/list/{{eventId}}?select=1">다른 회차 선택 →</a></p>
        <section class="session-panel" aria-label="회차 운영 정보">
            <h2>회차 정보</h2>
            <dl class="session-facts">
                <div><dt>개최 일정</dt><dd><span data-session-date>{{startsAt}}</span> ~ <span data-session-date>{{endsAt}}</span></dd></div>
                <div><dt>모집 기간</dt><dd><span data-session-date>{{applyStartAt}}</span> ~ <span data-session-date>{{applyEndAt}}</span></dd></div>
                <div><dt>정원</dt><dd data-session-capacity>{{capacity}}</dd></div>
                <div><dt>현재 점유 인원</dt><dd>{{occupiedCount}}명</dd></div>
                <div><dt>참가비</dt><dd data-session-point>{{fee}}</dd></div>
                <div><dt>운영 상태</dt><dd data-session-status>{{status}}</dd></div>
            </dl>
        </section>
        <section class="session-panel" data-participants="{{id}}" aria-labelledby="participants-title">
            <h2 id="participants-title">회차별 참가자 목록</h2>
            <p class="session-muted" data-participant-summary role="status">참가자 목록을 불러오는 중입니다.</p>
            <div class="session-tools">
                <label>참가자 검색<input type="search" data-participant-search placeholder="닉네임 또는 신청 번호" disabled></label>
                <label>신청 상태<select data-participant-filter disabled><option value="">전체</option><option value="CONFIRMED">참가 확정</option><option value="PENDING">승인 대기</option><option value="WAITING">대기</option><option value="CANCELLED">취소</option><option value="REJECTED">반려</option></select></label>
                <button type="button" data-participant-refresh>새로고침</button>
            </div>
            <p class="session-muted" data-participant-error role="alert" hidden></p>
            <p data-participant-login hidden><a href="/login?type=company">기업 계정으로 로그인 →</a></p>
            <div class="session-table-wrap"><table class="session-table" aria-busy="true">
                <caption class="session-muted">해당 회차의 전체 신청 내역 (취소·반려 포함)</caption>
                <thead><tr><th scope="col">신청 번호</th><th scope="col">참가자</th><th scope="col">신청 상태</th><th scope="col">신청 일시</th></tr></thead>
                <tbody data-participant-rows></tbody>
            </table></div>
            <noscript><p class="session-muted">참가자 목록을 확인하려면 JavaScript를 활성화해 주세요.</p></noscript>
        </section>
        {{> event_session/create-form}}
        <section class="session-panel">
            <h2>회차 삭제</h2>
            <p class="session-muted">이 회차를 삭제합니다. 신청·구매 이력이 연결되어 있으면 삭제할 수 없습니다.</p>
            <form action="/event-sessions/delete/{{id}}" method="post" data-delete-form data-confirm="이 회차를 삭제하시겠습니까? 삭제한 회차는 복구할 수 없습니다.">
                <button type="submit" class="session-delete-button">회차 삭제</button>
                <p class="session-muted" data-delete-error role="alert" hidden></p>
            </form>
        </section>
        {{/eventSession}}
    </section>
</div></main>
{{> layout/footer}}
<script src="/js/company-session.js" defer></script>
</body></html>
