<details class="session-panel" id="session-create" data-session-create hidden>
    <summary>{{i18n.event.ui0117}}</summary>
    <p class="session-muted">{{i18n.event.ui0173}}</p>
    <form method="post" class="session-tools session-create-form" data-session-create-form data-event-id="{{#eventId}}{{eventId}}{{/eventId}}">
        <label class="session-wide">{{i18n.event.ui0123}}<input name="name" required placeholder="{{i18n.event.ui0174}}"></label>
        <label>{{i18n.event.ui0153}}<input type="datetime-local" step="any" name="startsAt" required></label>
        <label>{{i18n.event.ui0154}}<input type="datetime-local" step="any" name="endsAt" required></label>
        <label>{{i18n.event.ui0055}}<input type="datetime-local" step="any" name="applyStartAt" required></label>
        <label>{{i18n.event.ui0057}}<input type="datetime-local" step="any" name="applyEndAt" required></label>
        <label>{{i18n.admin.ui0100}}<input type="number" name="capacity" min="1" max="2147483647" required></label>
        <label>{{i18n.event.ui0111}}<select name="pricingType"><option value="FREE">{{i18n.event.ui0113}}</option><option value="PAID">{{i18n.event.ui0114}}</option></select></label>
        <label>{{i18n.event.ui0160}}<input type="number" name="fee" min="0" value="0" readonly required></label>
        <input type="hidden" name="holdDurationSeconds" value="0">
        <input type="hidden" name="reservationDepositPoints" value="0">
        <input type="hidden" name="minimumParticipants" value="1">
        <input type="hidden" name="minimumCheckAt">
        <div class="session-wide"><button type="submit">{{i18n.event.ui0175}}</button></div>
    </form>
</details>
