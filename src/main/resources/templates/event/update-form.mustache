<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>
    {{> layout/head-meta}}
    <title>{{i18n.event.ui0145}}</title>
</head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> event/save-form-style}}
{{> company/workspace-style}}
<main class="event-save-page company-workspace">
    <div class="account-layout">
        {{> layout/company-nav}}
        <div class="event-save-container account-content">
            <div class="event-save-navigation"><a href="/events">{{i18n.event.ui0146}}</a></div>
            <header class="event-save-header">
                <span class="event-save-label">BUSAN PLAY · PARTNERS</span>
                <h1>{{i18n.event.ui0147}}</h1>
                <p>{{i18n.event.ui0148}}</p>
            </header>
            {{#event}}
            {{#feedbackMessage}}<div class="event-save-notice" style="margin-bottom:24px"><strong>{{i18n.company.ui0005}}</strong><p style="white-space:pre-wrap;margin-bottom:0">{{feedbackMessage}}</p></div>{{/feedbackMessage}}
            <form id="event-update-form" class="event-save-form" action="/events/update/{{id}}" method="post" enctype="multipart/form-data">
                <section class="event-save-section">
                    <h2>{{i18n.event.ui0090}}</h2>
                    <p class="section-description">{{i18n.event.ui0149}}</p>
                    <div class="form-group">
                        <label for="update-category">{{i18n.event.ui0070}}</label>
                        <select id="update-category" name="categoryId" data-current="{{categoryId}}" required>
                            <option value="{{categoryId}}" selected>{{categoryName}} {{i18n.event.ui0150}}</option>
                            {{#categoryList}}<option value="{{id}}">{{name}}</option>{{/categoryList}}
                        </select>
                    </div>
                    <div class="form-group"><label for="update-title">{{i18n.event.ui0093}}</label><input id="update-title" name="title" value="{{title}}" required></div>
                    <div class="form-group"><label for="update-summary">{{i18n.admin.ui0094}}</label><input id="update-summary" name="summary" value="{{summary}}" required></div>
                    <div class="form-group"><label for="update-address">{{i18n.admin.ui0090}}</label><input id="update-address" name="address" value="{{address}}" required></div>
                    <div class="form-group"><label for="update-description">{{i18n.admin.ui0095}}</label><textarea id="update-description" name="description" rows="8" required>{{description}}</textarea></div>
                </section>
                <section class="event-save-section">
                    <h2>{{i18n.event.ui0151}}</h2>
                    <p class="section-description">{{i18n.event.ui0152}}</p>
                    {{#editSessions}}{{#session}}
                    <div class="session-item" data-edit-session>
                        <h3>{{name}}</h3>
                        <input type="hidden" name="sessions[{{index}}].id" value="{{id}}">
                        <input type="hidden" name="sessions[{{index}}].holdDurationSeconds" value="{{holdDurationSeconds}}">
                        <input type="hidden" name="sessions[{{index}}].reservationDepositPoints" value="{{reservationDepositPoints}}">
                        <input type="hidden" name="sessions[{{index}}].minimumParticipants" value="{{minimumParticipants}}">
                        <input type="hidden" name="sessions[{{index}}].minimumCheckAt" value="{{minimumCheckAt}}">
                        <div class="form-group"><label>{{i18n.event.ui0123}}<input name="sessions[{{index}}].name" value="{{name}}" required></label></div>
                        <div class="date-time-group">
                            <div class="form-group"><label>{{i18n.event.ui0153}}<input type="datetime-local" step="any" name="sessions[{{index}}].startsAt" data-start value="{{startsAt}}" required></label></div>
                            <div class="form-group"><label>{{i18n.event.ui0154}}<input type="datetime-local" step="any" name="sessions[{{index}}].endsAt" data-end value="{{endsAt}}" required></label></div>
                        </div>
                        <div class="date-time-group">
                            <div class="form-group"><label>{{i18n.event.ui0055}}<input type="datetime-local" step="any" name="sessions[{{index}}].applyStartAt" data-apply-start value="{{applyStartAt}}" required></label></div>
                            <div class="form-group"><label>{{i18n.event.ui0057}}<input type="datetime-local" step="any" name="sessions[{{index}}].applyEndAt" data-apply-end value="{{applyEndAt}}" required></label></div>
                        </div>
                        <div class="form-group"><label>{{i18n.admin.ui0100}}<input type="number" min="{{minimumParticipants}}" max="2147483647" name="sessions[{{index}}].capacity" data-capacity value="{{capacity}}" required></label>
                            <label style="display:flex;align-items:center;gap:8px"><input type="checkbox" data-unlimited style="width:18px;height:18px;min-height:18px">{{i18n.event.ui0155}}</label>
                            <small>{{i18n.event.ui0156}} {{occupiedCount}}{{i18n.event.ui0157}} {{minimumParticipants}}{{i18n.event.ui0158}}</small>
                        </div>
                        <div class="form-group"><label>{{i18n.event.ui0111}}<select name="sessions[{{index}}].pricingType" data-current="{{pricingType}}" data-pricing required><option value="{{pricingType}}" selected>{{i18n.event.ui0159}}</option><option value="FREE">{{i18n.event.ui0113}}</option><option value="PAID">{{i18n.event.ui0114}}</option></select></label></div>
                        <div class="form-group"><label>{{i18n.event.ui0160}}<input type="number" min="0" name="sessions[{{index}}].fee" data-fee value="{{fee}}" required></label></div>
                    </div>
                    {{/session}}{{/editSessions}}
                    {{^editSessions}}<p class="section-description">{{i18n.admin.ui0102}}</p>{{/editSessions}}
                </section>
                <section class="event-save-section">
                    <h2>{{i18n.event.ui0161}}</h2>
                    <p class="section-description">{{i18n.event.ui0162}}</p>
                    <img src="/event-files/{{id}}" alt="{{i18n.event.ui0163}}" style="max-width:100%;max-height:300px;object-fit:contain" onerror="this.hidden=true">
                    <div class="form-group"><label for="update-image">{{i18n.event.ui0164}}</label><input id="update-image" type="file" name="file" accept=".jpg,.jpeg,.png"><small>{{i18n.event.ui0165}}</small></div>
                </section>
                <p class="event-save-notice">{{i18n.event.ui0166}}</p>
                <div class="event-save-actions"><a href="/events" class="cancel-button">{{i18n.event.ui0167}}</a><button type="submit" class="submit-button">{{i18n.event.ui0168}}</button></div>
            </form>
            {{/event}}
        </div>
    </div>
</main>
{{> layout/footer}}
<script>
(() => {
    document.querySelectorAll('select[data-current]').forEach(select => {
        if (Array.from(select.options).some((option, index) => index > 0 && option.value === select.dataset.current)) {
            select.options[0].remove(); select.value = select.dataset.current;
        }
    });
    document.querySelectorAll('[data-edit-session]').forEach(row => {
        const capacity = row.querySelector('[data-capacity]');
        const unlimited = row.querySelector('[data-unlimited]');
        unlimited.checked = capacity.value === '2147483647';
        capacity.hidden = unlimited.checked;
        unlimited.addEventListener('change', () => { capacity.hidden = unlimited.checked; capacity.value = unlimited.checked ? '2147483647' : ''; });
        const pricing = row.querySelector('[data-pricing]'), fee = row.querySelector('[data-fee]');
        const updateFee = () => { fee.readOnly = pricing.value === 'FREE'; fee.min = fee.readOnly ? '0' : '1'; if (fee.readOnly) fee.value = '0'; };
        pricing.addEventListener('change', updateFee); updateFee();
        const start = row.querySelector('[data-start]'), end = row.querySelector('[data-end]');
        const validateDate = () => end.setCustomValidity(start.value && end.value && start.value > end.value ? BusanI18n.t("event.ui0169") : '');
        start.addEventListener('input', validateDate); end.addEventListener('input', validateDate);
        const applyStart = row.querySelector('[data-apply-start]'), applyEnd = row.querySelector('[data-apply-end]');
        const validateApplyDate = () => applyEnd.setCustomValidity(applyStart.value && applyEnd.value && applyStart.value > applyEnd.value ? BusanI18n.t("event.ui0170") : '');
        applyStart.addEventListener('input', validateApplyDate); applyEnd.addEventListener('input', validateApplyDate);
    });
    const file = document.getElementById('update-image');
    file.addEventListener('change', () => file.setCustomValidity(file.files[0]?.size > 10485760 ? BusanI18n.t("event.ui0171") : ''));
    document.getElementById('event-update-form').addEventListener('submit', event => {
        const blank = Array.from(event.target.querySelectorAll('input[required], textarea[required]')).find(input => !input.value.trim());
        if (blank) { event.preventDefault(); blank.focus(); alert(BusanI18n.t("event.ui0172")); }
    });
})();
</script>
</body>
</html>
