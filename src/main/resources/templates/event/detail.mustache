{{> layout/header}}

<div class="container mt-5">
    <!-- 행사 상세 정보 영역 -->
    <div class="card">
        <div class="card-header">
            <h3>{{event.title}}</h3>
        </div>
        <div class="card-body">
            <p><strong>행사 내용:</strong> {{event.content}}</p>
            <p><strong>참가비:</strong> {{event.fee}} 포인트</p>
            <p><strong>현재 확정 인원:</strong> <span class="text-primary">{{confirmedCount}}</span> / {{event.capacity}} 명
            </p>

            <!-- 참가 신청 버튼 (eventId를 data 속성으로 숨겨둠) -->
            <button id="btn-register" class="btn btn-success" data-event-id="{{event.id}}">참가 신청하기</button>
        </div>
    </div>
</div>

<!-- Fetch API 통신 스크립트 -->
<script>
    document.getElementById('btn-register').addEventListener('click', function () {
        const eventId = this.getAttribute('data-event-id');

        if (!confirm('이 행사에 참가 신청하시겠습니까? 유료 행사의 경우 포인트가 차감됩니다.')) {
            return;
        }

        // 백엔드 API 호출
        fetch(`/api/events/${eventId}/registrations`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
                .then(response => {
                    // HTTP 상태 코드가 400(에러)일 경우 처리
                    if (!response.ok) {
                        return response.text().then(text => { // json() 대신 text()로 먼저 받음
                            try {
                                const errObj = JSON.parse(text); // JSON 형태라면 파싱 시도
                                throw new Error(errObj.message || '신청 중 오류가 발생했습니다.');
                            } catch (e) {
                                throw new Error(text); // JSON이 아닌 순수 텍스트라면 그대로 에러로 던짐
                            }
                        });
                    }
                    return response.json(); // 정상 응답(200)일 때는 RegistrationRes DTO 반환
                })
                .then(data => {
                    if (data.status === 'WAITING') {
                        alert(`대기열에 등록되었습니다! (대기번호: ${data.queueNumber}번)`);
                    } else {
                        alert('참가 신청이 완료되었습니다!');
                    }
                    // 인원수 갱신을 위해 페이지 새로고침
                    window.location.reload();
                })
                .catch(error => {
                    alert(error.message); // 잔액 부족, 정원 초과 등의 Exception400 메시지 출력
                });
    });
</script>

{{> layout/footer}}