
<style>
    .event-detail-page {
        max-width: 1200px;
        margin: 55px auto;
        padding: 0 24px;
    }

    .event-detail-container {
        display: grid;
        grid-template-columns: 400px minmax(0, 1fr);
        gap: 48px;
        align-items: start;
    }

    /* 대표 이미지 */
    .event-image-section {
        position: sticky;
        top: 30px;
    }

    .event-main-image {
        width: 100%;
        aspect-ratio: 3 / 4;
        background: linear-gradient(145deg, #edf2fa, #dfe8f5);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7d8ba1;
        font-size: 15px;
    }

    /* 행사 제목 */
    .event-info-section {
        min-width: 0;
    }

    .event-title-area {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }

    .event-category {
        display: inline-block;
        margin-bottom: 12px;
        color: #3568cf;
        font-size: 13px;
        font-weight: 700;
    }

    .event-title-area h1 {
        margin: 0 0 12px;
        font-size: 30px;
        line-height: 1.4;
        color: #202b3c;
    }

    .event-title-area p {
        margin: 0;
        color: #7b8493;
        line-height: 1.6;
    }

    /* 찜하기 */
    .favorite-btn {
        flex-shrink: 0;
        padding: 11px 17px;
        border: 1px solid #dce2eb;
        border-radius: 10px;
        background: #fff;
        color: #555f70;
        font-weight: 600;
        cursor: pointer;
    }

    .favorite-btn.active {
        border-color: #f1c8d1;
        background: #fff4f6;
        color: #e34f72;
    }

    /* 정보 박스 */
    .event-info-box,
    .event-apply-section {
        padding: 26px;
        margin-bottom: 24px;
        border: 1px solid #e9edf3;
        border-radius: 17px;
        background: #fff;
    }

    .event-info-box h2,
    .event-apply-section h2 {
        margin: 0 0 20px;
        font-size: 20px;
        color: #253044;
    }

    .event-info-row {
        display: flex;
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid #f0f2f5;
        line-height: 1.6;
    }

    .event-info-row strong {
        width: 100px;
        flex-shrink: 0;
        color: #687386;
        font-size: 14px;
    }

    .event-info-row span {
        color: #303b4d;
        font-size: 14px;
    }

    .event-description {
        margin-top: 24px;
    }

    .event-description h3 {
        font-size: 16px;
        color: #303b4d;
    }

    .event-description p {
        color: #596477;
        line-height: 1.9;
        white-space: pre-line;
    }

    /* 참가 신청 */
    .apply-btn {
        display: block;
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 11px;
        background: #285fce;
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

    .apply-btn:hover:not(:disabled) {
        background: #174baa;
    }

    .apply-btn.disabled,
    .apply-btn:disabled {
        background: #aeb6c3;
        cursor: not-allowed;
    }

    /* 모달 */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        padding: 24px;
        background: rgba(20, 30, 45, 0.55);
        justify-content: center;
        align-items: center;
    }

    .modal-overlay.show {
        display: flex;
    }

    .session-modal {
        width: 100%;
        max-width: 650px;
        max-height: 85vh;
        overflow-y: auto;
        padding: 28px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.18);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 23px;
        color: #253044;
    }

    .modal-header p {
        margin: 8px 0 0;
        color: #8791a0;
        font-size: 13px;
    }

    .modal-close {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: #f1f3f6;
        color: #555;
        font-size: 24px;
        cursor: pointer;
    }

    /* 회차 카드 */
    .session-list {
        margin-top: 24px;
    }

    .session-item {
        padding: 22px;
        margin-bottom: 16px;
        border: 1px solid #e6eaf0;
        border-radius: 15px;
        background: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .session-item:has(.session-select-btn:not(:disabled)):hover {
        border-color: #9bb7ef;
        box-shadow: 0 5px 18px rgba(36, 91, 216, 0.08);
    }

    .session-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .session-item-header h3 {
        margin: 0;
        font-size: 18px;
        color: #263247;
    }

    .session-status {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .session-status.open {
        background: #e8f5ed;
        color: #23834b;
    }

    .session-status.upcoming {
        background: #fff5df;
        color: #ad791b;
    }

    .session-status.closed,
    .session-status.cancelled {
        background: #f0f1f3;
        color: #858b96;
    }

    .session-info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 8px 0;
        font-size: 13px;
    }

    .session-info-row span {
        color: #8791a0;
    }

    .session-info-row strong {
        color: #3b4658;
        text-align: right;
    }

    /* 참가비 및 예약 보증금 */
    .session-price-box {
        margin-top: 15px;
        padding: 15px 17px;
        border-radius: 11px;
        background: #f6f8fc;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 0;
    }

    .price-row span {
        color: #788397;
        font-size: 13px;
    }

    .session-fee {
        color: #285fce;
        font-size: 20px;
        font-weight: 800;
    }

    .session-deposit {
        color: #455166;
        font-size: 14px;
        font-weight: 700;
    }

    /* 회차 선택 */
    .session-select-btn {
        width: 100%;
        margin-top: 17px;
        padding: 13px;
        border: none;
        border-radius: 9px;
        background: #285fce;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

    .session-select-btn:disabled {
        background: #e8ebf0;
        color: #929aa7;
        cursor: not-allowed;
    }

    /* 모바일 */
    @media (max-width: 768px) {
        .event-detail-page {
            margin: 30px auto;
            padding: 0 16px;
        }

        .event-detail-container {
            grid-template-columns: 1fr;
            gap: 25px;
        }

        .event-image-section {
            position: static;
        }

        .event-main-image {
            aspect-ratio: 16 / 9;
        }

        .event-title-area {
            flex-direction: column;
        }

        .event-title-area h1 {
            font-size: 24px;
        }

        .event-info-box,
        .event-apply-section {
            padding: 20px;
        }

        .session-modal {
            padding: 20px;
        }

        .session-info-row {
            flex-direction: column;
            gap: 3px;
        }

        .session-info-row strong {
            text-align: left;
        }
    }
</style>
