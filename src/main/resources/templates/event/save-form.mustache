
<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>행사 주최 신청 | Busan Play</title>
</head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> event/save-form-style}}

{{> company/workspace-style}}
<main class="event-save-page company-workspace">
    <div class="account-layout">
        {{> layout/company-nav}}
        <div class="event-save-container account-content">

            <div class="event-save-navigation">
                <a href="/events">← 내 행사 목록으로</a>
            </div>

        <section class="event-save-header">
            <span class="event-save-label">BUSAN PLAY · PARTNERS</span>
            <h1>행사 주최 신청</h1>
            <p>부산에서 함께할 새로운 경험을 소개해 주세요.<br>행사 정보와 일정을 작성하면 관리자 심사를 위해 접수됩니다.</p>
        </section>

            <form action="/events/save"
                  method="post"
                  enctype="multipart/form-data"
                  class="event-save-form"
                  id="event-save-form">

                <p id="event-save-form-error"
                   class="event-save-form-error"
                   role="alert"
                   tabindex="-1"
                   hidden></p>

            <!-- 행사 기본 정보 -->
            <section class="event-save-section">
                <h2><span class="event-section-number">01 </span>행사 기본 정보</h2>
                <p class="section-description">
                    행사에 대한 기본 정보를 입력해 주세요.
                </p>

                    <div class="form-group">
                        <label>행사 카테고리 <span>*</span></label>
                        <select name="categoryId" required>
                            <option value="">카테고리를 선택해 주세요.</option>
                            {{#categoryList}}
                                <option value="{{id}}">{{name}}</option>
                            {{/categoryList}}
                        </select>
                    </div>

                    <div class="form-group">
                        <label>행사 제목 <span>*</span></label>
                        <input type="text" name="title"
                               placeholder="행사의 이름을 입력해 주세요" required>
                    </div>

                    <div class="form-group">
                        <label>한 줄 요약 <span>*</span></label>
                        <input type="text" name="summary"
                               placeholder="어떤 경험을 할 수 있는 행사인가요?" required>
                    </div>

                <div class="form-group">
                    <label>행사 주소 <span>*</span></label>

                    <div style="display: flex; gap: 10px;">
                        <input type="text"
                               id="address"
                               name="address"
                               placeholder="주소 검색 버튼을 눌러 주세요."
                               readonly
                               required
                               style="flex: 1;">

                        <button type="button"
                                id="address-search-button"
                                class="submit-button">
                            주소 검색
                        </button>
                    </div>

                    <input type="hidden" id="postalCode" name="postalCode">
                    <input type="hidden" id="placeName" name="placeName">
                </div>

                    <div class="form-group">
                        <label>상세 설명 <span>*</span></label>
                        <textarea name="description" rows="8" required></textarea>
                    </div>
                </section>


            <!-- 행사 일정 -->
            <section class="event-save-section">
                <h2><span class="event-section-number">02 </span>행사 일정</h2>
                <p class="section-description">
                    회차별로 운영하는 행사인지 선택해 주세요.
                </p>

                    <div class="form-group">
                        <label>회차가 있나요? <span>*</span></label>

                        <div class="session-choice">
                            <label>
                                <input type="radio" name="hasSessions"
                                       value="true" required>
                                회차가 있어요
                            </label>

                            <label>
                                <input type="radio" name="hasSessions"
                                       value="false" required>
                                회차가 없어요
                            </label>
                        </div>
                    </div>

                    <!-- 회차가 없는 행사 -->
                    <div id="no-session-area" hidden>
                        <h3>행사 전체 일정</h3>

                        <div class="date-time-group">
                            <div class="form-group">
                                <label for="startDate">행사 시작일 <span>*</span></label>
                                <input type="date" name="startDate" id="startDate" disabled required>
                            </div>
                            <div class="form-group">
                                <label for="startTime">행사 시작 시간 <span>*</span></label>
                                <input type="time" id="startTime" disabled required>
                            </div>
                        </div>

                        <div class="date-time-group">
                            <div class="form-group">
                                <label for="endDate">행사 종료일 <span>*</span></label>
                                <input type="date" name="endDate" id="endDate" disabled required>
                            </div>
                            <div class="form-group">
                                <label for="endTime">행사 종료 시간 <span>*</span></label>
                                <input type="time" id="endTime" disabled required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="capacity">모집 정원 <span>*</span></label>
                            <input type="number" name="sessions[0].capacity" id="capacity"
                                   min="1" max="2147483647" step="1" placeholder="참가 가능한 인원 수" disabled required>
                        </div>
                        <input type="hidden" name="sessions[0].startsAt" id="noSessionStartsAt" disabled>
                        <input type="hidden" name="sessions[0].endsAt" id="noSessionEndsAt" disabled>

                        <div class="date-time-group">
                            <div class="form-group">
                                <label>모집 시작일 <span>*</span></label>
                                <input type="date" id="applyStartDate"
                                       disabled required>
                            </div>

                            <div class="form-group">
                                <label>모집 시작 시간 <span>*</span></label>
                                <input type="time" id="applyStartTime"
                                       disabled required>
                            </div>
                        </div>

                        <div class="date-time-group">
                            <div class="form-group">
                                <label>모집 마감일 <span>*</span></label>
                                <input type="date" id="applyEndDate"
                                       disabled required>
                            </div>

                            <div class="form-group">
                                <label>모집 마감 시간 <span>*</span></label>
                                <input type="time" id="applyEndTime"
                                       disabled required>
                            </div>
                        </div>

                        <!-- 서버 전달용 -->
                        <input type="hidden" name="applyStartAt"
                               id="applyStartAt" disabled>
                        <input type="hidden" name="applyEndAt"
                               id="applyEndAt" disabled>

                        <!-- 참가비 -->
                        <div class="form-group">
                            <label>참가비 유형 <span>*</span></label>
                            <select name="pricingType" id="pricingType"
                                    disabled required>
                                <option value="">참가비 유형을 선택해 주세요.</option>
                                <option value="FREE">무료</option>
                                <option value="PAID">유료</option>
                            </select>
                        </div>

                        <div class="form-group fee-area"
                             id="fee-area" hidden>
                            <label>참가비 <span>*</span></label>
                            <input type="number" name="fee" id="fee"
                                   min="1" disabled>
                        </div>
                    </div>

                    <!-- 회차가 있는 행사 -->
                    <div id="session-area" hidden>
                        <h3>회차별 일정</h3>
                        <p class="section-description">
                            회차별 행사 일정과 모집 기간을 입력해 주세요.
                        </p>

                        <div id="session-list"></div>

                        <button type="button" id="add-session-button">
                            + 회차 추가
                        </button>
                    </div>
                </section>


            <!-- 대표 이미지 -->
            <section class="event-save-section">
                <h2><span class="event-section-number">03 </span>대표 이미지</h2>
                <p class="section-description">
                    행사를 대표하는 포스터 이미지를 등록해 주세요.
                </p>

                    <div class="form-group">
                        <label>대표 이미지 <span>*</span></label>
                        <div class="file-upload-box">
                            <input type="file" name="file"
                                   accept=".jpg,.jpeg,.png" required>
                            <p>JPG, JPEG, PNG 파일을 등록해 주세요.</p>
                        </div>
                    </div>
                </section>

                <p class="event-save-notice">
                    신청한 행사의 심사 상태는 기업 관리의 ‘주최 행사’에서 확인할 수 있습니다.
                </p>

                <div class="event-save-actions">
                    <a href="/events" class="cancel-button">취소</a>
                    <button type="submit" class="submit-button">
                        주최 신청하기
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>


<!-- 회차 입력 템플릿 -->
<template id="session-template">

    <div class="session-item">

        <div class="session-item-header">
            <h3 class="session-title"></h3>
            <button type="button" class="remove-session-button">삭제</button>
        </div>

        <div class="form-group">
            <label>회차명 <span>*</span></label>
            <input type="text" data-field="name"
                   placeholder="예: 1회차" required>
        </div>


        <!-- 행사 시작 -->
        <div class="date-time-group">
            <div class="form-group">
                <label>행사 시작 날짜 <span>*</span></label>
                <input type="date" data-date-field="startsAt" required>
            </div>
            <div class="form-group">
                <label>행사 시작 시간 <span>*</span></label>
                <input type="time" data-time-field="startsAt" required>
            </div>
        </div>

        <!-- 행사 종료 -->
        <div class="date-time-group">
            <div class="form-group">
                <label>행사 종료 날짜 <span>*</span></label>
                <input type="date" data-date-field="endsAt" required>
            </div>
            <div class="form-group">
                <label>행사 종료 시간 <span>*</span></label>
                <input type="time" data-time-field="endsAt" required>
            </div>
        </div>

        <!-- 모집 시작 -->
        <div class="date-time-group">
            <div class="form-group">
                <label>모집 시작 날짜 <span>*</span></label>
                <input type="date" data-date-field="applyStartAt" required>
            </div>
            <div class="form-group">
                <label>모집 시작 시간 <span>*</span></label>
                <input type="time" data-time-field="applyStartAt" required>
            </div>
        </div>

        <!-- 모집 마감 -->
        <div class="date-time-group">
            <div class="form-group">
                <label>모집 마감 날짜 <span>*</span></label>
                <input type="date" data-date-field="applyEndAt" required>
            </div>
            <div class="form-group">
                <label>모집 마감 시간 <span>*</span></label>
                <input type="time" data-time-field="applyEndAt" required>
            </div>
        </div>

        <!-- 서버 전달용 hidden -->
        <input type="hidden" data-field="startsAt">
        <input type="hidden" data-field="endsAt">
        <input type="hidden" data-field="applyStartAt">
        <input type="hidden" data-field="applyEndAt">
        <input type="hidden" data-field="minimumParticipants" value="1">
        <input type="hidden" data-field="minimumCheckAt">

        <div class="form-group">
            <label>정원 <span>*</span></label>
            <input type="number" data-field="capacity" min="1" required>
        </div>

        <!-- 참가비 -->
        <div class="form-group">
            <label>참가비 유형 <span>*</span></label>
            <select data-field="pricingType" required>
                <option value="">참가비 유형을 선택해 주세요.</option>
                <option value="FREE">무료</option>
                <option value="PAID">유료</option>
            </select>
        </div>

        <div class="form-group session-fee-area fee-area" hidden>
            <label>참가비 <span>*</span></label>
            <input type="number" data-field="fee" min="1" disabled>
        </div>
    </div>
</template>

<!-- 카카오 우편번호 서비스 -->
<script src="https://t1.kakaocdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>
<script>
    let addressSelected = false;

    document.getElementById("address-search-button")
            .addEventListener("click", function () {

                new daum.Postcode({
                    oncomplete: function (data) {

                        // 도로명 주소 우선, 없으면 지번 주소
                        const address = data.roadAddress || data.jibunAddress;

                        if (!address) {
                            alert("주소를 확인할 수 없습니다.");
                            return;
                        }

                        // 주소 입력
                        document.getElementById("address").value = address;

                        // 우편번호 저장
                        document.getElementById("postalCode").value = data.zonecode;

                        // 건물명이 제공되면 장소명으로 사용
                        document.getElementById("placeName").value =
                                data.buildingName || "";

                        addressSelected = true;
                    }
                }).open();
            });

    // 주소를 선택하지 않으면 행사 등록 차단
    document.getElementById("event-save-form")
            .addEventListener("submit", function (event) {

                if (!addressSelected) {
                    event.preventDefault();
                    alert("주소 검색을 통해 행사 장소를 선택해 주세요.");
                }
            }, true);

    const form = document.getElementById("event-save-form");

    let fieldErrorSequence = 0;

    // 특정 입력란에 오류 표시
    function showFieldError(input, message) {
        if (!input) return;

        let errorId = input.dataset.fieldErrorId;

        if (!errorId) {
            errorId = `event-save-field-error-${++fieldErrorSequence}`;
            input.dataset.fieldErrorId = errorId;
        }

        let errorElement = document.getElementById(errorId);

        if (!errorElement) {
            errorElement = document.createElement("p");
            errorElement.id = errorId;
            errorElement.className = "event-save-field-error";

            // 주소 검색 버튼이나 날짜 입력 레이아웃을 유지
            const group = input.closest(".form-group");

            if (group) {
                group.appendChild(errorElement);
            } else {
                input.insertAdjacentElement("afterend", errorElement);
            }
        }

        errorElement.textContent = message;
        errorElement.hidden = false;
        input.setAttribute("aria-invalid", "true");

        // 기존 도움말 연결은 유지하면서 오류 설명 추가
        const describedBy = new Set(
            (input.getAttribute("aria-describedby") || "")
                .split(/\s+/)
                .filter(Boolean)
        );

        describedBy.add(errorId);
        input.setAttribute("aria-describedby", [...describedBy].join(" "));
    }

    // 특정 입력란의 오류 해제
    function clearFieldError(input) {
        if (!input) return;

        input.removeAttribute("aria-invalid");

        const errorId = input.dataset.fieldErrorId;
        if (!errorId) return;

        const errorElement = document.getElementById(errorId);

        if (errorElement) {
            errorElement.textContent = "";
            errorElement.hidden = true;
        }

        const describedBy = (input.getAttribute("aria-describedby") || "")
            .split(/\s+/)
            .filter(id => id && id !== errorId);

        if (describedBy.length > 0) {
            input.setAttribute("aria-describedby", describedBy.join(" "));
        } else {
            input.removeAttribute("aria-describedby");
        }
    }

    // 폼 상단 공통 오류
    function showFormError(message) {
        const errorElement =
            document.getElementById("event-save-form-error");

        errorElement.textContent = message;
        errorElement.hidden = false;

        // 서버 오류는 특정 입력란에 속하지 않으므로 상단 안내로 이동한다.
        errorElement.scrollIntoView({ behavior: "smooth", block: "center" });
        errorElement.focus({ preventScroll: true });
    }

    // 제출 재시도 전 모든 오류 초기화
    function clearErrors() {
        form.querySelectorAll('[aria-invalid="true"]')
            .forEach(clearFieldError);

        const errorElement =
            document.getElementById("event-save-form-error");

        errorElement.textContent = "";
        errorElement.hidden = true;
    }

    // 첫 번째 오류 입력란으로 이동
    function focusFirstError() {
        const input = form.querySelector(
            '[aria-invalid="true"]:not([type="hidden"]):not(:disabled)'
        );

        if (input) {
            input.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            input.focus({ preventScroll: true });
        }
    }

    // 날짜·시간처럼 연관된 입력란 여러 개에 같은 오류 표시
    function showInputErrors(message, ...inputs) {
        inputs.forEach(input => showFieldError(input, message));
        focusFirstError();
    }

    // required, min, max 등 브라우저 기본 검증 오류도 같은 디자인으로 표시
    form.addEventListener("invalid", function (event) {
        let input = event.target;

        if (!input.matches("input, select, textarea")) return;

        event.preventDefault();

        // 라디오 그룹은 첫 번째 입력란에 오류를 모아 표시
        if (input.type === "radio") {
            const name = input.name;

            input = [...form.querySelectorAll('input[type="radio"]')]
                .find(radio => radio.name === name && !radio.disabled) || input;
        }

        const label = input.closest(".form-group")
            ?.querySelector("label")
            ?.textContent.replace(/\*/g, "").trim() || "필수 항목";

        let message = input.validationMessage || "입력 내용을 확인해주세요.";

        if (input.validity.valueMissing) {
            message = `${label} 항목을 입력하거나 선택해주세요.`;
        } else if (input.validity.rangeUnderflow) {
            message = `${input.min} 이상의 값을 입력해주세요.`;
        } else if (input.validity.rangeOverflow) {
            message = `${input.max} 이하의 값을 입력해주세요.`;
        } else if (input.validity.badInput) {
            message = "올바른 값을 입력해주세요.";
        } else if (input.validity.stepMismatch) {
            message = "허용된 단위에 맞는 값을 입력해주세요.";
        }

        showFieldError(input, message);

        // 여러 필수 항목에 오류가 발생해도 첫 항목만 포커스
        const firstInvalid = form.querySelector('[aria-invalid="true"]');

        if (firstInvalid === input) {
            input.focus();
        }
    }, true);

    // 수정 중에는 해당 필드의 기존 오류 표시 해제
    // 이벤트 위임이므로 나중에 추가한 회차 입력란에도 적용됨
    function clearEditedFieldError(event) {
        const input = event.target;

        if (!input.matches("input, select, textarea")) return;

        if (input.type === "radio") {
            form.querySelectorAll('input[type="radio"]').forEach(radio => {
                if (radio.name === input.name) {
                    clearFieldError(radio);
                }
            });
        } else {
            clearFieldError(input);
        }
    }

    form.addEventListener("input", clearEditedFieldError);
    form.addEventListener("change", clearEditedFieldError);

    const sessionArea = document.getElementById("session-area");
    const noSessionArea = document.getElementById("no-session-area");

    const sessionList = document.getElementById("session-list");
    const sessionTemplate = document.getElementById("session-template");

    const addSessionButton = document.getElementById("add-session-button");

    const startDate = document.getElementById("startDate");
    const endDate = document.getElementById("endDate");
    const startTime = document.getElementById("startTime");
    const endTime = document.getElementById("endTime");
    const capacity = document.getElementById("capacity");
    const noSessionStartsAt = document.getElementById("noSessionStartsAt");
    const noSessionEndsAt = document.getElementById("noSessionEndsAt");

    const applyStartDate = document.getElementById("applyStartDate");
    const applyStartTime = document.getElementById("applyStartTime");
    const applyEndDate = document.getElementById("applyEndDate");
    const applyEndTime = document.getElementById("applyEndTime");

    const applyStartAt = document.getElementById("applyStartAt");
    const applyEndAt = document.getElementById("applyEndAt");

    const pricingType = document.getElementById("pricingType");
    const feeArea = document.getElementById("fee-area");
    const fee = document.getElementById("fee");

    // 오늘 날짜 (브라우저 현지 날짜 기준)
    function getTodayString() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

    // 오늘보다 이전 날짜인지 확인
    function isPastDate(date) {
        return date < getTodayString();
    }

    // 날짜와 시간을 합쳐 LocalDateTime 문자열 생성
    function combineDateTime(date, time) {
        return `${date}T${time}`;
    }

    // 회차가 없는 행사 참가비 처리
    function updateNoSessionFee() {
        const isPaid = pricingType.value === "PAID";

        feeArea.hidden = !isPaid;
        fee.disabled = !isPaid || pricingType.disabled;
        fee.required = isPaid && !pricingType.disabled;

        if (!isPaid) {
            fee.value = "";
        }
    }

    pricingType.addEventListener("change", updateNoSessionFee);

    // 회차가 없는 행사 입력란 활성화
    function setNoSessionInputs(enabled) {
        const inputs = [
            startDate,
            endDate,
            startTime,
            endTime,
            capacity,
            applyStartDate,
            applyStartTime,
            applyEndDate,
            applyEndTime,
            pricingType
        ];

        inputs.forEach(input => {
            input.disabled = !enabled;
            input.required = enabled;
        });

        applyStartAt.disabled = !enabled;
        applyEndAt.disabled = !enabled;
        noSessionStartsAt.disabled = !enabled;
        noSessionEndsAt.disabled = !enabled;

        updateNoSessionFee();
    }

    // 회차별 참가비 처리
    function updateSessionFee(sessionItem, enabled) {
        const typeSelect =
                sessionItem.querySelector('[data-field="pricingType"]');

        const feeInput =
                sessionItem.querySelector('[data-field="fee"]');

        const feeArea =
                sessionItem.querySelector(".session-fee-area");

        const isPaid = typeSelect.value === "PAID";

        feeArea.hidden = !isPaid;
        feeInput.disabled = !enabled || !isPaid;
        feeInput.required = enabled && isPaid;

        if (!isPaid) {
            feeInput.value = "";
        }
    }

    // 회차 입력란 활성화 / 비활성화
    function setSessionInputs(enabled) {
        const sessionItems =
                sessionList.querySelectorAll(".session-item");

        sessionItems.forEach(item => {
            item.querySelectorAll("input:not([type='hidden']), select")
                    .forEach(input => {
                        input.disabled = !enabled;
                        input.required = enabled;
                    });

            item.querySelectorAll('input[type="hidden"]')
                    .forEach(input => {
                        input.disabled = !enabled;
                        input.required = false;
                    });

            updateSessionFee(item, enabled);
        });
    }

    // 회차 여부 선택
    document.querySelectorAll('input[name="hasSessions"]')
            .forEach(radio => {
                radio.addEventListener("change", function () {
                    if (this.value === "true") {
                        sessionArea.hidden = false;
                        noSessionArea.hidden = true;

                        setNoSessionInputs(false);

                        if (sessionList.children.length === 0) {
                            addSession();
                        }

                        setSessionInputs(true);
                    } else {
                        sessionArea.hidden = true;
                        noSessionArea.hidden = false;

                        setNoSessionInputs(true);
                        setSessionInputs(false);
                    }
                });
            });

    // 회차 추가
    function addSession() {
        const fragment = sessionTemplate.content.cloneNode(true);
        const sessionItem = fragment.querySelector(".session-item");

        sessionList.appendChild(fragment);

        updateSessionNames();

        sessionItem.querySelectorAll("input:not([type='hidden']), select")
                .forEach(input => {
                    input.disabled = false;
                    input.required = true;
                });

        sessionItem.querySelectorAll('input[type="hidden"]')
                .forEach(input => {
                    input.disabled = false;
                    input.required = false;
                });

        const sessionPricingType =
                sessionItem.querySelector('[data-field="pricingType"]');

        sessionPricingType.addEventListener("change", function () {
            updateSessionFee(sessionItem, true);
        });

        updateSessionFee(sessionItem, true);

        // 회차 삭제
        sessionItem.querySelector(".remove-session-button")
                .addEventListener("click", function () {
                    if (sessionList.children.length <= 1) {
                        alert("최소 한 개의 회차는 필요합니다.");
                        return;
                    }

                    sessionItem.remove();
                    updateSessionNames();
                });
    }

    // 회차 추가 버튼
    addSessionButton.addEventListener("click", function () {
        addSession();
    });

    // 회차 번호와 DTO 바인딩 이름 재정리
    function updateSessionNames() {
        const sessionItems =
                sessionList.querySelectorAll(".session-item");

        sessionItems.forEach((item, index) => {
            item.querySelector(".session-title").textContent =
                    `${index + 1}회차`;

            item.querySelectorAll("[data-field]").forEach(input => {
                const fieldName = input.dataset.field;
                input.name = `sessions[${index}].${fieldName}`;
            });
        });
    }

    // 과거 날짜를 검사하고, 문제가 있는 실제 날짜 입력란에 오류를 표시한다.
    // 서버 전달용 hidden 입력란이 아니라 화면에 보이는 input을 전달해야 한다.
    function validatePastDate(date, label, input) {
        if (isPastDate(date)) {
            showInputErrors(
                `${label}은(는) 오늘 이전 날짜로 설정할 수 없습니다.`,
                input
            );
            return false;
        }

        return true;
    }

    // 전송 중 더블클릭과 성공 직후 화면 이동 전 재제출을 막는다.
    let eventSaveSubmitting = false;
    let eventSaveCompleted = false;
    const eventSaveSubmitButton = form.querySelector('button[type="submit"]');
    const eventSaveSubmitLabel = eventSaveSubmitButton.textContent;

    // 뒤로 가기로 이 화면이 복원됐을 때도 제출 버튼을 다시 사용할 수 있게 한다.
    window.addEventListener("pageshow", function () {
        eventSaveSubmitting = false;
        eventSaveCompleted = false;
        eventSaveSubmitButton.disabled = false;
        eventSaveSubmitButton.textContent = eventSaveSubmitLabel;
    });

    // 폼 제출 전 검증: 실패하면 전송을 막고 현재 입력값과 파일 선택을 유지한다.
    // required/min 등의 기본 검증은 위 invalid 이벤트가, 날짜 관계는 여기서 처리한다.
    form.addEventListener("submit", async function (event) {
        // 앞의 주소 전용 검사에서 alert를 띄워 전송을 막았다면 여기서는 중단한다.
        if (event.defaultPrevented) return;

        // 기본 페이지 이동을 항상 막고, 검증에 성공한 경우에만 Fetch로 전송한다.
        event.preventDefault();
        if (eventSaveSubmitting || eventSaveCompleted) return;

        // 재시도할 때 이전 날짜 오류와 공통 오류를 지우고 새로 검사한다.
        clearErrors();

        const selectedType =
                document.querySelector('input[name="hasSessions"]:checked');

        if (!selectedType) {
            event.preventDefault();
            showInputErrors(
                "회차 운영 여부를 선택해주세요.",
                form.querySelector('input[name="hasSessions"]')
            );
            return;
        }

        // 회차가 없는 행사
        if (selectedType.value === "false") {

            // 값뿐 아니라 입력 요소도 보관해야 오류를 해당 입력란에 연결할 수 있다.
            const dateFields = [
                { input: startDate, label: "행사 시작일" },
                { input: endDate, label: "행사 종료일" },
                { input: applyStartDate, label: "모집 시작일" },
                { input: applyEndDate, label: "모집 마감일" }
            ];

            for (const field of dateFields) {
                if (!validatePastDate(
                        field.input.value,
                        field.label,
                        field.input
                )) {
                    event.preventDefault();
                    return;
                }
            }

            // 분리된 날짜·시간을 서버가 받는 LocalDateTime 형식으로 합친다.
            noSessionStartsAt.value = combineDateTime(startDate.value, startTime.value);
            noSessionEndsAt.value = combineDateTime(endDate.value, endTime.value);

            // 같은 날짜에도 종료 시간이 시작 시간보다 빠를 수 없음
            if (noSessionStartsAt.value > noSessionEndsAt.value) {
                event.preventDefault();
                showInputErrors(
                    "행사 종료 일시는 시작 일시보다 빠를 수 없습니다.",
                    endDate,
                    endTime
                );
                return;
            }

            // 모집 날짜 + 시간 합치기
            applyStartAt.value =
                    combineDateTime(applyStartDate.value, applyStartTime.value);

            applyEndAt.value =
                    combineDateTime(applyEndDate.value, applyEndTime.value);

            // 모집 시작일시와 마감일시 비교
            if (applyStartAt.value > applyEndAt.value) {
                event.preventDefault();
                showInputErrors(
                    "모집 마감일시는 모집 시작일시보다 빠를 수 없습니다.",
                    applyEndDate,
                    applyEndTime
                );
                return;
            }

            // 모집 마감일은 행사 시작일보다 늦을 수 없음
            // 같은 날짜 허용 x
            if (applyEndDate.value >= startDate.value) {
                event.preventDefault();
                showInputErrors(
                    "모집 마감일은 행사 시작일보다 빨라야 합니다.",
                    applyEndDate
                );
                return;
            }
        }

        // 회차가 있는 행사
        if (selectedType.value === "true") {
            const sessionItems =
                    sessionList.querySelectorAll(".session-item");

            // 서버 EventRequest.SaveDto와 동일하게 다회차는 최소 2개를 요구한다.
            // 필드 하나의 문제가 아니므로 폼 상단에 안내하고 추가 버튼으로 이동한다.
            if (sessionItems.length < 2) {
                event.preventDefault();
                showFormError("회차가 있는 행사는 최소 2개 회차를 등록해주세요.");
                addSessionButton.focus();
                return;
            }

            for (let index = 0; index < sessionItems.length; index++) {
                const item = sessionItems[index];

                const fields = [
                    "startsAt",
                    "endsAt",
                    "applyStartAt",
                    "applyEndAt"
                ];

                const values = {};

                // 날짜와 시간 합치기
                for (const field of fields) {
                    // 오류는 화면의 날짜 input에 표시하고, 합친 값은 hidden에 저장한다.
                    const dateInput = item.querySelector(
                            `[data-date-field="${field}"]`
                    );
                    const date = dateInput.value;

                    const time = item.querySelector(
                            `[data-time-field="${field}"]`
                    ).value;

                    // 과거 날짜 검사
                    const labels = {
                        startsAt: "행사 시작일",
                        endsAt: "행사 종료일",
                        applyStartAt: "모집 시작일",
                        applyEndAt: "모집 마감일"
                    };

                    if (!validatePastDate(date, `${index + 1}회차 ${labels[field]}`, dateInput)) {
                        event.preventDefault();
                        return;
                    }

                    const combined = combineDateTime(date, time);

                    item.querySelector(
                            `[data-field="${field}"]`
                    ).value = combined;

                    values[field] = combined;
                }

                // 최소 인원 확인 기준일은 행사 시작일
                item.querySelector(
                        '[data-field="minimumCheckAt"]'
                ).value = values.startsAt;

                // 행사 종료일시는 시작일시보다 빠를 수 없음
                if (values.startsAt > values.endsAt) {
                    event.preventDefault();
                    // 현재 회차의 종료 날짜·시간만 강조한다. 다른 회차는 건드리지 않는다.
                    showInputErrors(
                        `${index + 1}회차 행사 종료 일시는 시작 일시보다 빠를 수 없습니다.`,
                        item.querySelector('[data-date-field="endsAt"]'),
                        item.querySelector('[data-time-field="endsAt"]')
                    );
                    return;
                }

                // 모집 마감일시는 모집 시작일시보다 빠를 수 없음
                if (values.applyStartAt > values.applyEndAt) {
                    event.preventDefault();
                    showInputErrors(
                        `${index + 1}회차 모집 마감 일시는 모집 시작일시보다 빠를 수 없습니다.`,
                        item.querySelector('[data-date-field="applyEndAt"]'),
                        item.querySelector('[data-time-field="applyEndAt"]')
                    );
                    return;
                }

                // 모집 마감일은 행사 시작일보다 반드시 빨라야 함
                const applyEndDateValue = values.applyEndAt.substring(0, 10);
                const eventStartDateValue = values.startsAt.substring(0, 10);

                if (applyEndDateValue >= eventStartDateValue) {
                    event.preventDefault();
                    showInputErrors(
                        `${index + 1}회차 모집 마감일은 행사 시작일보다 빨라야 합니다.`,
                        item.querySelector('[data-date-field="applyEndAt"]')
                    );
                    return;
                }
            }
        }

        // 입력란을 비활성화하면 FormData에서 빠지므로 제출 버튼만 잠근다.
        eventSaveSubmitting = true;
        eventSaveSubmitButton.disabled = true;
        eventSaveSubmitButton.textContent = "신청 중…";

        try {
            const response = await fetch(form.action, {
                method: "POST",
                credentials: "same-origin",
                // 이 헤더가 EventSaveApiController를 선택한다.
                headers: {
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                // multipart 경계값은 브라우저가 설정하므로 Content-Type은 지정하지 않는다.
                body: new FormData(form),
                redirect: "error"
            });

            const contentType = response.headers.get("Content-Type") || "";
            const result = contentType.includes("application/json")
                ? await response.json()
                : null;

            if (!response.ok) {
                // JSON이 아닌 오류 응답(업로드 제한 등)도 현재 화면에서 안내한다.
                let message = "요청 처리 중 오류가 발생했습니다. 입력 내용은 유지됩니다.";
                if (response.status === 401) {
                    message = "로그인이 만료되었습니다. 새 탭에서 로그인한 뒤 다시 신청해주세요.";
                } else if (response.status === 403) {
                    message = "기업 계정과 행사 등록 권한을 확인해주세요.";
                } else if (response.status === 413) {
                    message = "업로드 가능한 파일 용량을 초과했습니다. 더 작은 파일을 선택해주세요.";
                }

                showFormError(typeof result?.message === "string" ? result.message : message);
                return;
            }

            // HTML 응답 등을 등록 성공으로 오인하지 않고 서버의 성공 계약을 확인한다.
            if (result?.redirectUrl !== "/events") {
                showFormError("등록 결과를 확인할 수 없습니다. 재신청 전 주최 행사 목록을 확인해주세요.");
                return;
            }

            eventSaveCompleted = true;
            window.location.assign(result.redirectUrl);
        } catch (error) {
            // 통신 실패는 서버 저장 여부를 확정할 수 없으므로 자동 재시도하지 않는다.
            showFormError("등록 결과를 확인하지 못했습니다. 연결 상태와 주최 행사 목록을 확인해주세요. 입력 내용은 유지됩니다.");
        } finally {
            // 실패해도 reset()이나 화면 재생성을 하지 않아 입력값·선택 파일을 유지한다.
            if (!eventSaveCompleted) {
                eventSaveSubmitting = false;
                eventSaveSubmitButton.disabled = false;
                eventSaveSubmitButton.textContent = eventSaveSubmitLabel;
            }
        }
    });
</script>

{{> layout/footer}}
</body>
</html>
