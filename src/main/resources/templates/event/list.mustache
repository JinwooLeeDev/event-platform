<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>행사 찾기 | Busan Play</title>
</head>
<body>
{{> layout/header}}
{{> layout/main-style}}
<style>
    .event-list-page { min-height: 70vh; }
    .event-list-page .main-events { padding-top: 36px; }
    .list-breadcrumb { margin-bottom: 24px; color: #72757e; font-size: 12px; }
    .list-breadcrumb a { color: inherit; text-decoration: none; }
    .event-list-page h1 { margin: 8px 0 12px; font-size: clamp(26px,3vw,36px); letter-spacing: -1px; }
    .list-description { margin: 0; color: #72757e; font-size: 14px; line-height: 1.75; }
    .list-search { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; padding: 20px; margin: 26px 0; border: 1px solid #e6e7eb; border-radius: 16px; background: white; }
    .list-search input[type='search'] { flex: 1; min-width: 160px; border: 1px solid #d9dbe1; border-radius: 10px; padding: 12px 14px; font: inherit; }
    .list-button { display: inline-flex; justify-content: center; align-items: center; padding: 12px 20px; border: 1px solid #0750d8; border-radius: 10px; background: #0750d8; color: white; text-decoration: none; font: inherit; font-size: 14px; cursor: pointer; }
    .list-reset { color: #626772; font-size: 13px; padding: 10px; text-underline-offset: 4px; }
    .list-result { margin-bottom: 22px; font-size: 14px; color: #626772; overflow-wrap: anywhere; }
    .list-result strong { color: #292f3d; }
    .list-pagination { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 32px; }
    .list-pagination a, .list-pagination span { padding: 9px 13px; min-width: 40px; text-align: center; border: 1px solid #e6e7eb; border-radius: 9px; background: white; color: #555c68; text-decoration: none; font-size: 14px; }
    .list-pagination a[aria-current='page'] { background: #0750d8; border-color: #0750d8; color: white; }
    .list-pagination span[aria-disabled='true'] { color: #9498a0; background: #f1f2f4; }
    .event-list-page a:focus-visible, .event-list-page button:focus-visible, .event-list-page input:focus-visible { outline: 3px solid #9cbfff; outline-offset: 3px; }
    .event-list-page [hidden] { display: none !important; }
    .list-layout { display: grid; grid-template-columns: 210px minmax(0,1fr); gap: 32px; margin-top: 30px; align-items: start; }
    .list-sidebar { padding: 24px 16px; border: 1px solid #e6e7eb; border-radius: 16px; background: white; }
    .list-sidebar h2 { margin: 8px 10px 20px; font-size: 20px; }
    .list-sidebar .main-events__eyebrow { margin-left: 10px; }
    .list-sidebar form { margin: 0 0 6px; }
    .list-category { width: 100%; padding: 13px 12px; border: 0; border-radius: 10px; text-align: left; background: transparent; color: #626772; font: inherit; font-size: 14px; cursor: pointer; }
    .list-category:hover { background: #f5f5f6; }
    .list-category.is-selected { color: #0750d8; font-weight: 700; background: #eef1f6; }
    .list-content { min-width: 0; }
    .event-list-page .event-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    @media(max-width:1100px) { .event-list-page .event-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
    @media(max-width:760px) { .list-layout { grid-template-columns: minmax(0,1fr); gap: 24px; } .list-sidebar nav { display: flex; gap: 6px; flex-wrap: wrap; } .list-category { width: auto; } }
    @media(max-width:600px) { .event-list-page .event-grid { grid-template-columns: minmax(0,1fr); } }
</style>
<main class="main-page event-list-page">
    <section class="main-events" aria-labelledby="list-title">
        <nav class="list-breadcrumb" aria-label="현재 위치"><a href="/">홈</a> / 행사 찾기</nav>
        <p class="main-events__eyebrow">DISCOVER BUSAN</p>
        <h1 id="list-title">부산의 새로운 즐거움을 찾아보세요.</h1>
        <p class="list-description">전시부터 공연, 축제까지. 지금 공개된 행사를 만나보세요.</p>

        <div class="list-layout">
            <aside class="list-sidebar" aria-labelledby="category-title">
                <p class="main-events__eyebrow">EXPLORE</p>
                <h2 id="category-title">카테고리</h2>
                <nav aria-label="행사 카테고리">
                    <form action="/events/list" method="get"><input type="hidden" name="keyword" value="{{keyword}}"><button class="list-category {{#allCategories}}is-selected{{/allCategories}}" type="submit" {{#allCategories}}aria-current="true"{{/allCategories}}>전체 행사</button></form>
                    {{#categories}}
                    <form action="/events/list" method="get"><input type="hidden" name="keyword" value="{{keyword}}"><button class="list-category {{#selected}}is-selected{{/selected}}" name="categoryId" value="{{id}}" type="submit" {{#selected}}aria-current="true"{{/selected}}>{{name}}</button></form>
                    {{/categories}}
                </nav>
            </aside>
            <div class="list-content">
        <p class="list-result" role="status">{{#isSearch}}‘<strong>{{keyword}}</strong>’ 검색 결과 · {{/isSearch}}전체 <strong>{{eventPage.totalElements}}</strong>개</p>
        <div class="event-grid">
            {{#eventPage.eventList}}{{> layout/event-card}}{{/eventPage.eventList}}
        </div>
        {{^eventPage.eventList}}
        <div class="main-events__empty">
            {{#isSearch}}<h2>검색 결과가 없습니다.</h2><p>다른 검색어를 입력하거나 전체 행사를 확인해주세요.</p>{{/isSearch}}
            {{^isSearch}}<h2>표시할 행사가 없습니다.</h2><p>공개된 행사가 없거나 요청한 페이지에 내역이 없습니다.</p>{{/isSearch}}
            <a class="list-button" href="/events/list">전체 행사 보기</a>
        </div>
        {{/eventPage.eventList}}
        <nav id="list-pagination" class="list-pagination" aria-label="행사 목록 페이지"
             data-current="{{eventPage.currentPage}}" data-total="{{eventPage.totalPages}}" data-size="{{eventPage.size}}" data-keyword="{{keyword}}" data-category="{{categoryId}}" hidden></nav>
        <noscript>
    
        </noscript>
            </div>
        </div>
    </section>
</main>
{{> layout/footer}}
<script>
(() => {
    const nav = document.getElementById('list-pagination');
    const headerForm = document.querySelector('.header-search');
    if (headerForm) {
        headerForm.querySelector('[name="keyword"]').value = nav.dataset.keyword;
        if (nav.dataset.category) {
            const category = document.createElement('input'); category.type = 'hidden'; category.name = 'categoryId'; category.value = nav.dataset.category; headerForm.append(category);
        }
    }
    const current = Number(nav.dataset.current), total = Number(nav.dataset.total);
    if (!Number.isInteger(total) || total < 1) return;
    function item(label, page, selected = false) {
        const valid = page >= 1 && page <= total;
        const element = document.createElement(valid ? 'a' : 'span');
        element.textContent = label;
        if (valid) {
            const query = new URLSearchParams({page: String(page), size: nav.dataset.size, keyword: nav.dataset.keyword});
            if (nav.dataset.category) query.set('categoryId', nav.dataset.category);
            element.href = '/events/list?' + query.toString();
            if (selected) element.setAttribute('aria-current', 'page');
            element.setAttribute('aria-label', label === '이전' || label === '다음' ? label + ' 페이지' : page + '페이지');
        } else element.setAttribute('aria-disabled', 'true');
        nav.append(element);
    }
    item('이전', current - 1);
    const start = Math.max(1, Math.min(current - 2, total - 4));
    for (let page = start; page <= Math.min(total, start + 4); page++) item(String(page), page, page === current);
    item('다음', current + 1);
    nav.hidden = false;
})();
</script>
</body>
</html>
