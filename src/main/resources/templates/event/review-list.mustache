{{> layout/head-meta}}
{{> layout/header}}
{{> event/review-style}}

<main class="review-page">
    <section class="review-section">
        <h2>{{i18n.event.ui0079}}</h2>

        <div class="review-sort">
            <a href="/event-review/{{eventSessionId}}?sort=latest"
               class="{{#isLatest}}active{{/isLatest}}">
                {{i18n.event.ui0080}}
            </a>
            <a href="/event-review/{{eventSessionId}}?sort=like"
               class="{{#isLike}}active{{/isLike}}">
                {{i18n.event.ui0081}}
            </a>
        </div>

        <div class="review-write">
            <h3>{{i18n.event.ui0082}}</h3>
            <form action="/event-review/save/{{eventSessionId}}" method="post">
                <textarea name="content"
                          placeholder="{{i18n.event.ui0040}}"
                          required></textarea>
                <button type="submit">{{i18n.event.ui0083}}</button>
            </form>
        </div>

        <div class="review-list">
            {{#reviewList}}
                <article class="review-item">
                    <div class="review-header">
                        <strong>{{displayName}}</strong>
                        <span>{{createdAt}}</span>
                    </div>

                    <p>{{content}}</p>

                    <div class="review-actions">
                        <form action="/event-review/like/{{id}}" method="post">
                            <button type="submit"
                                    class="review-like-btn {{#isLiked}}liked{{/isLiked}}">
                                {{i18n.event.ui0084}} {{likeCount}}
                            </button>
                        </form>
                    </div>
                </article>
            {{/reviewList}}

            {{^reviewList}}
                <p class="empty-review">
                    {{i18n.event.ui0085}}
                </p>
            {{/reviewList}}
        </div>
    </section>
</main>
{{#message}}
    <script>
        alert('{{message}}');
    </script>
{{/message}}

{{> layout/footer}}