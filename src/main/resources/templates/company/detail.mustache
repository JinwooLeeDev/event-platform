<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.company.ui0001}}</title></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/workspace-style}}
<main class="company-workspace company-home"><div class="account-layout">
    {{> layout/company-nav}}
    <div class="account-content">
        <header class="company-heading"><div><p class="company-location">{{i18n.common.companyPage}}</p><h1>{{i18n.company.ui0003}}</h1><p class="company-description">{{i18n.company.ui0004}}</p></div></header>
        {{#company}}
        {{#reviewReason}}<div class="company-feedback" role="note"><strong>{{i18n.company.ui0005}}</strong><p>{{reviewReason}}</p><a class="company-button company-button--secondary" href="/company/update">{{i18n.company.ui0006}}</a></div>{{/reviewReason}}
        <div class="company-overview">
            <section class="company-panel company-wallet" aria-labelledby="company-point-title">
                <span class="company-point-symbol" aria-hidden="true">P</span>
                <h2 id="company-point-title">{{i18n.admin.ui0165}}</h2>
                <strong>{{pointText}}</strong>
                <p>{{i18n.company.ui0007}}</p>
                <a class="company-button company-button--secondary" href="/charge">{{i18n.company.ui0008}} <span aria-hidden="true">+</span></a>
                <a class="company-button company-button--secondary"
                   href="/company/points"
                   style="margin-top:10px;">
                    {{i18n.company.ui0009}}
                    <span aria-hidden="true">›</span>
                </a>
            </section>

        <section class="company-panel company-quick"><h2>{{i18n.company.ui0010}}</h2><a href="/events"><span><strong>{{i18n.company.ui0011}}</strong><small>{{i18n.company.ui0012}}</small></span><span aria-hidden="true">›</span></a><a href="/events/save"><span><strong>{{i18n.company.ui0013}}</strong><small>{{i18n.company.ui0014}}</small></span><span aria-hidden="true">›</span></a></section></div>
        <section class="company-panel company-profile"><div class="company-panel-heading"><div><h2>{{name}}</h2><p class="company-description">{{i18n.company.ui0015}}</p></div><div>{{#pending}}<span class="company-state">{{i18n.company.ui0016}}</span>{{/pending}}{{#approved}}<span class="company-state company-state--approved">{{i18n.company.ui0017}}</span>{{/approved}}{{#feedbackNeeded}}<span class="company-state company-state--warning">{{i18n.company.ui0018}}</span>{{/feedbackNeeded}}{{#rejected}}<span class="company-state company-state--danger">{{i18n.company.ui0019}}</span>{{/rejected}}{{#suspended}}<span class="company-state company-state--danger">{{i18n.company.ui0020}}</span>{{/suspended}}</div></div><dl class="company-profile-facts"><div><dt>{{i18n.admin.ui0033}}</dt><dd>{{email}}</dd></div><div><dt>{{i18n.admin.ui0020}}</dt><dd>{{businessNumber}}</dd></div><div><dt>{{i18n.company.ui0021}}</dt><dd>{{representativeName}}</dd></div><div><dt>{{i18n.company.ui0022}}</dt><dd>{{address}}</dd></div></dl><a class="company-button company-button--secondary" href="/company/update">{{i18n.company.ui0006}}</a></section>
        <section class="company-panel company-profile"><h2>{{i18n.company.ui0023}}</h2><dl class="company-profile-facts"><div><dt>{{i18n.company.ui0024}}</dt><dd>{{contactPersonName}}</dd></div><div><dt>{{i18n.admin.ui0039}}</dt><dd>{{contactPersonPhone}}</dd></div></dl><p class="company-description">{{i18n.company.ui0025}}</p></section>
        {{/company}}
        {{^company}}<div class="company-empty"><h2>{{i18n.company.ui0026}}</h2><p>{{i18n.company.ui0027}}</p><a class="company-button company-button--secondary" href="/login?type=company">{{i18n.company.ui0028}}</a></div>{{/company}}
    </div>
</div></main>
{{> layout/footer}}
</body>
</html>
