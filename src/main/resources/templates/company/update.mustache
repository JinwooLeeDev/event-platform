<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>기업 계정·담당자 정보 수정 | Busan Play</title>
</head>
<body>
{{> layout/header}}
{{> layout/company-style}}
{{> layout/account-style}}
<style>
    .company-settings { padding: 40px 24px 60px; background: #f8f9fb; color: #292f3d; font-family: 'Pretendard',sans-serif; }
    .company-settings .company-card { max-width: none; width: 100%; padding: 30px; border: 1px solid #e6e7eb; border-radius: 18px; background: white; }
    .company-settings fieldset { margin: 24px 0; padding: 22px; border: 1px solid #e6e7eb; border-radius: 12px; }
    .company-settings legend { width: auto; padding: 0 8px; font-size: 17px; font-weight: 700; }
    .company-settings .company-description { color: #72757e; font-size: 14px; line-height: 1.75; }
    @media(max-width:600px) { .company-settings { padding: 28px 16px 40px; } .company-settings .company-card { padding: 22px; } .company-settings fieldset { padding: 16px; } }

    .company-settings input.certificate-error {
        border: 2px solid #b42318;
        animation: company-certificate-shake .3s ease;
    }

    @keyframes company-certificate-shake {
        0%, 100% { transform: translateX(0); }
        25%, 75% { transform: translateX(-4px); }
        50% { transform: translateX(4px); }
    }

    @media (prefers-reduced-motion: reduce) {
        .company-settings input.certificate-error {
            animation: none;
        }
    }

    .company-review-feedback {
        margin: 20px 0;
        padding: 18px 20px;
        border: 1px solid #f2c5c5;
        border-radius: 12px;
        background: #fff5f5;
        color: #912626;
    }

    .company-review-feedback p {
        margin: 8px 0 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.7;
    }
</style>
{{> company/workspace-style}}
<main class="company-settings company-workspace">
    <div class="account-layout">
        {{> layout/company-nav}}
        <section class="company-card account-content">
            <h1>계정·담당자 정보 수정</h1>
            <p class="company-description">
                계정·담당자 정보와 기업 인증정보를 변경할 수 있습니다.<br>
                사업자 정보를 변경하려면 재검증과 새 사업자등록증 제출이 필요합니다.
            </p>
            <form id="updateForm" action="/company/update" method="post" enctype="multipart/form-data">
                {{#company}}

                {{#reviewReason}}
                <div class="company-review-feedback" role="note">
                    <strong>관리자 보완 요청</strong>
                    <p>{{reviewReason}}</p>
                </div>
                {{/reviewReason}}

                <fieldset>
                    <legend>계정 정보</legend>

                    <div class="auth-field">
                        <label for="email">이메일</label>

                        <div class="auth-row company-verification-row">
                            <input id="email"
                                   name="email"
                                   type="email"
                                   value="{{email}}"
                                   maxlength="254"
                                   autocomplete="username"
                                   required>

                            <button id="sendEmailCode"
                                    class="auth-button secondary"
                                    type="button"
                                    hidden>
                                인증번호 발송
                            </button>
                        </div>
                    </div>

                    <div id="emailVerificationSection" class="auth-field" hidden>
                        <label for="emailCode">인증번호</label>

                        <div class="auth-row company-verification-row">
                            <input id="emailCode"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="6"
                                   placeholder="숫자 6자리">

                            <button id="confirmEmailCode"
                                    class="auth-button secondary"
                                    type="button">
                                인증 확인
                            </button>
                        </div>
                    </div>

                    <p id="emailMessage"
                       class="auth-message"
                       role="status"
                       aria-live="polite">
                        이메일을 변경하려면 새 주소를 인증해주세요.
                    </p>

                    <p>
                        <label for="password">새 비밀번호</label><br>
                        <input id="password"
                               name="password"
                               type="password"
                               autocomplete="new-password"
                               minlength="8"
                               maxlength="16">
                        <br>
                        <small>변경할 경우에만 입력하세요. 영문·숫자·특수문자($@!%*#?&)를 포함한 8~16자입니다.</small>
                    </p>

                    <div class="auth-field">
                        <label for="passwordConfirm">새 비밀번호 확인</label><br>
                        <input id="passwordConfirm"
                               type="password"
                               autocomplete="new-password">

                        <p id="passwordMatchMessage"
                           class="auth-message"
                           role="status"
                           aria-live="polite"></p>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>담당자 정보</legend>

                    <p>
                        <label for="contactPersonName">담당자 이름</label><br>
                        <input id="contactPersonName"
                               name="contactPersonName"
                               value="{{contactPersonName}}"
                               maxlength="20"
                               required>
                    </p>

                    <p>
                        <label for="contactPersonPhone">담당자 연락처</label><br>
                        <input id="contactPersonPhone"
                               name="contactPersonPhone"
                               type="tel"
                               value="{{contactPersonPhone}}"
                               maxlength="13"
                               required>
                    </p>
                </fieldset>
                <fieldset id="businessInformation"
                          data-pending="{{#pending}}true{{/pending}}{{^pending}}false{{/pending}}">
                    <legend>사업자 정보 — 변경 시 재심사</legend>

                    {{#pending}}
                    <p class="company-description">
                        검토 중에는 기업 인증 정보 수정이 불가합니다.
                    </p>
                    {{/pending}}

                    <div class="auth-field">
                        <label for="businessNumber">사업자등록번호</label>
                        <input id="businessNumber"
                               name="businessNumber"
                               value="{{businessNumber}}"
                               type="text"
                               inputmode="numeric"
                               pattern="[0-9]{10}"
                               minlength="10"
                               maxlength="10"
                               {{#pending}}readonly{{/pending}}
                        required>
                    </div>

                    <div class="auth-field">
                        <label for="representativeName">대표자명</label>
                        <input id="representativeName"
                               name="representativeName"
                               value="{{representativeName}}"
                               maxlength="50"
                               {{#pending}}readonly{{/pending}}
                        required>
                    </div>

                    <div class="auth-field">
                        <label for="openedOn">개업일자</label>
                        <input id="openedOn"
                               name="openedOn"
                               value="{{openedOn}}"
                               type="date"
                               {{#pending}}readonly{{/pending}}
                        required>
                    </div>

                    <div class="auth-field">
                        <button id="checkBusinessButton"
                                class="auth-button secondary"
                                type="button"
                                {{#pending}}disabled{{/pending}}>
                        사업자 정보 검증
                        </button>

                        <p id="businessVerificationMessage"
                           class="auth-message"
                           role="status"
                           aria-live="polite">
                            사업자 정보를 변경한 경우 검증해주세요.
                        </p>
                    </div>

                    <div class="auth-field">
                        <label for="certificate">새 사업자등록증</label>
                        <input id="certificate"
                               name="businessCertificate"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png"
                               aria-describedby="certificateMessage"
                               {{#pending}}disabled{{/pending}}>

                        <small>
                            사업자 정보 변경 시 필수입니다.
                            PDF·JPG·JPEG·PNG, 최대 10MB까지 첨부할 수 있습니다.
                        </small>

                        <p id="certificateMessage"
                           class="auth-message"
                           role="alert"></p>
                    </div>
                </fieldset>

                {{/company}}
                <p id="formMessage" class="auth-message" role="alert"></p>
                <div class="company-form-actions"><button id="company-save" type="submit">수정 저장</button><a class="company-cancel-button" href="/company/detail">취소</a></div>

            </form>

        </section>
    </div>
</main>
{{> layout/footer}}
<script>
    (() => {
        const get = id => document.getElementById(id);

        // 수정 폼과 계정 정보
        const form = get("updateForm");
        const email = get("email");
        const password = get("password");
        const confirmation = get("passwordConfirm");
        const save = get("company-save");
        const formMessage = get("formMessage");
        const passwordMessage = get("passwordMatchMessage");

        // 이메일 인증 요소
        const send = get("sendEmailCode");
        const confirm = get("confirmEmailCode");
        const code = get("emailCode");
        const emailMessage = get("emailMessage");
        const emailSection = get("emailVerificationSection");

        // 사업자 검증 요소
        const businessSection = get("businessInformation");
        const businessNumber = get("businessNumber");
        const representativeName = get("representativeName");
        const openedOn = get("openedOn");
        const businessButton = get("checkBusinessButton");
        const businessMessage = get("businessVerificationMessage");

        // 사업자등록증 파일
        const certificate = get("certificate");
        const certificateMessage = get("certificateMessage");

        // 서버가 렌더링한 현재 심사 대기 여부
        const pending = businessSection.dataset.pending === "true";

        // 파일은 value가 아닌 files로 검사하므로 별도 처리
        const fields = Array.from(
            form.querySelectorAll('input[name]:not([type="file"])')
        );

        const businessFields = [
            businessNumber,
            representativeName,
            openedOn
        ];

        // 인증 성공 기록과 요청 진행 상태
        let verifiedEmail = null;
        let verifiedBusiness = null;
        let businessVerifiedUntil = 0;
        let busy = false;
        let submitting = false;

        // 안내 문구와 표시 상태 변경
        function message(element, text, state = "") {
            element.textContent = text;
            element.dataset.state = state;
        }

        function emailChanged() {
            return email.value !== email.defaultValue;
        }

        // 서버에 저장돼 있던 값과 현재 입력값 비교
        function businessChanged() {
            return businessFields.some(
                input => input.value !== input.defaultValue
            );
        }

        // 한 항목만 변경했어도 API 검사에는 세 항목 모두 전달
        function currentBusinessInfo() {
            return {
                businessNumber: businessNumber.value,
                representativeName: representativeName.value.trim(),
                openedOn: openedOn.value
            };
        }

        // 현재 정보로 검증받았고 유효시간이 남아 있는지 확인
        function isBusinessVerified() {
            return verifiedBusiness !== null
                && verifiedBusiness === JSON.stringify(currentBusinessInfo())
                && Date.now() < businessVerifiedUntil;
        }

        // 화면에 보관한 사업자 검증 성공 기록 초기화
        function resetBusinessVerification() {
            verifiedBusiness = null;
            businessVerifiedUntil = 0;
        }

        // 인증 요청 중에는 다른 요청과 저장을 막음
        function syncButtons() {
            const blocked = busy || submitting;

            send.hidden = !emailChanged();
            send.disabled = blocked || verifiedEmail === email.value;

            confirm.disabled =
                blocked
                || emailSection.hidden
                || verifiedEmail === email.value;

            businessButton.disabled = blocked || pending;

            save.disabled = blocked;
            save.textContent = submitting ? "저장 중…" : "수정 저장";

            // 사업자 정보 변경 시에만 새 파일 필수
            certificate.required = !pending && businessChanged();
            certificate.disabled = pending || submitting;
        }

        // 이메일 변경 시 이전 인증 결과 초기화
        function syncEmail() {
            verifiedEmail = null;
            code.value = "";
            emailSection.hidden = true;

            message(
                emailMessage,
                emailChanged()
                    ? "새 이메일 주소로 인증을 완료해주세요."
                    : "이메일을 변경하려면 새 주소를 인증해주세요."
            );

            syncButtons();
        }

        // 파일 오류 안내와 붉은 테두리·애니메이션 표시
        function showCertificateError(text) {
            message(certificateMessage, text, "error");
            certificate.setAttribute("aria-invalid", "true");

            certificate.classList.remove("certificate-error");
            void certificate.offsetWidth;
            certificate.classList.add("certificate-error");
        }

        function clearCertificateError() {
            message(certificateMessage, "");
            certificate.removeAttribute("aria-invalid");
            certificate.classList.remove("certificate-error");
        }

        // 파일이 정상이면 null, 문제가 있으면 안내 문구 반환
        function validateCertificate() {
            const file = certificate.files[0];

            if (!file) {
                return businessChanged()
                    ? "사업자 정보를 변경하려면 새 사업자등록증을 첨부해주세요."
                    : null;
            }

            if (file.size === 0) {
                return "비어 있는 파일은 첨부할 수 없습니다.";
            }

            if (file.size > 10 * 1024 * 1024) {
                return "파일 크기는 10MB 이하여야 합니다.";
            }

            if (!/\.(pdf|jpe?g|png)$/i.test(file.name)) {
                return "PDF·JPG·JPEG·PNG 파일만 첨부할 수 있습니다.";
            }

            return null;
        }

        // 이메일·사업자 인증에서 공통으로 사용하는 JSON 요청
        async function post(url, body) {
            const response = await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(body)
            });

            let result;

            try {
                result = await response.json();
            } catch {
                throw new Error(
                    "요청을 처리하지 못했습니다. 잠시 후 다시 시도해주세요."
                );
            }

            if (!response.ok) {
                throw new Error(result.message || "요청에 실패했습니다.");
            }

            return result;
        }

        email.addEventListener("input", syncEmail);

        // 이메일 인증번호 발송
        send.addEventListener("click", async () => {
            if (busy || submitting || !email.reportValidity()) {
                return;
            }

            const target = email.value;

            verifiedEmail = null;
            busy = true;
            email.readOnly = true;

            syncButtons();
            message(emailMessage, "인증번호를 발송하고 있습니다.");

            try {
                const result = await post(
                    "/api/v1/email-verifications",
                    { email: target }
                );

                if (email.value !== target) {
                    return;
                }

                code.value = "";
                emailSection.hidden = false;

                message(emailMessage, result.message, "success");
                code.focus();
            } catch (error) {
                message(emailMessage, error.message, "error");
            } finally {
                email.readOnly = false;
                busy = false;
                syncButtons();
            }
        });

        // 이메일 인증번호 확인
        confirm.addEventListener("click", async () => {
            if (busy || submitting) {
                return;
            }

            if (!/^[0-9]{6}$/.test(code.value)) {
                message(
                    emailMessage,
                    "인증번호 숫자 6자리를 입력해주세요.",
                    "error"
                );
                code.focus();
                return;
            }

            const target = email.value;

            busy = true;
            email.readOnly = true;
            syncButtons();

            try {
                const result = await post(
                    "/api/v1/email-verifications/confirm",
                    {
                        email: target,
                        code: code.value
                    }
                );

                if (email.value !== target) {
                    return;
                }

                verifiedEmail = result.verified ? target : null;

                message(
                    emailMessage,
                    result.message,
                    result.verified ? "success" : "error"
                );
            } catch (error) {
                message(emailMessage, error.message, "error");
            } finally {
                email.readOnly = false;
                busy = false;
                syncButtons();
            }
        });

        // 사업자 정보 변경 시 검증 성공 상태 초기화
        function syncBusiness() {
            resetBusinessVerification();

            message(
                businessMessage,
                pending
                    ? "검토 중에는 기업 인증 정보 수정이 불가합니다."
                    : businessChanged()
                        ? "사업자 정보가 변경되었습니다. 검증해주세요."
                        : "기존 사업자 정보와 같아 재검증이 필요하지 않습니다."
            );

            clearCertificateError();
            syncButtons();
        }

        businessFields.forEach(input => {
            input.addEventListener("input", syncBusiness);
            input.addEventListener("change", syncBusiness);
        });

        // 사업자 검증 버튼
        businessButton.addEventListener("click", async () => {
            if (busy || submitting || pending) {
                return;
            }

            resetBusinessVerification();

            // 서버의 검증 요청 DTO와 앞뒤 공백 처리 기준을 맞춤
            representativeName.value = representativeName.value.trim();

            for (const input of businessFields) {
                if (!input.reportValidity()) {
                    syncButtons();
                    return;
                }
            }

            const request = currentBusinessInfo();

            if (!request.representativeName) {
                message(businessMessage, "대표자명을 입력해주세요.", "error");
                representativeName.focus();
                syncButtons();
                return;
            }

            const requestedInfo = JSON.stringify(request);
            const requestedAt = Date.now();

            busy = true;

            // 응답이 올 때까지 검증 대상 정보 수정 방지
            businessFields.forEach(input => {
                input.readOnly = true;
            });

            syncButtons();
            message(businessMessage, "사업자 정보를 확인하고 있습니다.");

            try {
                const result = await post(
                    "/api/v1/business-verifications",
                    request
                );

                // 요청 당시와 정보가 다르면 해당 응답을 사용하지 않음
                if (requestedInfo !== JSON.stringify(currentBusinessInfo())) {
                    message(
                        businessMessage,
                        "사업자 정보가 변경되었습니다. 다시 검증해주세요.",
                        "error"
                    );
                    return;
                }

                if (result.status === "MATCHED") {
                    verifiedBusiness = requestedInfo;

                    // 실제 만료 여부는 최종 저장 시 서버에서도 검사
                    businessVerifiedUntil = requestedAt + 10 * 60 * 1000;

                    message(businessMessage, result.message, "success");
                } else {
                    message(businessMessage, result.message, "error");
                }
            } catch (error) {
                message(businessMessage, error.message, "error");
            } finally {
                businessFields.forEach(input => {
                    input.readOnly = pending;
                });

                busy = false;
                syncButtons();
            }
        });

        // 브라우저의 required 검사에서 차단돼도 파일 오류 강조
        certificate.addEventListener("invalid", () => {
            if (certificate.validity.valueMissing) {
                showCertificateError(
                    "사업자 정보를 변경하려면 새 사업자등록증을 첨부해주세요."
                );
            }
        });

        certificate.addEventListener("change", () => {
            clearCertificateError();

            const error = validateCertificate();

            if (error) {
                showCertificateError(error);
            }
        });

        // 새 비밀번호와 확인값 실시간 비교
        function passwordMatch() {
            const mismatch = password.value !== confirmation.value;

            confirmation.setCustomValidity(
                mismatch ? "새 비밀번호 확인이 일치하지 않습니다." : ""
            );

            message(
                passwordMessage,
                confirmation.value
                    ? mismatch
                        ? "새 비밀번호 확인이 일치하지 않습니다."
                        : "비밀번호가 일치합니다."
                    : "",
                mismatch ? "error" : "success"
            );
        }

        password.addEventListener("input", passwordMatch);
        confirmation.addEventListener("input", passwordMatch);

        // 최종 수정 제출
        form.addEventListener("submit", event => {
            message(formMessage, "");

            if (busy || submitting) {
                event.preventDefault();
                message(
                    formMessage,
                    "인증 처리가 끝난 뒤 저장해주세요.",
                    "error"
                );
                return;
            }

            passwordMatch();

            if (!form.reportValidity()) {
                event.preventDefault();
                return;
            }

            // 이메일을 바꿨을 때만 이메일 인증 필수
            if (emailChanged() && verifiedEmail !== email.value) {
                event.preventDefault();
                message(formMessage, "새 이메일 인증을 완료해주세요.", "error");
                email.focus();
                return;
            }

            // 사업자 정보가 바뀌었을 때만 사업자 검증 필수
            if (businessChanged() && !isBusinessVerified()) {
                event.preventDefault();
                message(
                    businessMessage,
                    "변경한 사업자 정보의 검증을 완료해주세요. 만료됐다면 다시 검증해주세요.",
                    "error"
                );
                businessButton.focus();
                return;
            }

            const passwordPattern =
                /^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@!%*#?&])[A-Za-z\d$@!%*#?&]{8,16}$/;

            if (password.value && !passwordPattern.test(password.value)) {
                event.preventDefault();
                message(
                    formMessage,
                    "새 비밀번호는 영문·숫자·특수문자를 포함한 8~16자로 입력해주세요.",
                    "error"
                );
                password.focus();
                return;
            }

            const fileError = validateCertificate();

            if (fileError) {
                event.preventDefault();
                showCertificateError(fileError);
                certificate.focus();
                return;
            }

            // 기본값과 비교해 실제 변경된 일반 입력만 선택
            const changed = fields.filter(
                input => input.value !== input.defaultValue
            );

            const hasFile = certificate.files.length > 0;

            if (!changed.length && !hasFile) {
                event.preventDefault();
                message(
                    formMessage,
                    "변경할 정보를 입력해주세요.",
                    "error"
                );
                return;
            }

            // 변경하지 않은 값은 전송하지 않음
            // 서버에서는 전송되지 않은 사업자 정보를 기존 값으로 보완
            fields.forEach(input => {
                input.disabled = !changed.includes(input);
            });

            submitting = true;
            syncButtons();

            // 선택한 파일은 전송돼야 하므로 다시 활성화
            // disabled 상태의 입력은 폼 데이터에 포함되지 않음
            certificate.disabled = pending || !hasFile;
        });

        // 뒤로 가기로 돌아왔을 때 비활성화된 입력·버튼 복원
        window.addEventListener("pageshow", () => {
            fields.forEach(input => {
                input.disabled = false;
            });

            businessFields.forEach(input => {
                input.readOnly = pending;
            });

            submitting = false;
            resetBusinessVerification();
            syncButtons();
            passwordMatch();

            message(
                businessMessage,
                pending
                    ? "검토 중에는 기업 인증 정보 수정이 불가합니다."
                    : businessChanged()
                        ? "변경한 사업자 정보를 다시 검증해주세요."
                        : "사업자 정보를 변경한 경우 검증해주세요."
            );
        });

        syncEmail();
        syncBusiness();
        passwordMatch();
    })();
</script>
</body>
</html>