<!DOCTYPE html>
<html lang="ko">
<head>
    {{> layout/head-meta}}
    <title>기업 계정·담당자 정보 수정 | Busan Play</title>
</head>
<body>
{{> layout/header}}
{{> layout/company-style}}
{{> layout/account-style}}
<style>
    .company-settings { padding: 40px 24px 60px; background: #f8f9fb; color: #292f3d; font-family: 'Pretendard',sans-serif; }
    .company-settings .company-card { max-width: none; width: 100%; padding: 30px; border: 1px solid #e6e7eb; border-radius: 18px; background: white; }
    .company-settings fieldset { margin: 24px 0; padding: 22px; border: 1px solid #e6e7eb; border-radius: 12px; }
    .company-settings legend { width: auto; padding: 0 8px; font-size: 17px; font-weight: 700; }
    .company-settings .company-description { color: #72757e; font-size: 14px; line-height: 1.75; }
    @media(max-width:600px) { .company-settings { padding: 28px 16px 40px; } .company-settings .company-card { padding: 22px; } .company-settings fieldset { padding: 16px; } }
</style>
<main class="company-settings">
    <div class="account-layout">
        {{> layout/company-nav}}
        <section class="company-card account-content">
            <h1>계정·담당자 정보 수정</h1>
            <p class="company-description">이메일·비밀번호와 담당자 정보를 변경할 수 있습니다.<br>기업 인증정보는 이 화면에서 수정하지 않습니다.</p>
            <form id="updateForm" action="/company/update" method="post">
                {{#company}}
            <fieldset>
                <legend>계정 정보</legend>

                <div class="auth-field">
                    <label for="email">이메일</label>

                    <div class="auth-row company-verification-row">
                        <input id="email"
                               name="email"
                               type="email"
                               value="{{email}}"
                               maxlength="254"
                               autocomplete="username"
                               required>

                        <button id="sendEmailCode"
                                class="auth-button secondary"
                                type="button"
                                hidden>
                            인증번호 발송
                        </button>
                    </div>
                </div>

                <div id="emailVerificationSection" class="auth-field" hidden>
                    <label for="emailCode">인증번호</label>

                    <div class="auth-row company-verification-row">
                        <input id="emailCode"
                               type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="숫자 6자리">

                        <button id="confirmEmailCode"
                                class="auth-button secondary"
                                type="button">
                            인증 확인
                        </button>
                    </div>
                </div>

                <p id="emailMessage"
                   class="auth-message"
                   role="status"
                   aria-live="polite">
                    이메일을 변경하려면 새 주소를 인증해주세요.
                </p>

                <p>
                    <label for="password">새 비밀번호</label><br>
                    <input id="password"
                           name="password"
                           type="password"
                           autocomplete="new-password"
                           minlength="8"
                           maxlength="16">
                    <br>
                    <small>변경할 경우에만 입력하세요. 영문·숫자·특수문자($@!%*#?&)를 포함한 8~16자입니다.</small>
                </p>

                <div class="auth-field">
                    <label for="passwordConfirm">새 비밀번호 확인</label><br>
                    <input id="passwordConfirm"
                           type="password"
                           autocomplete="new-password">

                    <p id="passwordMatchMessage"
                       class="auth-message"
                       role="status"
                       aria-live="polite"></p>
                </div>
            </fieldset>
            <fieldset>
                <legend>담당자 정보</legend>

                <p>
                    <label for="contactPersonName">담당자 이름</label><br>
                    <input id="contactPersonName"
                           name="contactPersonName"
                           value="{{contactPersonName}}"
                           maxlength="20"
                           required>
                </p>

                <p>
                    <label for="contactPersonPhone">담당자 연락처</label><br>
                    <input id="contactPersonPhone"
                           name="contactPersonPhone"
                           type="tel"
                           value="{{contactPersonPhone}}"
                           maxlength="13"
                           required>
                </p>
            </fieldset>
                {{/company}}
                <p id="formMessage" class="auth-message" role="alert"></p>
                <div class="company-form-actions"><button id="company-save" type="submit">수정 저장</button><a class="company-cancel-button" href="/company/detail">취소</a></div>
            </form>
        </section>
    </div>
</main>
{{> layout/footer}}
<script>
(() => {
    const get = id => document.getElementById(id);
    const form = get('updateForm'), email = get('email'), password = get('password'), confirmation = get('passwordConfirm');
    const send = get('sendEmailCode'), confirm = get('confirmEmailCode'), code = get('emailCode');
    const emailMessage = get('emailMessage'), formMessage = get('formMessage'), save = get('company-save');
    const fields = Array.from(form.querySelectorAll('input[name]'));
    let verifiedEmail = null, sending = false, confirming = false, submitting = false;
    function message(element, text, state) { element.textContent = text; element.dataset.state = state; }
    function emailChanged() { return email.value !== email.defaultValue; }
    function syncEmail() {
        verifiedEmail = null; code.value = '';
        send.hidden = !emailChanged(); get('emailVerificationSection').hidden = true;
        message(emailMessage, emailChanged() ? '새 이메일 주소로 인증을 완료해주세요.' : '이메일을 변경하려면 새 주소를 인증해주세요.', '');
    }
    email.addEventListener('input', syncEmail);
    async function post(url, body) {
        const response = await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)});
        let result;
        try { result = await response.json(); } catch { throw new Error('요청을 처리하지 못했습니다. 잠시 후 다시 시도해주세요.'); }
        if(!response.ok) throw new Error(result.message || '요청에 실패했습니다.');
        return result;
    }
    send.addEventListener('click', async () => {
        if(sending || submitting || !email.reportValidity()) return;
        const target = email.value; sending = true; send.disabled = true;
        verifiedEmail = null;
        try {
            const result = await post('/api/v1/email-verifications', {email:target});
            if(email.value !== target) return;
            code.value = ''; get('emailVerificationSection').hidden = false;
            message(emailMessage, result.message, 'success'); code.focus();
        } catch(error) { if(email.value === target) message(emailMessage,error.message,'error'); }
        finally { sending = false; send.disabled = false; }
    });
    confirm.addEventListener('click', async () => {
        if(confirming || sending || submitting) return;
        if(!/^[0-9]{6}$/.test(code.value)) { message(emailMessage,'인증번호 숫자 6자리를 입력해주세요.','error'); code.focus(); return; }
        const target = email.value; confirming = true; confirm.disabled = true;
        try {
            const result = await post('/api/v1/email-verifications/confirm', {email:target,code:code.value});
            if(email.value !== target) return;
            verifiedEmail = result.verified ? target : null;
            message(emailMessage,result.message,result.verified ? 'success' : 'error');
        } catch(error) { if(email.value === target) message(emailMessage,error.message,'error'); }
        finally { confirming = false; confirm.disabled = false; }
    });
    function passwordMatch() { confirmation.setCustomValidity(confirmation.value !== password.value ? '새 비밀번호 확인이 일치하지 않습니다.' : ''); }
    password.addEventListener('input', passwordMatch); confirmation.addEventListener('input',passwordMatch);
    form.addEventListener('submit', event => {
        if(submitting) { event.preventDefault(); return; }
        passwordMatch();
        if(!form.reportValidity()) { event.preventDefault(); return; }
        if(sending || confirming) { event.preventDefault(); message(formMessage,'이메일 인증 처리가 끝난 뒤 저장해주세요.','error'); return; }
        if(emailChanged() && verifiedEmail !== email.value) { event.preventDefault(); message(formMessage,'새 이메일 인증을 완료해주세요.','error'); email.focus(); return; }
        if(password.value && !/^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@!%*#?&])[A-Za-z\d$@!%*#?&]{8,16}$/.test(password.value)) {
            event.preventDefault(); message(formMessage,'새 비밀번호는 영문·숫자·특수문자($@!%*#?&)를 포함한 8~16자로 입력해주세요.','error'); password.focus(); return;
        }
        const changed = fields.filter(input => input.value !== input.defaultValue);
        if(!changed.length) { event.preventDefault(); message(formMessage,'변경할 정보를 입력해주세요.','error'); return; }
        fields.forEach(input => { input.disabled = !changed.includes(input); });
        submitting = true; save.disabled = true; save.textContent = '저장 중…';
    });
    window.addEventListener('pageshow', () => {
        fields.forEach(input => { input.disabled = false; });
        submitting = false; save.disabled = false; save.textContent = '수정 저장';
    });
    syncEmail();
})();
</script>
</body>
</html>