<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>기업 정보 수정</title>
</head>
<body>
{{>layout/header}}
{{>company/style}}
<main class="auth-page">
    <section class="auth-card company-card">

        <h1>기업 정보 수정</h1>

        <p>
            담당자 이름·연락처는 일반 수정입니다.
            기업명·사업자번호·대표자명·개업일자·주소를 변경하려면
            새 사업자등록증을 첨부해야 하며, 변경 후 재심사가 진행됩니다.
        </p>

        <form id="updateForm" action="/company/update" method="post" enctype="multipart/form-data">
            {{#company}}
            <fieldset>
                <legend>계정 정보</legend>

                <div class="auth-field">
                    <label for="email">이메일</label>

                    <div class="auth-row company-verification-row">
                        <input id="email"
                               name="email"
                               type="email"
                               value="{{email}}"
                               maxlength="254"
                               autocomplete="username"
                               required>

                        <button id="sendEmailCode"
                                class="auth-button secondary"
                                type="button"
                                hidden>
                            인증번호 발송
                        </button>
                    </div>
                </div>

                <div id="emailVerificationSection" class="auth-field" hidden>
                    <label for="emailCode">인증번호</label>

                    <div class="auth-row company-verification-row">
                        <input id="emailCode"
                               type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="숫자 6자리">

                        <button id="confirmEmailCode"
                                class="auth-button secondary"
                                type="button">
                            인증 확인
                        </button>
                    </div>
                </div>

                <p id="emailMessage"
                   class="auth-message"
                   role="status"
                   aria-live="polite">
                    이메일을 변경하려면 새 주소를 인증해주세요.
                </p>

                <p>
                    <label for="password">새 비밀번호</label><br>
                    <input id="password"
                           name="password"
                           type="password"
                           autocomplete="new-password"
                           minlength="8"
                           maxlength="16">
                    <br>
                    <small>변경할 경우에만 입력하세요.</small>
                </p>

                <div class="auth-field">
                    <label for="passwordConfirm">새 비밀번호 확인</label><br>
                    <input id="passwordConfirm"
                           type="password"
                           autocomplete="new-password">

                    <p id="passwordMatchMessage"
                       class="auth-message"
                       role="status"
                       aria-live="polite"></p>
                </div>
            </fieldset>

            <fieldset>
                <legend>담당자 정보 — 일반 수정</legend>

                <p>
                    <label for="contactPersonName">담당자 이름</label><br>
                    <input id="contactPersonName"
                           name="contactPersonName"
                           value="{{contactPersonName}}"
                           maxlength="20"
                           required>
                </p>

                <p>
                    <label for="contactPersonPhone">담당자 연락처</label><br>
                    <input id="contactPersonPhone"
                           name="contactPersonPhone"
                           type="tel"
                           value="{{contactPersonPhone}}"
                           maxlength="13"
                           required>
                </p>
            </fieldset>

            <fieldset>
                <legend>기업 인증 정보 — 변경 시 재심사</legend>

                {{#pending}}
                <p class="company-review-notice" role="status">
                    검토 중에는 기업 인증 정보 수정이 불가합니다.
                </p>
                {{/pending}}

                <p>
                    <label for="name">기업명</label><br>
                    <input id="name"
                           name="name"
                           value="{{name}}"
                           {{#pending}}readonly{{/pending}}
                    maxlength="50"
                    data-review
                    required>
                </p>

                <p>
                    <label for="businessNumber">사업자등록번호</label><br>
                    <input id="businessNumber"
                           name="businessNumber"
                           value="{{businessNumber}}"
                           {{#pending}}readonly{{/pending}}
                    pattern="[0-9]{10}"
                    minlength="10"
                    maxlength="10"
                    inputmode="numeric"
                    data-review
                    required>
                </p>

                <p>
                    <label for="representativeName">대표자명</label><br>
                    <input id="representativeName"
                           name="representativeName"
                           value="{{representativeName}}"
                           {{#pending}}readonly{{/pending}}
                    maxlength="50"
                    data-review
                    required>
                </p>

                <p>
                    <label for="openedOn">개업일자</label><br>
                    <input id="openedOn"
                           name="openedOn"
                           type="date"
                           value="{{openedOn}}"
                           {{#pending}}readonly{{/pending}}
                    data-review
                    required>
                </p>

                <p>
                    <label for="address">기업 주소</label><br>
                    <input id="address"
                           name="address"
                           value="{{address}}"
                           {{#pending}}readonly{{/pending}}
                    maxlength="255"
                    data-review
                    required>
                </p>

                <div class="auth-field">
                    <label for="certificate">새 사업자등록증</label><br>
                    <input id="certificate"
                           aria-describedby="certificateMessage"
                           name="businessCertificate"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           {{#pending}}disabled{{/pending}}>
                    <br>
                    <small>
                        기업 인증 정보를 변경하면 새 등록증을 첨부해주세요.
                        PDF·JPG·JPEG·PNG, 최대 10MB까지 가능합니다.
                        파일만 교체해도 재심사가 진행됩니다.
                    </small>
                    <p id="certificateMessage"
                       class="auth-message"
                       role="alert"></p>
                </div>

                <p>현재 심사 상태:
                    {{#pending}}
                    <span class="review-badge review-badge--pending">검토 중</span>
                    {{/pending}}

                    {{#approved}}
                    <span class="review-badge review-badge--approved">승인</span>
                    {{/approved}}

                    {{#feedbackNeeded}}
                    <span class="review-badge review-badge--danger">보완 필요</span>
                    {{/feedbackNeeded}}

                    {{#rejected}}
                    <span class="review-badge review-badge--danger">반려</span>
                    {{/rejected}}

                    {{#suspended}}
                    <span class="review-badge review-badge--danger">이용 정지</span>
                    {{/suspended}}</p>
            </fieldset>

            {{#feedbackNeeded}}
            <div class="company-feedback-notice" role="status">
                <strong>보완 사유</strong>
                <p>{{reviewReason}}</p>
            </div>
            {{/feedbackNeeded}}

            {{/company}}

            <p id="reviewNotice" role="status" hidden>
                기업 인증 정보 또는 사업자등록증이 변경되었습니다.
                저장 후 사업자 검증 결과에 따라 검토 중 또는 보완 필요 상태로 전환됩니다.
            </p>

            <p id="formMessage" role="alert"></p>

            <div class="company-form-actions">
                <button type="submit">수정 저장</button>
                <a class="company-cancel-button" href="/company/detail">취소</a>
            </div>
        </form>
    </section>
</main>

{{>layout/footer}}

<script>
    // ===== 화면 요소 =====

    const form = document.getElementById("updateForm");

    // 전체 폼 오류 및 재심사 안내
    const message = document.getElementById("formMessage");
    const reviewNotice = document.getElementById("reviewNotice");
    const submitButton = form.querySelector('button[type="submit"]');

    // 이메일 입력·인증 영역
    const emailInput = document.getElementById("email");
    const emailCode = document.getElementById("emailCode");
    const emailMessage = document.getElementById("emailMessage");
    const sendEmailCode = document.getElementById("sendEmailCode");
    const confirmEmailCode = document.getElementById("confirmEmailCode");
    const emailVerificationSection =
        document.getElementById("emailVerificationSection");

    // 새 비밀번호 입력·실시간 확인
    const passwordInput = document.getElementById("password");
    const passwordConfirm = document.getElementById("passwordConfirm");
    const passwordMatchMessage =
        document.getElementById("passwordMatchMessage");

    // 기업 인증 정보: data-review가 붙은 일반 입력
    const reviewFields = [
        ...form.querySelectorAll("[data-review]")
    ];

    // 등록증 입력·오류 메시지
    const certificateInput = document.getElementById("certificate");
    const certificateMessage =
        document.getElementById("certificateMessage");


    // ===== 검사 규칙 =====

    // 현재 서버의 비밀번호 규칙
    const passwordPattern =
        /^(?=.*[A-Za-z])(?=.*\d)(?=.*[$@!%*#?&])[A-Za-z\d$@!%*#?&]{8,16}$/;

    const certificateExtensionPattern = /\.(pdf|jpe?g|png)$/i;
    const certificateMaxSize = 10 * 1024 * 1024;

    const certificateRequiredMessage =
        "기업 인증 정보를 변경하려면 새 사업자등록증을 첨부해주세요.";


    // ===== 처리 상태 =====

    // 인증번호 발송에 성공한 이메일
    let sentEmail = null;

    // 인증번호 확인까지 성공한 이메일
    let verifiedEmail = null;

    // 이메일 통신 및 폼 제출 중복 방지
    let emailBusy = false;
    let submitting = false;


    // ===== 변경 여부 =====

    // 일반 입력을 최초 HTML 값과 비교
    function isInputChanged(input) {
        return input.value !== input.defaultValue;
    }

    function isEmailChanged() {
        return isInputChanged(emailInput);
    }

    // 기업명·번호·대표자·날짜·주소 변경 여부
    function companyInformationChanged() {
        return reviewFields.some(input => isInputChanged(input));
    }

    // 파일은 문자열이 아닌 files 목록으로 판단
    function hasBusinessCertificate() {
        return !certificateInput.disabled
            && certificateInput.files.length > 0;
    }

    function requiresReview() {
        return companyInformationChanged()
            || hasBusinessCertificate();
    }


    // ===== 화면 상태 갱신 =====

    function showEmailMessage(text, state) {
        emailMessage.textContent = text;
        emailMessage.dataset.state = state;
    }

    // 이메일 변경 시에만 발송 버튼 표시.
    // 해당 이메일로 발송에 성공해야 인증번호 영역 표시.
    function updateEmailVisibility() {
        const changed = isEmailChanged();

        sendEmailCode.hidden = !changed;
        emailVerificationSection.hidden =
            !changed || sentEmail !== emailInput.value;

        sendEmailCode.textContent =
            changed && sentEmail === emailInput.value
                ? "인증번호 재발송"
                : "인증번호 발송";
    }

    function updateButtons() {
        const locked = emailBusy || submitting;

        sendEmailCode.disabled = locked;
        confirmEmailCode.disabled = locked;
        submitButton.disabled = locked;

        updateEmailVisibility();
    }

    // 파일 오류 강조 제거
    function clearCertificateError() {
        certificateMessage.textContent = "";
        certificateInput.removeAttribute("aria-invalid");
        certificateInput.classList.remove("certificate-error");
    }

    // 파일 오류 강조. 반복 시도에도 애니메이션 재실행.
    function showCertificateError(text) {
        certificateMessage.textContent = text;
        certificateInput.setAttribute("aria-invalid", "true");

        certificateInput.classList.remove("certificate-error");
        void certificateInput.offsetWidth;
        certificateInput.classList.add("certificate-error");
    }

    // 첨부 파일의 기본 조건 검사.
    // 서버에서도 용량·확장자·실제 파일 내용을 다시 검사.
    function validateCertificate() {
        if (!hasBusinessCertificate()) return null;

        const file = certificateInput.files[0];

        if (file.size === 0) {
            return "비어 있는 파일은 첨부할 수 없습니다.";
        }

        if (file.size > certificateMaxSize) {
            return "파일 크기는 10MB 이하여야 합니다.";
        }

        if (!certificateExtensionPattern.test(file.name)) {
            return "PDF·JPG·JPEG·PNG 파일만 첨부할 수 있습니다.";
        }

        return null;
    }

    function updateReviewNotice() {
        reviewNotice.hidden = !requiresReview();

        // 기업 인증 정보 변경 시에만 파일 필수
        certificateInput.required =
            !certificateInput.disabled
            && companyInformationChanged();

        // 변경을 취소했고 파일도 없다면 이전 필수 오류 제거
        if (!companyInformationChanged()
                && !hasBusinessCertificate()) {
            clearCertificateError();
        }
    }


    // ===== 입력 이벤트 =====

    form.addEventListener("input", () => {
        updateReviewNotice();
        message.textContent = "";
    });

    // 주소가 바뀌면 이전 발송·인증 결과를 사용하지 않음
    emailInput.addEventListener("input", () => {
        sentEmail = null;
        verifiedEmail = null;
        emailCode.value = "";

        showEmailMessage(
            isEmailChanged()
                ? "인증번호를 발송해 새 이메일을 인증해주세요."
                : "기존 이메일을 유지합니다.",
            "info"
        );

        updateButtons();
    });

    // 파일 선택·취소 시 오류 및 재심사 안내 갱신
    certificateInput.addEventListener("change", () => {
        clearCertificateError();

        const error = validateCertificate();

        if (error !== null) {
            showCertificateError(error);
        }

        updateReviewNotice();
        message.textContent = "";
    });

    // required 검사에 막히면 submit 이벤트가 실행되지 않으므로
    // invalid 이벤트에서도 파일 오류를 강조
    certificateInput.addEventListener("invalid", () => {
        if (certificateInput.validity.valueMissing) {
            showCertificateError(certificateRequiredMessage);
        }
    });


    // ===== 이메일 API 통신 =====

    async function emailRequest(url, body) {
        const response = await fetch(url, {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(body)
        });

        const contentType =
            response.headers.get("content-type") || "";

        if (!contentType.includes("application/json")) {
            throw new Error(
                "인증 요청을 처리하지 못했습니다. HTTP "
                + response.status
            );
        }

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message || "이메일 인증 요청에 실패했습니다."
            );
        }

        return data;
    }

    // 통신 중 이메일·코드 변경 및 중복 요청 방지
    async function runEmailRequest(task) {
        if (emailBusy || submitting) return;

        emailBusy = true;
        emailInput.readOnly = true;
        emailCode.readOnly = true;
        updateButtons();

        try {
            await task();
        } catch (error) {
            showEmailMessage(
                error.message || "이메일 인증 처리에 실패했습니다.",
                "error"
            );
        } finally {
            emailBusy = false;
            emailInput.readOnly = false;
            emailCode.readOnly = false;
            updateButtons();
        }
    }

    // 인증번호 발송
    sendEmailCode.addEventListener("click", () => {
        if (emailBusy || submitting) return;
        if (!emailInput.reportValidity()) return;

        if (!isEmailChanged()) {
            showEmailMessage(
                "변경할 새 이메일을 입력해주세요.",
                "error"
            );
            return;
        }

        // 요청 당시 이메일을 보관하여 응답 처리에 사용
        const requestedEmail = emailInput.value;

        runEmailRequest(async () => {
            verifiedEmail = null;

            showEmailMessage(
                "인증번호를 발송하고 있습니다.",
                "info"
            );

            const data = await emailRequest(
                "/api/v1/email-verifications",
                { email: requestedEmail }
            );

            // 요청 도중 값이 바뀐 경우 이전 응답을 화면에 적용하지 않음
            if (emailInput.value !== requestedEmail) return;

            sentEmail = requestedEmail;
            emailCode.value = "";
            updateEmailVisibility();
            showEmailMessage(data.message, "success");
            emailCode.focus();
        });
    });

    // 인증번호 확인
    confirmEmailCode.addEventListener("click", () => {
        if (emailBusy || submitting) return;
        if (!emailInput.reportValidity()) return;

        if (!isEmailChanged()) {
            showEmailMessage(
                "기존 이메일은 다시 인증하지 않아도 됩니다.",
                "info"
            );
            return;
        }

        if (sentEmail !== emailInput.value) {
            showEmailMessage(
                "현재 이메일로 인증번호를 먼저 발송해주세요.",
                "error"
            );
            return;
        }

        const code = emailCode.value.trim();

        if (!/^[0-9]{6}$/.test(code)) {
            showEmailMessage(
                "인증번호 숫자 6자리를 입력해주세요.",
                "error"
            );
            return;
        }

        const requestedEmail = emailInput.value;

        runEmailRequest(async () => {
            verifiedEmail = null;

            const data = await emailRequest(
                "/api/v1/email-verifications/confirm",
                {
                    email: requestedEmail,
                    code: code
                }
            );

            if (emailInput.value !== requestedEmail) return;

            verifiedEmail = data.verified
                ? requestedEmail
                : null;

            showEmailMessage(
                data.message,
                data.verified ? "success" : "error"
            );
        });
    });


    // ===== 비밀번호 실시간 확인 =====

    function checkPasswordMatch() {
        const hasConfirmation = passwordConfirm.value !== "";

        const mismatch =
            hasConfirmation
            && passwordInput.value !== passwordConfirm.value;

        passwordConfirm.setCustomValidity(
            mismatch ? "새 비밀번호와 일치하지 않습니다." : ""
        );

        passwordMatchMessage.textContent = !hasConfirmation
            ? ""
            : mismatch
                ? "새 비밀번호와 일치하지 않습니다."
                : "비밀번호가 일치합니다.";

        passwordMatchMessage.style.color =
            mismatch ? "#b42318" : "#087443";
    }

    passwordInput.addEventListener("input", checkPasswordMatch);
    passwordConfirm.addEventListener("input", checkPasswordMatch);


    // ===== 폼 제출 =====

    form.addEventListener("submit", (event) => {
        message.textContent = "";

        // 오류 표시 후 일반 폼 전송 중단
        function rejectSubmission(text) {
            event.preventDefault();
            message.textContent = text;
        }

        if (submitting) {
            event.preventDefault();
            return;
        }

        if (emailBusy) {
            rejectSubmission(
                "이메일 인증 요청이 끝난 뒤 저장해주세요."
            );
            return;
        }

        // 파일을 제외한 일반 입력만 defaultValue로 비교
        const inputs = [
            ...form.querySelectorAll(
                'input[name]:not(:disabled):not([type="file"])'
            )
        ];

        const changedInputs = inputs.filter(
            input => isInputChanged(input)
        );

        const certificateUploaded = hasBusinessCertificate();

        if (changedInputs.length === 0 && !certificateUploaded) {
            rejectSubmission("변경된 정보가 없습니다.");
            return;
        }

        if (changedInputs.some(input => input.value.trim() === "")) {
            rejectSubmission(
                "수정할 정보는 공백으로 입력할 수 없습니다."
            );
            return;
        }

        // 기본 required 검사를 우회한 제출에도 동일한 조건 적용
        if (companyInformationChanged() && !certificateUploaded) {
            rejectSubmission(certificateRequiredMessage);
            showCertificateError(certificateRequiredMessage);
            certificateInput.focus();
            return;
        }

        const certificateError = validateCertificate();

        if (certificateError !== null) {
            rejectSubmission(certificateError);
            showCertificateError(certificateError);
            certificateInput.focus();
            return;
        }

        if (isEmailChanged() && verifiedEmail !== emailInput.value) {
            rejectSubmission("새 이메일 인증을 완료해주세요.");
            return;
        }

        if (passwordInput.value !== "") {
            if (!passwordPattern.test(passwordInput.value)) {
                rejectSubmission(
                    "새 비밀번호는 영문·숫자·특수문자($@!%*#?&)를 포함한 8~16자로 입력해주세요."
                );
                return;
            }

            if (passwordInput.value !== passwordConfirm.value) {
                rejectSubmission(
                    "비밀번호 확인이 일치하지 않습니다."
                );
                return;
            }
        } else if (passwordConfirm.value !== "") {
            rejectSubmission("새 비밀번호도 입력해주세요.");
            return;
        }

        if (requiresReview()
                && !window.confirm(
                    "기업 인증 정보 또는 등록증이 변경되어 재심사가 필요합니다. "
                    + "검증 결과에 따라 검토 중 또는 보완 필요 상태로 전환됩니다. "
                    + "저장할까요?"
                )) {
            event.preventDefault();
            return;
        }

        // 기존 값은 전송하지 않아 서버에서 null로 받도록 처리.
        // 선택한 파일은 이 목록에 포함되지 않아 그대로 전송됨.
        inputs.forEach(input => {
            if (!isInputChanged(input)) {
                input.disabled = true;
                input.dataset.omittedByUpdate = "true";
            }
        });

        submitting = true;
        updateButtons();

        // 이후 브라우저가 multipart/form-data로 폼 전송
    });


    // ===== 초기화·뒤로 가기 복원 =====

    function restoreFormState() {
        // 전송 제외 목적으로 비활성화한 입력만 복원.
        // PENDING 상태에서 막은 파일 입력은 그대로 유지.
        form.querySelectorAll('[data-omitted-by-update="true"]')
            .forEach(input => {
                input.disabled = false;
                delete input.dataset.omittedByUpdate;
            });

        submitting = false;

        // 진행 중인 이메일 요청 상태는 임의로 해제하지 않음
        emailInput.readOnly = emailBusy;
        emailCode.readOnly = emailBusy;

        updateButtons();
        updateReviewNotice();
        checkPasswordMatch();
    }

    window.addEventListener("pageshow", restoreFormState);

    restoreFormState();
</script>
</body>
</html>