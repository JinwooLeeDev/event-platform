{{> company/workspace-style}}
<style>
.session-panel { min-width:0; padding:26px; margin:0 0 24px; border:1px solid #dce4ee; border-radius:16px; background:#fff; scroll-margin-top:24px; }
.session-panel h2 { margin:0; font-size:20px; overflow-wrap:anywhere; }
.session-panel h3 { font-size:17px; }
.session-muted { color:#627084; font-size:13px; line-height:1.8; }
.session-choice-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px; }
.session-choice-link { display:flex; flex-direction:column; color:#142d4e; text-decoration:none; }
.session-choice-link:hover { border-color:#91afd5; box-shadow:0 3px 14px #142d4e08; }
.session-choice-link .company-panel-heading { flex-wrap:wrap; gap:10px; }
.session-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px 24px; margin:0; }
.session-facts dt { font-size:12px; color:#627084; }
.session-facts dd { font-size:13px; margin:6px 0 0; overflow-wrap:anywhere; }
.session-choice-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding-top:20px; margin-top:22px; border-top:1px solid #e5ebf2; gap:14px; }
.session-choice-metrics > div { min-width:0; }
.session-choice-metrics span { display:block; color:#627084; font-size:12px; }
.session-choice-metrics strong { display:block; font-size:17px; margin-top:5px; overflow-wrap:anywhere; }
.session-choice-action { display:flex; justify-content:space-between; gap:16px; border-top:1px solid #e5ebf2; padding-top:18px; margin-top:22px; color:#315b90; font-size:13px; font-weight:600; }
.session-tools { display:flex; flex-wrap:wrap; align-items:flex-end; gap:16px; }
.session-tools label { display:grid; gap:8px; min-width:0; font-size:12px; color:#526780; }
.session-tools input, .session-tools select { min-width:0; width:100%; min-height:46px; padding:11px 13px; border:1px solid #bdcde1; border-radius:8px; background:#fff; color:#142d4e; font:inherit; font-size:14px; }
.session-tools input[readonly] { background:#f2f5fa; }
.session-tools button { min-height:44px; padding:11px 18px; border:1px solid #174bc1; border-radius:8px; background:#174bc1; color:#fff; font:inherit; font-size:13px; font-weight:600; cursor:pointer; }
.session-tools button:hover { background:#123b99; }
.session-create-form > label { flex:1 1 220px; }
.session-create-form .session-wide { flex-basis:100%; }
.session-participant-tools { padding:18px; border:1px solid #e0e7f1; background:#f7f9fc; border-radius:10px; }
.session-participant-tools > label:first-child { flex:1 1 200px; }
.session-participant-tools > label:last-child { flex:0 1 190px; }
.session-panel > summary { cursor:pointer; font-weight:700; color:#315b90; font-size:16px; }
.session-table-wrap { width:100%; overflow-x:auto; }
.session-table { width:100%; border-collapse:collapse; font-size:13px; }
.session-table caption { caption-side:bottom; text-align:left; color:#627084; font-size:11px; padding-top:14px; }
.session-table th, .session-table td { padding:15px 12px; border-bottom:1px solid #e5ebf2; text-align:left; overflow-wrap:anywhere; }
.session-table th { color:#627084; font-size:12px; font-weight:600; background:#f3f6fa; white-space:nowrap; }
.session-table td:nth-child(3) { color:#315b90; }
.company-session-danger { padding:16px 24px; border:1px solid #e5d8d8; background:#fff; border-radius:12px; }
@media(max-width:1100px) { .session-choice-grid { grid-template-columns:minmax(0,1fr); } }
@media(max-width:600px) { .session-panel { padding:22px 18px; } .session-facts { grid-template-columns:1fr; gap:16px; } .session-table th, .session-table td { padding:12px 8px; } .session-table { min-width:410px; } .session-choice-metrics { gap:10px; } .session-choice-metrics strong { font-size:15px; } .session-participant-tools > label:last-child { flex:1 1 100%; } .session-create-form > label { flex-basis:100%; } }
</style>
