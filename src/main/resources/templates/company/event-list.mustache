<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>{{> layout/head-meta}}<title>{{i18n.company.ui0029}}</title></head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/workspace-style}}
<main class="company-workspace company-events-page">
    <div class="account-layout">
        {{> layout/company-nav}}
        <section class="account-content" aria-labelledby="company-events-title">
            <header class="company-heading"><div><p class="company-location">{{i18n.community.ui0017}}</p><h1 id="company-events-title">{{i18n.company.ui0011}}</h1><p class="company-description">{{i18n.company.ui0030}}</p></div><a class="company-button" href="/events/save">{{i18n.company.ui0013}} <span aria-hidden="true">+</span></a></header>
            {{#successMessage}}<p class="company-success" role="status">{{successMessage}}</p>{{/successMessage}}
            <section class="company-panel company-events-filter" aria-label="{{i18n.company.ui0031}}">
                <div class="company-event-tabs" role="tablist" aria-label="{{i18n.company.ui0032}}">
                    <button id="company-events-published-tab" type="button" role="tab" aria-selected="true" aria-controls="company-events-panel" data-event-tab="published">{{i18n.company.ui0033}} <span data-event-tab-count="published">0</span></button>
                    <button id="company-events-review-tab" type="button" role="tab" aria-selected="false" aria-controls="company-events-panel" tabindex="-1" data-event-tab="review">{{i18n.company.ui0034}} <span data-event-tab-count="review">0</span></button>
                    <button id="company-events-closed-tab" type="button" role="tab" aria-selected="false" aria-controls="company-events-panel" tabindex="-1" data-event-tab="closed">{{i18n.company.ui0035}} <span data-event-tab-count="closed">0</span></button>
                </div>
                <p class="company-description" id="company-event-tab-description">{{i18n.company.ui0036}}</p>
                <div class="company-events-toolbar"><label>{{i18n.common.search}}<input id="company-event-search" type="search" placeholder="{{i18n.company.ui0038}}"></label><label>{{i18n.company.ui0039}}<select id="company-event-filter"><option value="">{{i18n.company.ui0040}}</option><option value="PENDING_REVIEW">{{i18n.company.ui0034}}</option><option value="FEEDBACK_REQUIRED">{{i18n.admin.ui0056}}</option><option value="PAID_READY">{{i18n.company.ui0041}}</option><option value="PUBLISHED">{{i18n.company.ui0033}}</option><option value="COMPLETED">{{i18n.company.ui0042}}</option><option value="CANCELLED">{{i18n.company.ui0043}}</option></select></label></div>
            </section>
            <div id="company-events-panel" role="tabpanel" aria-labelledby="company-events-published-tab">
            <p class="company-result" id="company-event-result" role="status"></p>
            <div class="company-event-list">
            {{#eventList}}{{#eventList}}
                <article class="company-panel company-event-card" data-event-status="{{status}}" data-event-title="{{title}}">
                    <div class="company-event-heading"><div><span class="company-category">{{#categoryName}}{{categoryName}}{{/categoryName}}{{^categoryName}}{{i18n.company.ui0044}}{{/categoryName}}</span><h2><a class="company-event-manage-link" href="/events/sessions/list/{{id}}">{{title}}</a></h2></div><span class="company-state" data-company-event-status>{{status}}</span></div>
                    <p class="company-event-summary">{{summary}}</p>
                    <div class="company-event-meta"><span>{{i18n.company.ui0045}} <strong>{{sessionCount}}{{i18n.company.ui0046}}</strong></span>{{#createdAt}}<span>{{i18n.admin.ui0004}} <time data-company-event-date>{{createdAt}}</time></span>{{/createdAt}}{{#publishedAt}}<span>{{i18n.company.ui0047}} <time data-company-event-date>{{publishedAt}}</time></span>{{/publishedAt}}</div>
                    {{#feedbackMessage}}<div class="company-feedback"><strong>{{i18n.company.ui0048}}</strong><p>{{feedbackMessage}}</p><div data-event-edit hidden><a class="company-button company-button--secondary" href="/events/update/{{id}}">{{i18n.company.ui0049}}</a></div></div>{{/feedbackMessage}}
                    {{^feedbackMessage}}<div data-event-edit hidden class="company-feedback"><strong>{{i18n.company.ui0050}}</strong><p>{{i18n.company.ui0051}}</p><a class="company-button company-button--secondary" href="/events/update/{{id}}">{{i18n.company.ui0049}}</a></div>{{/feedbackMessage}}
                    {{#paidReadyEvent}}
                    <section class="company-deposit" aria-label="{{i18n.company.ui0052}}">

                        <div class="company-deposit-heading">
                            <div>
                                <h3>{{i18n.company.ui0053}}</h3>
                                <p>
                                    {{i18n.admin.ui0144}} {{sessionCount}}{{i18n.common.merge001}} {{paidSessionCount}}{{i18n.common.merge002}} {{unpaidSessionCount}}{{i18n.admin.ui0098}}
                                </p>
                                <p>
                                    {{i18n.common.merge003}}
                                </p>
                            </div>
                            <span>{{i18n.company.ui0057}} <strong>150,000 P</strong></span>
                        </div>

                        <div class="company-deposit-sessions">

                            {{! Service에서 구성한 회차 목록 반복 }}
                            {{#sessionPeriods}}
                            <div class="company-deposit-row">
                                <div>
                                    <strong>{{name}}</strong>

                                    {{! 회차별 실제 금액과 보증금 상태 표시 }}
                                    <small>
                                        {{i18n.company.ui0058}} {{depositAmountText}} P
                                        · {{depositStatusName}}
                                    </small>

                                    {{! 납부 시각이 있는 경우에만 표시 }}
                                    {{#depositPaidAt}}
                                    <small>{{i18n.company.ui0059}} {{depositPaidAt}}</small>
                                    {{/depositPaidAt}}
                                </div>

                                {{! Service가 결제 가능하다고 판단한 회차에만 버튼 표시 }}
                                {{#depositPayable}}
                                <form
                                        action="/event/deposit/{{sessionId}}"
                                        method="post"
                                        onsubmit="return confirm('선택한 회차의 보증금을 결제하시겠습니까? 모든 회차 납부 후 행사가 공개됩니다.')"
                                >
                                    <button type="submit" class="company-button">
                                        {{i18n.company.ui0060}}
                                    </button>
                                </form>
                                {{/depositPayable}}
                            </div>
                            {{/sessionPeriods}}

                            {{! 회차 목록이 비어 있을 때 표시 }}
                            {{^sessionPeriods}}
                            <p class="company-description">
                                {{i18n.company.ui0061}}
                            </p>
                            {{/sessionPeriods}}
                        </div>

                        <a class="company-text-link" href="/charge">
                            {{i18n.company.ui0062}}
                            <span aria-hidden="true">↗</span>
                        </a>
                    </section>
                    {{/paidReadyEvent}}
                    <section class="company-operation" aria-label="{{i18n.company.ui0063}}"><div><h3>{{i18n.company.ui0063}}</h3><p>{{i18n.company.ui0064}}</p></div><div class="company-actions"><a class="company-button" href="/events/sessions/list/{{id}}">{{i18n.company.ui0065}}</a></div></section>
                    <div class="company-event-secondary"><details class="company-recruitment"><summary>{{i18n.company.ui0067}}</summary><dl>{{#sessionPeriods}}<div><dt>{{name}}</dt><dd>{{applyStartAt}} ~ {{applyEndAt}}</dd></div>{{/sessionPeriods}}{{^sessionPeriods}}<p class="company-description">{{i18n.admin.ui0102}}</p>{{/sessionPeriods}}</dl></details><details class="company-danger"><summary>{{i18n.company.ui0068}}</summary><p>{{i18n.company.ui0069}}</p><a class="company-button company-button--secondary" href="/events/sessions/list/{{id}}?select=1">{{i18n.company.ui0070}}</a></details></div>
                </article>
            {{/eventList}}{{^eventList}}<div class="company-empty"><h2>{{i18n.company.ui0071}}</h2><p>{{i18n.company.ui0072}}</p><a class="company-button company-button--secondary" href="/events/save">{{i18n.company.ui0073}}</a></div>{{/eventList}}{{/eventList}}
            {{^eventList}}<div class="company-empty"><h2>{{i18n.company.ui0074}}</h2><p>{{i18n.company.ui0075}}</p><a class="company-button company-button--secondary" href="/company/detail">{{i18n.company.ui0076}}</a></div>{{/eventList}}
            </div>
            <div class="company-empty" id="company-event-filter-empty" hidden><h2>{{i18n.company.ui0077}}</h2><p>{{i18n.company.ui0078}}</p><button class="company-button company-button--secondary" id="company-event-filter-reset" type="button">{{i18n.company.ui0079}}</button></div>
            </div>
        </section>
    </div>
</main>
{{> layout/footer}}
<script>
(() => {
    const labels = {PENDING_REVIEW:BusanI18n.t("company.ui0034"),FEEDBACK_REQUIRED:BusanI18n.t("admin.ui0056"),PUBLISHED:BusanI18n.t("company.ui0033"),COMPLETED:BusanI18n.t("company.ui0080"),CANCELLED:BusanI18n.t("company.ui0081"),PAID_READY:BusanI18n.t("company.ui0041")};
    const cards = [...document.querySelectorAll('.company-event-card')];
    document.querySelectorAll('[data-company-event-status]').forEach(element => {
        const value = element.textContent.trim(); element.textContent = labels[value] || value;
        element.closest('.company-event-card').querySelector('[data-event-edit]').hidden = value !== 'FEEDBACK_REQUIRED';
    });
    document.querySelectorAll('[data-company-event-date]').forEach(element => { const value = element.textContent.trim(); if(/^\d{4}-\d{2}-\d{2}T/.test(value)) element.textContent = value.slice(0,16).replace('T',' ').replaceAll('-','.'); });
    const search = document.getElementById('company-event-search'), filter = document.getElementById('company-event-filter');
    const tabs = [...document.querySelectorAll('[data-event-tab]')];
    const groups = {published:['PUBLISHED'],review:['PENDING_REVIEW','FEEDBACK_REQUIRED','PAID_READY'],closed:['COMPLETED','CANCELLED']};
    const descriptions = {published:BusanI18n.t("company.ui0036"),review:BusanI18n.t("company.ui0082"),closed:BusanI18n.t("company.ui0083")};
    let currentTab = 'published';
    Object.entries(groups).forEach(([name, states]) => {
        document.querySelector(`[data-event-tab-count="${name}"]`).textContent = cards.filter(card => states.includes(card.dataset.eventStatus)).length.toLocaleString('ko-KR');
    });
    const update = () => {
        const keyword = search.value.trim().toLocaleLowerCase('ko-KR');
        let count = 0;
        cards.forEach(card => { const visible = groups[currentTab].includes(card.dataset.eventStatus) && (!filter.value || filter.value === card.dataset.eventStatus) && (!keyword || card.dataset.eventTitle.toLocaleLowerCase('ko-KR').includes(keyword)); card.hidden = !visible; if (visible) count++; });
        document.getElementById('company-event-result').textContent = cards.length ? BusanI18n.t("company.ui0084", [count]) : '';
        document.getElementById('company-event-filter-empty').hidden = !cards.length || count > 0;
    };
    const selectTab = (tab, focus = false) => {
        currentTab = tab.dataset.eventTab;
        filter.value = '';
        [...filter.options].forEach(option => { option.hidden = Boolean(option.value) && !groups[currentTab].includes(option.value); });
        tabs.forEach(button => { const selected = button === tab; button.setAttribute('aria-selected', String(selected)); button.tabIndex = selected ? 0 : -1; });
        document.getElementById('company-events-panel').setAttribute('aria-labelledby', tab.id);
        document.getElementById('company-event-tab-description').textContent = descriptions[currentTab];
        if (focus) tab.focus();
        update();
    };
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', event => {
            let next;
            if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = tabs.length - 1;
            else return;
            event.preventDefault(); selectTab(tabs[next], true);
        });
    });
    search.addEventListener('input', update); filter.addEventListener('change', update);
    document.getElementById('company-event-filter-reset').addEventListener('click', () => { search.value = ''; filter.value = ''; update(); search.focus(); });
    selectTab(tabs[0]);
})();
</script>
<script src="/js/company-session.js" defer></script>
</body>
</html>
