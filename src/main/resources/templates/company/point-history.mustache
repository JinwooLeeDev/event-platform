<!DOCTYPE html>
<html lang="{{localeCode}}">
<head>
    {{> layout/head-meta}}
    <title>{{i18n.company.ui0089}}</title>
</head>
<body>
{{> layout/header}}
{{> layout/account-style}}
{{> company/session-style}}

<style>
    .point-history-balance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 24px;
        margin-bottom: 24px;
    }

    .point-history-balance h2 {
        margin: 0 0 8px;
        color: #627084;
        font-size: 14px;
        font-weight: 500;
    }

    .point-history-amount {
        display: block;
        color: #142d4e;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .point-history-balance p {
        margin: 8px 0 0;
    }

    .point-history-table {
        min-width: 550px;
    }

    .point-history-table--wide {
        min-width: 760px;
    }

    .point-history-table .point-history-money {
        text-align: right;
        white-space: nowrap;
    }

    .point-history-table .point-history-date {
        white-space: nowrap;
    }

    .point-history-event {
        display: block;
        color: #142d4e;
        font-weight: 600;
    }

    .point-history-session {
        display: block;
        margin-top: 5px;
        color: #627084;
        font-size: 12px;
    }

    .point-history-status {
        display: inline-block;
        padding: 5px 10px;
        border: 1px solid #c6d6eb;
        border-radius: 20px;
        background: #f0f5fc;
        color: #244b7e;
        font-size: 12px;
        white-space: nowrap;
    }

    .point-history-empty {
        margin: 0;
        padding: 32px 16px;
        border: 1px dashed #dce4ee;
        border-radius: 10px;
        color: #627084;
        text-align: center;
        font-size: 13px;
    }

    @media (max-width: 600px) {
        .point-history-amount {
            font-size: 28px;
        }

        .point-history-balance .company-button {
            width: 100%;
        }
    }
</style>

<main class="company-workspace">
    <div class="account-layout">
        {{> layout/company-nav}}

        <div class="account-content">
            <header class="company-heading">
                <div>
                    <p class="company-location">{{i18n.common.companyPage}}</p>
                    <h1>{{i18n.company.ui0090}}</h1>
                    <p class="company-description">
                        {{i18n.company.ui0091}}
                    </p>
                </div>
            </header>

            {{#pointHistory}}
            <!-- 현재 기업 포인트 -->
            <section class="company-panel point-history-balance"
                     aria-labelledby="point-balance-title">
                <div>
                    <h2 id="point-balance-title">{{i18n.admin.ui0165}}</h2>
                    <strong class="point-history-amount">
                        {{pointText}} P
                    </strong>
                    <p class="session-muted">
                        {{i18n.company.ui0092}}
                    </p>
                </div>

                <a class="company-button" href="/charge">
                    {{i18n.company.ui0093}}
                </a>
            </section>

            <!-- 충전 내역 -->
            <section class="session-panel"
                     aria-labelledby="point-charge-title">
                <div class="company-panel-heading">
                    <div>
                        <h2 id="point-charge-title">{{i18n.company.ui0094}}</h2>
                        <p class="company-description">
                            {{i18n.company.ui0095}}
                        </p>
                    </div>
                </div>

                <div class="session-table-wrap">
                    <table class="session-table point-history-table">
                        <thead>
                        <tr>
                            <th scope="col">{{i18n.company.ui0096}}</th>
                            <th scope="col"
                                class="point-history-money">
                                {{i18n.company.ui0097}}
                            </th>
                            <th scope="col">{{i18n.admin.ui0153}}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#charges}}
                        <tr>
                            <td class="point-history-date">
                                {{paidAtText}}
                            </td>
                            <td class="point-history-money">
                                {{amountText}}
                            </td>
                            <td>
                                        <span class="point-history-status">
                                            {{statusName}}
                                        </span>
                            </td>
                        </tr>
                        {{/charges}}

                        {{^charges}}
                        <tr>
                            <td colspan="3">
                                <p class="point-history-empty">
                                    {{i18n.company.ui0098}}
                                </p>
                            </td>
                        </tr>
                        {{/charges}}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- 보증금 납부 및 정상 반환 내역 -->
            <section class="session-panel"
                     aria-labelledby="point-deposit-title">
                <div class="company-panel-heading">
                    <div>
                        <h2 id="point-deposit-title">
                            {{i18n.company.ui0099}}
                        </h2>
                        <p class="company-description">
                            {{i18n.company.ui0100}}
                        </p>
                    </div>
                </div>

                <div class="session-table-wrap">
                    <table class="session-table point-history-table
                                      point-history-table--wide">
                        <thead>
                        <tr>
                            <th scope="col">{{i18n.company.ui0101}}</th>
                            <th scope="col"
                                class="point-history-money">
                                {{i18n.company.ui0102}}
                            </th>
                            <th scope="col">{{i18n.admin.ui0153}}</th>
                            <th scope="col">{{i18n.company.ui0103}}</th>
                            <th scope="col"
                                class="point-history-money">
                                {{i18n.company.ui0104}}
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#deposits}}
                        <tr>
                            <td>
                                        <span class="point-history-event">
                                            {{eventTitle}}
                                        </span>
                                <span class="point-history-session">
                                            {{sessionName}}
                                        </span>
                            </td>
                            <td class="point-history-money">
                                {{amountText}}
                            </td>
                            <td>
                                        <span class="point-history-status">
                                            {{statusName}}
                                        </span>
                            </td>
                            <td class="point-history-date">
                                {{paidAtText}}
                            </td>
                            <td class="point-history-money">
                                {{returnedAmountText}}
                            </td>
                        </tr>
                        {{/deposits}}

                        {{^deposits}}
                        <tr>
                            <td colspan="5">
                                <p class="point-history-empty">
                                    {{i18n.company.ui0105}}
                                </p>
                            </td>
                        </tr>
                        {{/deposits}}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- 행사 취소에 따른 환불 내역 -->
            <section class="session-panel"
                     aria-labelledby="point-refund-title">
                <div class="company-panel-heading">
                    <div>
                        <h2 id="point-refund-title">{{i18n.company.ui0106}}</h2>
                        <p class="company-description">
                            {{i18n.company.ui0107}}
                        </p>
                    </div>
                </div>

                <div class="session-table-wrap">
                    <table class="session-table point-history-table
                                      point-history-table--wide">
                        <thead>
                        <tr>
                            <th scope="col">{{i18n.company.ui0101}}</th>
                            <th scope="col">{{i18n.company.ui0108}}</th>
                            <th scope="col">{{i18n.admin.ui0153}}</th>
                            <th scope="col"
                                class="point-history-money">
                                {{i18n.company.ui0109}}
                            </th>
                            <th scope="col">{{i18n.company.ui0110}}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#refunds}}
                        <tr>
                            <td>
                                        <span class="point-history-event">
                                            {{eventTitle}}
                                        </span>
                                <span class="point-history-session">
                                            {{sessionName}}
                                        </span>
                            </td>
                            <td class="point-history-date">
                                {{requestedAtText}}
                            </td>
                            <td>
                                        <span class="point-history-status">
                                            {{statusName}}
                                        </span>
                            </td>
                            <td class="point-history-money">
                                {{amountText}}
                            </td>
                            <td>{{reason}}</td>
                        </tr>
                        {{/refunds}}

                        {{^refunds}}
                        <tr>
                            <td colspan="5">
                                <p class="point-history-empty">
                                    {{i18n.company.ui0111}}
                                </p>
                            </td>
                        </tr>
                        {{/refunds}}
                        </tbody>
                    </table>
                </div>
            </section>
            {{/pointHistory}}

            {{^pointHistory}}
            <div class="company-empty">
                <h2>{{i18n.company.ui0112}}</h2>
                <p>{{i18n.company.ui0113}}</p>
                <a class="company-button company-button--secondary"
                   href="/company/detail">
                    {{i18n.company.ui0114}}
                </a>
            </div>
            {{/pointHistory}}
        </div>
    </div>
</main>

{{> layout/footer}}
</body>
</html>